ex:Aturan_R_SEK_12d
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Prediksi Sektor] PREDIKSI 1-3 TH: SektorBearish"@id ;
      rdfs:label "R-SEK-12d"^^xsd:string ;
      ex:kodeAturan "R-SEK-12d"^^xsd:string ;
      ex:pilarAnalisis "Prediksi Sektor"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:Sektor
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#o> ;
                  swrl:propertyPredicate
                          ex:skorOutlookAktif
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#o> 2) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThan>
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:SektorBearish
                ]) .

