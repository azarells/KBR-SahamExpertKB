                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:SektorRobustLintasSkenario
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:SektorPilihanInti
                ]) .

