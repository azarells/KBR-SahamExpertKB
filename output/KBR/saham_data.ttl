ex:Aturan_R_PRF_09
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Stakeholder] Persona konservatif: akumulasi bertahap pada emiten berdividen"@id ;
      rdfs:label "R-PRF-09"^^xsd:string ;
      ex:kodeAturan "R-PRF-09"^^xsd:string ;
      ex:pilarAnalisis "Stakeholder"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#i> ;
                  swrl:classPredicate ex:InvestorRitel
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#i> ;
                  swrl:argument2 ex:ProfilKonservatif ;
                  swrl:propertyPredicate
                          ex:memilikiProfilRisiko
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:KandidatAkumulasiBertahap
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:DividenAndalan
                ]) ;
      swrl:head ([ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#i> ;
                  swrl:propertyPredicate
                          ex:direkomendasikanUntuk
                ]) .

ex:Penyedia_ASX
      a       owl:NamedIndividual , ex:PenyediaIndeks ;
      rdfs:label "S&P/ASX"@id .

ex:Aturan_R_FUND_09
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Fundamental] Skor fundamental = ROE + solvabilitas + margin + pertumbuhan + kualitas (0-10)"@id ;
      rdfs:label "R-FUND-09"^^xsd:string ;
      ex:kodeAturan "R-FUND-09"^^xsd:string ;
      ex:pilarAnalisis "Fundamental"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#a> ;
                  swrl:propertyPredicate
                          ex:poinROE
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#b> ;
                  swrl:propertyPredicate
                          ex:poinSolvabilitas
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#c> ;
                  swrl:propertyPredicate
                          ex:poinMargin
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#d> ;
                  swrl:propertyPredicate
                          ex:poinPertumbuhan
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#f> ;
                  swrl:propertyPredicate
                          ex:poinKualitas
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#s> <urn:swrl#a> <urn:swrl#b> <urn:swrl#c> <urn:swrl#d> <urn:swrl#f>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#add>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:skorFundamental
                ]) .

