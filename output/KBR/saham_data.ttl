      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:EmitenNonKeuangan
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#v> ;
                  swrl:propertyPredicate
                          ex:der
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#v> "0.5"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#v> "1.5"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThan>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 1 ;
                  swrl:propertyPredicate
                          ex:poinSolvabilitas
