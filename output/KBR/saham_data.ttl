      ex:pilarAnalisis "Regime Pasar"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:KondisiPasarAktif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#v> ;
                  swrl:propertyPredicate
                          ex:kursUSDIDR
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#v> "16500.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThan>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 0 ;
                  swrl:propertyPredicate
                          ex:poinStresKurs
                ]) .

