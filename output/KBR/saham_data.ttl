ex:Aturan_R_VAL_03c
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Fundamental-Valuasi] Skor valuasi PER band: rasioPERvsHistoris ∈ [0.85, 1.1) → skorValuasi 1 FairValued"@id ;
