      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#p> ;
                  swrl:propertyPredicate
                          ex:per
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p> "0.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThan>
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KondisiPasarAktif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#y> ;
                  swrl:propertyPredicate
                          ex:yieldSBN10Y
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#ey> "100.0"^^xsd:double <urn:swrl#p>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#divide>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#erp> <urn:swrl#ey> <urn:swrl#y>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#subtract>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#erp> ;
                  swrl:propertyPredicate
                          ex:equityRiskPremium
                ]) .

