                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#a> ;
                  swrl:propertyPredicate
                          ex:skorFundamental
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#b> ;
                  swrl:propertyPredicate
                          ex:skorValuasi
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#c> ;
                  swrl:propertyPredicate
                          ex:skorTeknikal
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#d> ;
                  swrl:propertyPredicate
                          ex:skorBandar
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#f> ;
                  swrl:propertyPredicate
                          ex:skorSentimen
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#g> ;
                  swrl:propertyPredicate
                          ex:skorKontribusiSektor
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#h> ;
                  swrl:propertyPredicate
                          ex:penaltiRisiko
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#i> ;
                  swrl:propertyPredicate
                          ex:poinLikuiditas
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#t> <urn:swrl#a> <urn:swrl#b> <urn:swrl#c> <urn:swrl#d> <urn:swrl#f> <urn:swrl#g> <urn:swrl#h> <urn:swrl#i>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#add>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#t> ;
                  swrl:propertyPredicate
                          ex:skorTotalEmiten
