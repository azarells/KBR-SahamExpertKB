      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#r> ;
                  swrl:classPredicate ex:RegimeAktif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#r> ;
                  swrl:argument2 <urn:swrl#t> ;
                  swrl:propertyPredicate
                          ex:ambangTopPickAdaptif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:skorAdaptifRegime
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#s> <urn:swrl#t>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#c> ;
                  swrl:propertyPredicate
                          ex:skorKontribusiSektorEV
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#c> 0) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#p> ;
                  swrl:propertyPredicate
                          ex:penaltiRisiko
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p> -1) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#sk> ;
                  swrl:propertyPredicate
                          ex:termasukSektor
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:KandidatTopPickAdaptif
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#sk> ;
                  swrl:argument2 <urn:swrl#e> ;
