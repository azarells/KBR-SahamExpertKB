ex:Aturan_R_ROB_03
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Robustness Skenario] Asimetri positif: upside ≥ 1,5 × downside & ekspektasi ≥ 2"@id ;
      rdfs:label "R-ROB-03"^^xsd:string ;
      ex:kodeAturan "R-ROB-03"^^xsd:string ;
      ex:pilarAnalisis "Robustness Skenario"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:Sektor
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#u> ;
                  swrl:propertyPredicate
                          ex:upsideSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#d> ;
                  swrl:propertyPredicate
                          ex:downsideSkenario
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#d> 0) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#d15> <urn:swrl#d> "1.5"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#u> <urn:swrl#d15>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#e> ;
                  swrl:propertyPredicate
                          ex:skorEkspektasiProbabilistik
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#e> "2.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:SektorAsimetriPositif
                ]) .

