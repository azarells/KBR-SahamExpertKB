ex:Aturan_R_EMT_03
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Integrasi] SKOR TOTAL EMITEN = fundamental + valuasi + teknikal + bandar + sentimen + sektor + risiko + likuiditas"@id ;
      rdfs:label "R-EMT-03"^^xsd:string ;
