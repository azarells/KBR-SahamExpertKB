      rdfs:comment "Siklus kas operasional."@id ;
      rdfs:label "Cash Conversion Cycle"@id ;
      ex:interpretasi "Siklus kas operasional."@id ;
      ex:rumus "DIO + DSO - DPO"@id .

ex:Aturan_R_SEK_01a
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Makro-Geopolitik] Skor makro-geo bagian A = Σ sensitivitas × arah (faktor 1-6: energi, USD, suku bunga, inflasi, emas, logam/China)"@id ;
      rdfs:label "R-SEK-01a"^^xsd:string ;
      ex:kodeAturan "R-SEK-01a"^^xsd:string ;
      ex:pilarAnalisis "Makro-Geopolitik"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:classPredicate ex:PenilaianSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:menilaiSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:argument2 <urn:swrl#sc> ;
                  swrl:propertyPredicate
                          ex:dibawahSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#x0> ;
                  swrl:propertyPredicate
                          ex:sensEnergi
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#sc> ;
                  swrl:argument2 <urn:swrl#y0> ;
                  swrl:propertyPredicate
                          ex:arahEnergi
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p0> <urn:swrl#x0> <urn:swrl#y0>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#x1> ;
                  swrl:propertyPredicate
                          ex:sensUSD
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#sc> ;
                  swrl:argument2 <urn:swrl#y1> ;
                  swrl:propertyPredicate
                          ex:arahUSD
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p1> <urn:swrl#x1> <urn:swrl#y1>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#x2> ;
                  swrl:propertyPredicate
                          ex:sensSukuBunga
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#sc> ;
                  swrl:argument2 <urn:swrl#y2> ;
                  swrl:propertyPredicate
                          ex:arahSukuBunga
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p2> <urn:swrl#x2> <urn:swrl#y2>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#x3> ;
                  swrl:propertyPredicate
                          ex:sensInflasi
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#sc> ;
                  swrl:argument2 <urn:swrl#y3> ;
                  swrl:propertyPredicate
                          ex:arahInflasi
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p3> <urn:swrl#x3> <urn:swrl#y3>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#x4> ;
                  swrl:propertyPredicate
                          ex:sensEmas
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#sc> ;
                  swrl:argument2 <urn:swrl#y4> ;
                  swrl:propertyPredicate
                          ex:arahEmas
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p4> <urn:swrl#x4> <urn:swrl#y4>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#x5> ;
                  swrl:propertyPredicate
                          ex:sensLogamChina
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#sc> ;
                  swrl:argument2 <urn:swrl#y5> ;
                  swrl:propertyPredicate
                          ex:arahLogamChina
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#p5> <urn:swrl#x5> <urn:swrl#y5>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#t> <urn:swrl#p0> <urn:swrl#p1> <urn:swrl#p2> <urn:swrl#p3> <urn:swrl#p4> <urn:swrl#p5>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#add>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:argument2 <urn:swrl#t> ;
                  swrl:propertyPredicate
                          ex:skorMakroGeoA
                ]) .

