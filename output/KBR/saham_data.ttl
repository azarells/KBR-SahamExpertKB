ex:Aturan_R_SIG_02
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Quant Trade] Sinyal entry: teknikal ≥ 5, bandar ≥ 3, RSI < 70"@id ;
      rdfs:label "R-SIG-02"^^xsd:string ;
      ex:kodeAturan "R-SIG-02"^^xsd:string ;
      ex:pilarAnalisis "Quant Trade"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#t> ;
                  swrl:propertyPredicate
                          ex:skorTeknikal
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#t> 5) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#b> ;
                  swrl:propertyPredicate
                          ex:skorBandar
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#b> 3) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#r> ;
                  swrl:propertyPredicate
                          ex:rsi14
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#r> "70.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThan>
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:SinyalEntry
                ]) .

