      rdfs:label "formatData"@id ;
      rdfs:range xsd:string .

ex:Aturan_R_SEK_07
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Integrasi] SKOR OUTLOOK = makro-geo + valuasi + tema×2 + sentimen + aliran asing + rotasi"@id ;
      rdfs:label "R-SEK-07"^^xsd:string ;
      ex:kodeAturan "R-SEK-07"^^xsd:string ;
      ex:pilarAnalisis "Integrasi"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:classPredicate ex:PenilaianSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:menilaiSektor
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:argument2 <urn:swrl#m> ;
                  swrl:propertyPredicate
                          ex:skorMakroGeo
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:argument2 <urn:swrl#r> ;
                  swrl:propertyPredicate
                          ex:skorRotasi
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#v> ;
                  swrl:propertyPredicate
                          ex:skorValuasiSektor
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#t> ;
                  swrl:propertyPredicate
                          ex:skorTemaTertimbang
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#n> ;
                  swrl:propertyPredicate
                          ex:poinSentimenSektor
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#f> ;
                  swrl:propertyPredicate
                          ex:poinAliranAsing
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#o> <urn:swrl#m> <urn:swrl#r> <urn:swrl#v> <urn:swrl#t> <urn:swrl#n> <urn:swrl#f>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#add>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#a> ;
                  swrl:argument2 <urn:swrl#o> ;
                  swrl:propertyPredicate
                          ex:skorOutlook
                ]) .

ex:Aturan_R_PAS_03
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Struktur Pasar] Kapitulasi pasar: drawdown ≤ -40% & hari crash ≤ -10%"@id ;
      rdfs:label "R-PAS-03"^^xsd:string ;
      ex:kodeAturan "R-PAS-03"^^xsd:string ;
      ex:pilarAnalisis "Struktur Pasar"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KondisiPasarAktif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#d> ;
                  swrl:propertyPredicate
                          ex:drawdownIHSGPersen
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#d> "-40.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#x> ;
                  swrl:propertyPredicate
                          ex:penurunanHarianTerbesarPersen
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#x> "-10.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#lessThanOrEqual>
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KapitulasiPasar
                ]) .

