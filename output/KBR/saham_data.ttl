      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Reaction Function] CDS ≥ 90 bps → antisipasi kenaikan premi risiko negara"@id ;
      rdfs:label "R-ANT-05"^^xsd:string ;
      ex:kodeAturan "R-ANT-05"^^xsd:string ;
      ex:pilarAnalisis "Reaction Function"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KondisiPasarAktif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#c> ;
                  swrl:propertyPredicate
                          ex:cds5YBps
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#c> "90.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 ex:Antisipasi_PremiRisikoNegara ;
                  swrl:classPredicate ex:AntisipasiTerpicu
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 ex:Mv_PremiRisikoNegaraNaik ;
                  swrl:classPredicate ex:PergerakanAktif
                ]) .

