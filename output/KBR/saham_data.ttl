ex:Aturan_R_TEK_03a
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Teknikal] MACD histogram positif → 1"@id ;
      rdfs:label "R-TEK-03a"^^xsd:string ;
      ex:kodeAturan "R-TEK-03a"^^xsd:string ;
      ex:pilarAnalisis "Teknikal"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#m> ;
                  swrl:propertyPredicate
                          ex:histogramMACD
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#m> 0) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThan>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 1 ;
                  swrl:propertyPredicate
                          ex:poinMACD
                ]) .

ex:Aturan_R_STR_07
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Regime Pasar] Skor stres pasar = Σ 6 poin stres (0-12)"@id ;
      rdfs:label "R-STR-07"^^xsd:string ;
      ex:kodeAturan "R-STR-07"^^xsd:string ;
      ex:pilarAnalisis "Regime Pasar"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KondisiPasarAktif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#a> ;
                  swrl:propertyPredicate
                          ex:poinStresDrawdown
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#b> ;
                  swrl:propertyPredicate
                          ex:poinStresCDS
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#c> ;
                  swrl:propertyPredicate
                          ex:poinStresAsing
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#d> ;
                  swrl:propertyPredicate
                          ex:poinStresKurs
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#f> ;
                  swrl:propertyPredicate
                          ex:poinStresYield
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#g> ;
                  swrl:propertyPredicate
                          ex:poinStresBreadth
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#s> <urn:swrl#a> <urn:swrl#b> <urn:swrl#c> <urn:swrl#d> <urn:swrl#f> <urn:swrl#g>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#add>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:skorStresPasar
                ]) .

