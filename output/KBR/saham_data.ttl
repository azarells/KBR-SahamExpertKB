ex:Aturan_R_KON_11
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Konflik Sinyal] Tren naik tanpa fundamental"@id ;
      rdfs:label "R-KON-11"^^xsd:string ;
      ex:kodeAturan "R-KON-11"^^xsd:string ;
      ex:pilarAnalisis "Konflik Sinyal"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:TrenNaik
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:FundamentalLemah
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:MomentumTanpaFundamental
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:TungguKonfirmasi
                ]) .

ex:Aturan_R_VAL_03d
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Fundamental-Valuasi] Skor valuasi PER band: rasioPERvsHistoris ∈ [1.1, +inf) → skorValuasi 0 Overvalued"@id ;
      rdfs:label "R-VAL-03d"^^xsd:string ;
      ex:kodeAturan "R-VAL-03d"^^xsd:string ;
      ex:pilarAnalisis "Fundamental-Valuasi"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#v> ;
                  swrl:propertyPredicate
                          ex:rasioPERvsHistoris
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#v> "1.1"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 0 ;
                  swrl:propertyPredicate
                          ex:skorValuasi
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Overvalued
                ]) .

