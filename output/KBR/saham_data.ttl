ex:Aturan_R_STR_04c
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Regime Pasar] Poin stres kurs USD/IDR: kursUSDIDR ∈ [-inf, 16500.0) → poinStresKurs 0"@id ;
      rdfs:label "R-STR-04c"^^xsd:string ;
