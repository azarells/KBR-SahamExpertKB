      ex:pilarAnalisis "Fundamental-Valuasi"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#eps> ;
                  swrl:propertyPredicate
                          ex:epsEstimasi
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#q> ;
                  swrl:propertyPredicate
                          ex:per5Tahun
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#h> ;
                  swrl:propertyPredicate
                          ex:hargaPenutupan
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#nw> <urn:swrl#eps> <urn:swrl#q>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#r> <urn:swrl#nw> <urn:swrl#h>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#divide>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#u0> <urn:swrl#r> "1.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#subtract>
                ] [ a       swrl:BuiltinAtom ;
