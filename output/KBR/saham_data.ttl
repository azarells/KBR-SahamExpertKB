                  swrl:arguments (<urn:swrl#x> <urn:swrl#h> <urn:swrl#a>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:BuiltinAtom ;
