ex:Aturan_R_RS_01
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Refleksivitas] Kekuatan relatif = perubahan 20 hari − perubahan IHSG 1 bulan"@id ;
      rdfs:label "R-RS-01"^^xsd:string ;
      ex:kodeAturan "R-RS-01"^^xsd:string ;
      ex:pilarAnalisis "Refleksivitas"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#c> ;
                  swrl:propertyPredicate
                          ex:perubahanHarga20HariPersen
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KondisiPasarAktif
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 <urn:swrl#m> ;
                  swrl:propertyPredicate
                          ex:perubahanIHSG1BulanPersen
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#rs> <urn:swrl#c> <urn:swrl#m>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#subtract>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#rs> ;
                  swrl:propertyPredicate
                          ex:kekuatanRelatifPersen
                ]) .

