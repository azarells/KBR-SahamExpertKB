      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Regime Pasar] Kondisi pasar aktif (statusAktifKondisi = 1)"@id ;
      rdfs:label "R-PAS-00"^^xsd:string ;
      ex:kodeAturan "R-PAS-00"^^xsd:string ;
      ex:pilarAnalisis "Regime Pasar"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KondisiPasar
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:argument2 1 ;
                  swrl:propertyPredicate
                          ex:statusAktifKondisi
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#k> ;
                  swrl:classPredicate ex:KondisiPasarAktif
                ]) .

ex:formatData
