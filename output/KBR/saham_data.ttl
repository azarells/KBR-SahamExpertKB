ex:Aturan_R_ROB_02
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Robustness Skenario] Robust: Base ≥ 7, Bull ≥ 7, Bear ≥ 2"@id ;
      rdfs:label "R-ROB-02"^^xsd:string ;
      ex:kodeAturan "R-ROB-02"^^xsd:string ;
      ex:pilarAnalisis "Robustness Skenario"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:Sektor
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#a> ;
                  swrl:propertyPredicate
                          ex:skorOutlookBase
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#a> 7) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#b> ;
                  swrl:propertyPredicate
                          ex:skorOutlookBull
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#b> 7) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#c> ;
                  swrl:propertyPredicate
                          ex:skorOutlookBear
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#c> 2) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:SektorRobustLintasSkenario
                ]) .

ex:Aturan_R_ROB_01
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Robustness Skenario] Skor ekspektasi probabilistik = Σ p(skenario) × skor outlook; upside = Bull − Base; downside = Base − Bear"@id ;
      rdfs:label "R-ROB-01"^^xsd:string ;
      ex:kodeAturan "R-ROB-01"^^xsd:string ;
      ex:pilarAnalisis "Robustness Skenario"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:classPredicate ex:Sektor
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#a1> ;
                  swrl:classPredicate ex:PenilaianSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a1> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:menilaiSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a1> ;
                  swrl:argument2 ex:Skenario_Base_2027_2028 ;
                  swrl:propertyPredicate
                          ex:dibawahSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#a1> ;
                  swrl:argument2 <urn:swrl#o1> ;
                  swrl:propertyPredicate
                          ex:skorOutlook
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#a2> ;
                  swrl:classPredicate ex:PenilaianSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a2> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:menilaiSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a2> ;
                  swrl:argument2 ex:Skenario_Bull_Pemulihan ;
                  swrl:propertyPredicate
                          ex:dibawahSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#a2> ;
                  swrl:argument2 <urn:swrl#o2> ;
                  swrl:propertyPredicate
                          ex:skorOutlook
                ] [ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#a3> ;
                  swrl:classPredicate ex:PenilaianSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a3> ;
                  swrl:argument2 <urn:swrl#s> ;
                  swrl:propertyPredicate
                          ex:menilaiSektor
                ] [ a       swrl:IndividualPropertyAtom ;
                  swrl:argument1 <urn:swrl#a3> ;
                  swrl:argument2 ex:Skenario_Bear_Stagflasi ;
                  swrl:propertyPredicate
                          ex:dibawahSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#a3> ;
                  swrl:argument2 <urn:swrl#o3> ;
                  swrl:propertyPredicate
                          ex:skorOutlook
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 ex:Skenario_Base_2027_2028 ;
                  swrl:argument2 <urn:swrl#p1> ;
                  swrl:propertyPredicate
                          ex:probabilitasSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 ex:Skenario_Bull_Pemulihan ;
                  swrl:argument2 <urn:swrl#p2> ;
                  swrl:propertyPredicate
                          ex:probabilitasSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 ex:Skenario_Bear_Stagflasi ;
                  swrl:argument2 <urn:swrl#p3> ;
                  swrl:propertyPredicate
                          ex:probabilitasSkenario
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#x1> <urn:swrl#p1> <urn:swrl#o1>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#x2> <urn:swrl#p2> <urn:swrl#o2>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#x3> <urn:swrl#p3> <urn:swrl#o3>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#multiply>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#ev> <urn:swrl#x1> <urn:swrl#x2> <urn:swrl#x3>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#add>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#up> <urn:swrl#o2> <urn:swrl#o1>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#subtract>
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#dn> <urn:swrl#o1> <urn:swrl#o3>) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#subtract>
                ]) ;
      swrl:head ([ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#ev> ;
                  swrl:propertyPredicate
                          ex:skorEkspektasiProbabilistik
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#o1> ;
                  swrl:propertyPredicate
                          ex:skorOutlookBase
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#o2> ;
                  swrl:propertyPredicate
                          ex:skorOutlookBull
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#o3> ;
                  swrl:propertyPredicate
                          ex:skorOutlookBear
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#up> ;
                  swrl:propertyPredicate
                          ex:upsideSkenario
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#s> ;
                  swrl:argument2 <urn:swrl#dn> ;
                  swrl:propertyPredicate
                          ex:downsideSkenario
                ]) .

