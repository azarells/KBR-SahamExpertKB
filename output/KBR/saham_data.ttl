ex:Aturan_R_RS_02
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Refleksivitas] Mengungguli pasar ≥ +5 pp"@id ;
      rdfs:label "R-RS-02"^^xsd:string ;
      ex:kodeAturan "R-RS-02"^^xsd:string ;
      ex:pilarAnalisis "Refleksivitas"^^xsd:string ;
      swrl:body ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:Emiten
                ] [ a       swrl:DatavaluedPropertyAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:argument2 <urn:swrl#r> ;
                  swrl:propertyPredicate
                          ex:kekuatanRelatifPersen
                ] [ a       swrl:BuiltinAtom ;
                  swrl:arguments (<urn:swrl#r> "5.0"^^xsd:double) ;
                  swrl:builtin <http://www.w3.org/2003/11/swrlb#greaterThanOrEqual>
                ]) ;
      swrl:head ([ a       swrl:ClassAtom ;
                  swrl:argument1 <urn:swrl#e> ;
                  swrl:classPredicate ex:OutperformPasar
                ]) .

