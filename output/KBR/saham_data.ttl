ex:Aturan_R_ROB_04
      a       owl:NamedIndividual , swrl:Imp ;
      rdfs:comment "[Konstruksi Portofolio] Sektor inti (core): bullish di skenario aktif & robust lintas skenario"@id ;
      rdfs:label "R-ROB-04"^^xsd:string ;
