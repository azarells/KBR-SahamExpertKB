  <rdfs:comment xml:lang="id">Definisi indikator yang dapat/telah dimasukkan ke sistem beserta sifat waktunya.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndikatorLeading">
  <rdfs:subClassOf rdf:resource="#IndikatorKatalog"/>
