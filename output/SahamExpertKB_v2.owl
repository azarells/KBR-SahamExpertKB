<owl:Class rdf:about="#EntitasPasarModal">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Entitas Pasar Modal</rdfs:label>
  <rdfs:comment xml:lang="id">Semua entitas nyata di pasar modal: emiten, sektor, indeks, broker, institusi, komoditas.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PengetahuanDasarSaham">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Pengetahuan Dasar Saham (Basic Layer)</rdfs:label>
  <rdfs:comment xml:lang="id">Lapisan ilmu dasar yang wajib dikuasai investor: konsep, mekanisme, aksi korporasi, gaya investasi, manajemen risiko.</rdfs:comment>
  <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Basic Layer</lapisanPengetahuan>
</owl:Class>

<owl:Class rdf:about="#AnalisisFundamental">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Analisis Fundamental</rdfs:label>
  <rdfs:comment xml:lang="id">Pilar analisis nilai intrinsik perusahaan berbasis laporan keuangan, rasio, dan valuasi.</rdfs:comment>
  <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Basic Layer</lapisanPengetahuan>
</owl:Class>

<owl:Class rdf:about="#AnalisisTeknikal">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Analisis Teknikal</rdfs:label>
  <rdfs:comment xml:lang="id">Pilar analisis pergerakan harga &amp; volume (indikator, pola chart, candlestick).</rdfs:comment>
  <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Basic Layer</lapisanPengetahuan>
</owl:Class>

<owl:Class rdf:about="#Bandarmology">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Bandarmology</rdfs:label>
  <rdfs:comment xml:lang="id">Pilar analisis jejak pemodal besar (bandar/asing/institusi) via broker summary, foreign flow, dan order book.</rdfs:comment>
  <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expert Layer (inti 80% knowledge-based)</lapisanPengetahuan>
</owl:Class>

<owl:Class rdf:about="#AnalisisSentimen">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Analisis Sentimen</rdfs:label>
  <rdfs:comment xml:lang="id">Pilar interpretasi berita, riset, media sosial, dan aksi korporasi menjadi sinyal sentimen sektoral/emiten.</rdfs:comment>
  <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expert Layer (inti 80% knowledge-based)</lapisanPengetahuan>
</owl:Class>

<owl:Class rdf:about="#AnalisisGeopolitikMakro">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Analisis Geopolitik &amp; Makro</rdfs:label>
  <rdfs:comment xml:lang="id">Pilar pakar: transmisi peristiwa geopolitik, kebijakan moneter, dan komoditas ke arah dana asing &amp; sektor.</rdfs:comment>
  <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expert Layer (inti 80% knowledge-based)</lapisanPengetahuan>
</owl:Class>

<owl:Class rdf:about="#PenalaranPakar">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Penalaran Pakar</rdfs:label>
  <rdfs:comment xml:lang="id">Struktur penalaran: skenario, penilaian sektor, kasus historis (CBR), siklus ekonomi, tema struktural.</rdfs:comment>
  <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Expert Layer (inti 80% knowledge-based)</lapisanPengetahuan>
</owl:Class>

<owl:Class rdf:about="#Stakeholder">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Stakeholder</rdfs:label>
  <rdfs:comment xml:lang="id">Pihak yang berkepentingan terhadap sistem pakar (mitra, pengguna, validator, regulator).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KeluaranSistem">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Keluaran Sistem</rdfs:label>
  <rdfs:comment xml:lang="id">Jenis output yang dihasilkan sistem pakar.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KategoriInferensi">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Kategori Hasil Inferensi</rdfs:label>
  <rdfs:comment xml:lang="id">Kelas-kelas yang keanggotaannya diturunkan oleh aturan SWRL (bukan diisi manual).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TujuanSDG">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  <rdfs:label xml:lang="id">Tujuan Pembangunan Berkelanjutan (SDG)</rdfs:label>
  <rdfs:comment xml:lang="id">Target SDGs yang didukung keluaran sistem.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Emiten">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Emiten</rdfs:label>
  <rdfs:comment xml:lang="id">Perusahaan tercatat (listed company) di Bursa Efek Indonesia.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EmitenPerbankan">
  <rdfs:subClassOf rdf:resource="#Emiten"/>
  <owl:disjointWith rdf:resource="#EmitenNonKeuangan"/>
  <rdfs:label xml:lang="id">Emiten Perbankan</rdfs:label>
  <rdfs:comment xml:lang="id">Emiten bank; dinilai dengan rasio khusus perbankan (NPL, CAR, NIM, LDR).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EmitenNonKeuangan">
  <rdfs:subClassOf rdf:resource="#Emiten"/>
  <rdfs:label xml:lang="id">Emiten Non-Keuangan</rdfs:label>
  <rdfs:comment xml:lang="id">Emiten selain bank; dinilai dengan DER, margin, Altman Z-Score.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EmitenBUMN">
  <rdfs:subClassOf rdf:resource="#Emiten"/>
  <rdfs:label xml:lang="id">Emiten BUMN</rdfs:label>
  <rdfs:comment xml:lang="id">Emiten yang mayoritas sahamnya dimiliki negara (kini di bawah koordinasi Danantara).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#EmitenSyariah">
  <rdfs:subClassOf rdf:resource="#Emiten"/>
  <rdfs:label xml:lang="id">Emiten Syariah</rdfs:label>
  <rdfs:comment xml:lang="id">Emiten yang masuk Daftar Efek Syariah (DES) OJK.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Sektor">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Sektor IDX-IC</rdfs:label>
  <rdfs:comment xml:lang="id">Klasifikasi sektor menurut IDX Industrial Classification (IDX-IC), 11 sektor.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorDefensif">
  <rdfs:subClassOf rdf:resource="#Sektor"/>
  <rdfs:label xml:lang="id">Sektor Defensif</rdfs:label>
  <rdfs:comment xml:lang="id">Sektor yang permintaannya stabil di segala siklus (konsumer primer, kesehatan, infrastruktur telko).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorSiklikal">
  <rdfs:subClassOf rdf:resource="#Sektor"/>
  <rdfs:label xml:lang="id">Sektor Siklikal</rdfs:label>
  <rdfs:comment xml:lang="id">Sektor yang sangat bergantung siklus ekonomi &amp; suku bunga.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorKomoditas">
  <rdfs:subClassOf rdf:resource="#Sektor"/>
  <rdfs:label xml:lang="id">Sektor Berbasis Komoditas</rdfs:label>
  <rdfs:comment xml:lang="id">Sektor yang labanya ditentukan harga komoditas global.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Subsektor">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Subsektor / Industri</rdfs:label>
  <rdfs:comment xml:lang="id">Turunan sektor IDX-IC (mis. batu bara, bank, telekomunikasi).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KonglomerasiGrup">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Grup Konglomerasi</rdfs:label>
  <rdfs:comment xml:lang="id">Grup usaha pengendali beberapa emiten (afiliasi).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksSaham">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Indeks Saham</rdfs:label>
  <rdfs:comment xml:lang="id">Ukuran statistik pergerakan harga sekumpulan saham.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksDomestik">
  <rdfs:subClassOf rdf:resource="#IndeksSaham"/>
  <rdfs:label xml:lang="id">Indeks Domestik (BEI)</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks yang diterbitkan Bursa Efek Indonesia.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksKomposit">
  <rdfs:subClassOf rdf:resource="#IndeksDomestik"/>
  <rdfs:label xml:lang="id">Indeks Komposit</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks seluruh saham tercatat (IHSG).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksLikuiditas">
  <rdfs:subClassOf rdf:resource="#IndeksDomestik"/>
  <rdfs:label xml:lang="id">Indeks Likuiditas &amp; Kapitalisasi</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks saham paling likuid &amp; berkapitalisasi besar (LQ45, IDX30, IDX80, Kompas100).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksSektoralBEI">
  <rdfs:subClassOf rdf:resource="#IndeksDomestik"/>
  <rdfs:label xml:lang="id">Indeks Sektoral BEI</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks 11 sektor IDX-IC.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksTematik">
  <rdfs:subClassOf rdf:resource="#IndeksDomestik"/>
  <rdfs:label xml:lang="id">Indeks Tematik/Faktor</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks berbasis faktor (value, growth, quality, dividen, BUMN).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksSyariah">
  <rdfs:subClassOf rdf:resource="#IndeksDomestik"/>
  <rdfs:label xml:lang="id">Indeks Syariah</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks saham syariah (JII, ISSI, JII70).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksESG">
  <rdfs:subClassOf rdf:resource="#IndeksDomestik"/>
  <rdfs:label xml:lang="id">Indeks ESG</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks berbasis kinerja lingkungan, sosial, tata kelola.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksGlobal">
  <rdfs:subClassOf rdf:resource="#IndeksSaham"/>
  <rdfs:label xml:lang="id">Indeks Global</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks bursa luar negeri dan indeks penyedia global.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksAmerika">
  <rdfs:subClassOf rdf:resource="#IndeksGlobal"/>
  <rdfs:label xml:lang="id">Indeks Amerika Serikat</rdfs:label>
  <rdfs:comment xml:lang="id">NASDAQ, S&amp;P 500, Dow Jones, Russell 2000, dll.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksEropa">
  <rdfs:subClassOf rdf:resource="#IndeksGlobal"/>
  <rdfs:label xml:lang="id">Indeks Eropa</rdfs:label>
  <rdfs:comment xml:lang="id">FTSE 100, DAX, CAC 40, Euro Stoxx 50.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksAsiaPasifik">
  <rdfs:subClassOf rdf:resource="#IndeksGlobal"/>
  <rdfs:label xml:lang="id">Indeks Asia-Pasifik</rdfs:label>
  <rdfs:comment xml:lang="id">Nikkei, Hang Seng, Shanghai, KOSPI, STI, dll.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksMSCI">
  <rdfs:subClassOf rdf:resource="#IndeksGlobal"/>
  <rdfs:label xml:lang="id">Indeks MSCI</rdfs:label>
  <rdfs:comment xml:lang="id">Keluarga indeks MSCI Inc. yang menjadi acuan dana pasif global.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksFTSERussell">
  <rdfs:subClassOf rdf:resource="#IndeksGlobal"/>
  <rdfs:label xml:lang="id">Indeks FTSE Russell</rdfs:label>
  <rdfs:comment xml:lang="id">Keluarga indeks FTSE Russell (LSEG).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndeksSPDowJones">
  <rdfs:subClassOf rdf:resource="#IndeksGlobal"/>
  <rdfs:label xml:lang="id">Indeks S&amp;P Dow Jones</rdfs:label>
  <rdfs:comment xml:lang="id">Keluarga indeks S&amp;P Dow Jones Indices.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndikatorRisikoGlobal">
  <rdfs:subClassOf rdf:resource="#IndeksGlobal"/>
  <rdfs:label xml:lang="id">Indikator Risiko Global</rdfs:label>
  <rdfs:comment xml:lang="id">Indeks volatilitas &amp; dolar (VIX, DXY).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PenyediaIndeks">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Penyedia Indeks</rdfs:label>
  <rdfs:comment xml:lang="id">Lembaga penerbit indeks (MSCI, FTSE Russell, S&amp;P DJI, BEI, Nasdaq Inc).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Broker">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Broker / Anggota Bursa</rdfs:label>
  <rdfs:comment xml:lang="id">Perusahaan efek anggota bursa, diidentifikasi kode 2 huruf.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BrokerAsing">
  <rdfs:subClassOf rdf:resource="#Broker"/>
  <owl:disjointWith rdf:resource="#BrokerLokal"/>
  <rdfs:label xml:lang="id">Broker Asing</rdfs:label>
  <rdfs:comment xml:lang="id">Broker afiliasi asing; jejaknya mencerminkan dana institusi global.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BrokerLokal">
  <rdfs:subClassOf rdf:resource="#Broker"/>
  <rdfs:label xml:lang="id">Broker Lokal</rdfs:label>
  <rdfs:comment xml:lang="id">Broker domestik.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BrokerRitel">
  <rdfs:subClassOf rdf:resource="#BrokerLokal"/>
  <rdfs:label xml:lang="id">Broker Ritel</rdfs:label>
  <rdfs:comment xml:lang="id">Broker dengan basis nasabah ritel dominan; net buy masif dari broker ritel sering jadi tanda distribusi.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BrokerInstitusiLokal">
  <rdfs:subClassOf rdf:resource="#BrokerLokal"/>
  <rdfs:label xml:lang="id">Broker Institusi Lokal</rdfs:label>
  <rdfs:comment xml:lang="id">Broker domestik yang melayani dana pensiun, asuransi, MI.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Institusi">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Institusi / Otoritas</rdfs:label>
  <rdfs:comment xml:lang="id">Regulator, bank sentral, SRO, lembaga statistik, organisasi internasional.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Regulator">
  <rdfs:subClassOf rdf:resource="#Institusi"/>
  <rdfs:label xml:lang="id">Regulator</rdfs:label>
  <rdfs:comment xml:lang="id">Otoritas pengatur (OJK).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SelfRegulatoryOrganization">
  <rdfs:subClassOf rdf:resource="#Institusi"/>
  <rdfs:label xml:lang="id">SRO</rdfs:label>
  <rdfs:comment xml:lang="id">BEI, KSEI, KPEI.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BankSentral">
  <rdfs:subClassOf rdf:resource="#Institusi"/>
  <rdfs:label xml:lang="id">Bank Sentral</rdfs:label>
  <rdfs:comment xml:lang="id">Bank Indonesia, The Federal Reserve, ECB, BoJ, PBoC.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#OrganisasiInternasional">
  <rdfs:subClassOf rdf:resource="#Institusi"/>
  <rdfs:label xml:lang="id">Organisasi Internasional</rdfs:label>
  <rdfs:comment xml:lang="id">OPEC+, IMF, Bank Dunia, lembaga pemeringkat.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LembagaPemeringkat">
  <rdfs:subClassOf rdf:resource="#OrganisasiInternasional"/>
  <rdfs:label xml:lang="id">Lembaga Pemeringkat</rdfs:label>
  <rdfs:comment xml:lang="id">S&amp;P, Moody's, Fitch.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Komoditas">
  <rdfs:subClassOf rdf:resource="#EntitasPasarModal"/>
  <rdfs:label xml:lang="id">Komoditas</rdfs:label>
  <rdfs:comment xml:lang="id">Barang komoditas global yang memengaruhi laba emiten.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KomoditasEnergi">
  <rdfs:subClassOf rdf:resource="#Komoditas"/>
  <rdfs:label xml:lang="id">Komoditas Energi</rdfs:label>
  <rdfs:comment xml:lang="id">Minyak (WTI, Brent), gas/LNG, batu bara.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KomoditasLogam">
  <rdfs:subClassOf rdf:resource="#Komoditas"/>
  <rdfs:label xml:lang="id">Komoditas Logam Industri</rdfs:label>
  <rdfs:comment xml:lang="id">Nikel, timah, tembaga, bauksit, aluminium.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#LogamMulia">
  <rdfs:subClassOf rdf:resource="#Komoditas"/>
  <rdfs:label xml:lang="id">Logam Mulia</rdfs:label>
  <rdfs:comment xml:lang="id">Emas dan perak (aset safe haven).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KomoditasAgrikultur">
  <rdfs:subClassOf rdf:resource="#Komoditas"/>
  <rdfs:label xml:lang="id">Komoditas Agrikultur</rdfs:label>
  <rdfs:comment xml:lang="id">CPO, karet, gandum, jagung, kedelai.</rdfs:comment>
