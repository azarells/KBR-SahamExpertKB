  <rdfs:label xml:lang="id">Tesis Valid</rdfs:label>
  <rdfs:comment xml:lang="id">(Inferensi) indikator kunci masih dalam batas tesis.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TesisGugur">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
  <rdfs:label xml:lang="id">Tesis Gugur</rdfs:label>
  <rdfs:comment xml:lang="id">(Inferensi) indikator kunci menembus batas invalidasi: keluar.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TesisRapuh">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
  <rdfs:label xml:lang="id">Tesis Rapuh</rdfs:label>
  <rdfs:comment xml:lang="id">(Inferensi) jarak ke batas invalidasi &lt; 10%.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TesisTerpicu">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
  <rdfs:label xml:lang="id">Tesis Kontrarian Terpicu</rdfs:label>
  <rdfs:comment xml:lang="id">(Inferensi) syarat pemicu tesis kontrarian terpenuhi.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TesisPerluDataBaru">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
