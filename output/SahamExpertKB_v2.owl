  <rdfs:comment xml:lang="id">Drawdown ≥ 40% + hari crash ≥ 10%: penjualan paksa/panik selesai sebagian.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#BreadthWashout">
  <rdfs:subClassOf rdf:resource="#InferensiPasar"/>
  <rdfs:label xml:lang="id">Breadth Washout</rdfs:label>
