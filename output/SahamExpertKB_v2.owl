<swrl:Imp rdf:about="#Aturan_R_GEO_01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Berita"/>
          <swrl:argument1 rdf:resource="urn:swrl#n"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#tentangPeristiwa"/>
              <swrl:argument1 rdf:resource="urn:swrl#n"/>
              <swrl:argument2 rdf:resource="urn:swrl#ev"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#kredibilitasSumber"/>
                  <swrl:argument1 rdf:resource="urn:swrl#n"/>
                  <swrl:argument2 rdf:resource="urn:swrl#c"/>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:BuiltinAtom>
                      <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                      <swrl:arguments>
                        <rdf:Description>
                          <rdf:first rdf:resource="urn:swrl#c"/>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.7</rdf:first>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </swrl:arguments>
                    </swrl:BuiltinAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#umurHari"/>
                          <swrl:argument1 rdf:resource="urn:swrl#n"/>
                          <swrl:argument2 rdf:resource="urn:swrl#d"/>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:BuiltinAtom>
                              <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
                              <swrl:arguments>
                                <rdf:Description>
                                  <rdf:first rdf:resource="urn:swrl#d"/>
                                  <rdf:rest>
                                    <rdf:Description>
                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">180</rdf:first>
                                    </rdf:Description>
                                  </rdf:rest>
                                </rdf:Description>
                              </swrl:arguments>
                            </swrl:BuiltinAtom>
                          </rdf:first>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#PeristiwaAktif"/>
          <swrl:argument1 rdf:resource="urn:swrl#ev"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-GEO-01</rdfs:label>
  <rdfs:comment xml:lang="id">[Geopolitik] Peristiwa aktif bila dikonfirmasi berita kredibel (≥ 0,7) berumur ≤ 180 hari</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-GEO-01</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Geopolitik</pilarAnalisis>
</swrl:Imp>

