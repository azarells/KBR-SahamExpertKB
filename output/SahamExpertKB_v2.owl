<swrl:Imp rdf:about="#Aturan_R_ERP_01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Emiten"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#per"/>
              <swrl:argument1 rdf:resource="urn:swrl#e"/>
              <swrl:argument2 rdf:resource="urn:swrl#p"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                  <swrl:arguments>
                    <rdf:Description>
                      <rdf:first rdf:resource="urn:swrl#p"/>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</rdf:first>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:ClassAtom>
                      <swrl:classPredicate rdf:resource="#KondisiPasarAktif"/>
                      <swrl:argument1 rdf:resource="urn:swrl#k"/>
                    </swrl:ClassAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#yieldSBN10Y"/>
                          <swrl:argument1 rdf:resource="urn:swrl#k"/>
                          <swrl:argument2 rdf:resource="urn:swrl#y"/>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:BuiltinAtom>
                              <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#divide"/>
                              <swrl:arguments>
                                <rdf:Description>
                                  <rdf:first rdf:resource="urn:swrl#ey"/>
                                  <rdf:rest>
                                    <rdf:Description>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#p"/>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </rdf:Description>
                                      </rdf:rest>
                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</rdf:first>
                                    </rdf:Description>
                                  </rdf:rest>
                                </rdf:Description>
                              </swrl:arguments>
                            </swrl:BuiltinAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#subtract"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#erp"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#ey"/>
                                          <rdf:rest>
                                            <rdf:Description>
                                              <rdf:first rdf:resource="urn:swrl#y"/>
                                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                            </rdf:Description>
                                          </rdf:rest>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:DatavaluedPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#equityRiskPremium"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
          <swrl:argument2 rdf:resource="urn:swrl#erp"/>
        </swrl:DatavaluedPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ERP-01</rdfs:label>
  <rdfs:comment xml:lang="id">[Valuasi Relatif Obligasi] ERP = 100/PER − yield SBN 10Y</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ERP-01</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Valuasi Relatif Obligasi</pilarAnalisis>
</swrl:Imp>

<swrl:Variable rdf:about="urn:swrl#ey"/>

<swrl:Variable rdf:about="urn:swrl#erp"/>

