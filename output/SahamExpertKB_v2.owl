                <rdf:Description>
                  <rdf:first>
                    <swrl:ClassAtom>
                      <swrl:classPredicate rdf:resource="#CocokAgresif"/>
                      <swrl:argument1 rdf:resource="urn:swrl#e"/>
                    </swrl:ClassAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:ClassAtom>
                          <swrl:classPredicate rdf:resource="#SinyalEntry"/>
                          <swrl:argument1 rdf:resource="urn:swrl#e"/>
                        </swrl:ClassAtom>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#direkomendasikanUntuk"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
          <swrl:argument2 rdf:resource="urn:swrl#i"/>
        </swrl:IndividualPropertyAtom>
