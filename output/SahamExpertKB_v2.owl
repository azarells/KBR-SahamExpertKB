    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#PerluVerifikasiData"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-DAT-02</rdfs:label>
  <rdfs:comment xml:lang="id">[Kualitas Data] Top pick adaptif berbasis data indikatif wajib diverifikasi</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-DAT-02</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kualitas Data</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_DAT_03">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#DataIndikatif"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#KandidatAkumulasiBertahap"/>
              <swrl:argument1 rdf:resource="urn:swrl#e"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
