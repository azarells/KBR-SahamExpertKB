<owl:Class rdf:about="#ERPSangatMenarik">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">ERP Sangat Menarik</rdfs:label>
  <rdfs:comment xml:lang="id">Earnings yield − yield SBN ≥ 8 pp.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#ERPMenarik">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">ERP Menarik</rdfs:label>
  <rdfs:comment xml:lang="id">4 ≤ ERP &lt; 8 pp.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MahalVsObligasi">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Mahal vs Obligasi</rdfs:label>
  <rdfs:comment xml:lang="id">ERP &lt; 0 (SBN lebih menarik).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RisikoHSC">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Risiko HSC / Free Float Rendah</rdfs:label>
  <rdfs:comment xml:lang="id">Free float &lt; 15%: risiko dikeluarkan dari IHSG/MSCI.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RisikoForcedSellPengendali">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Risiko Forced Sell Pengendali</rdfs:label>
  <rdfs:comment xml:lang="id">Saham pengendali digadaikan ≥ 30% saat downtrend.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SinyalOrangDalam">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Sinyal Pembelian Orang Dalam</rdfs:label>
  <rdfs:comment xml:lang="id">Direksi/pengendali membeli saat undervalued.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndikasiSahamGorengan">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Indikasi Saham Gorengan</rdfs:label>
  <rdfs:comment xml:lang="id">Free float kecil, ARA beruntun, volume meledak, broker terkonsentrasi.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RisikoPumpAndDump">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Risiko Pump &amp; Dump</rdfs:label>
  <rdfs:comment xml:lang="id">Gorengan + overvalued + RSI ≥ 80.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KonflikFundamentalVsBandar">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Konflik: Fundamental vs Bandar</rdfs:label>
  <rdfs:comment xml:lang="id">Fundamental kuat tetapi bandar distribusi.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MomentumTanpaFundamental">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Momentum tanpa Fundamental</rdfs:label>
  <rdfs:comment xml:lang="id">Tren naik tetapi fundamental lemah.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#DistribusiSaatEuforia">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Distribusi saat Euforia</rdfs:label>
  <rdfs:comment xml:lang="id">Sentimen positif tetapi bandar distribusi.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TungguKonfirmasi">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Tunggu Konfirmasi</rdfs:label>
  <rdfs:comment xml:lang="id">Ada konflik sinyal antarpilar: tunda entry penuh.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KonfluensiTinggi">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Konfluensi Tinggi</rdfs:label>
  <rdfs:comment xml:lang="id">≥ 5 dari 6 pilar searah bullish.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KonfluensiRendah">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Konfluensi Rendah</rdfs:label>
  <rdfs:comment xml:lang="id">≤ 2 dari 6 pilar bullish.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KandidatTopPickAdaptif">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Top Pick Adaptif-Regime</rdfs:label>
  <rdfs:comment xml:lang="id">Skor terbobot regime ≥ ambang regime &amp; sektor ber-ekspektasi ≥ 2.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KandidatAkumulasiBertahap">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Kandidat Akumulasi Bertahap</rdfs:label>
  <rdfs:comment xml:lang="id">Saat kapitulasi: kualitas + murah + jejak akumulasi → beli 3 tranche.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#StrategiTrancheKatalisBiner">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Strategi Tranche Sebelum Katalis Biner</rdfs:label>
  <rdfs:comment xml:lang="id">Kandidat dengan katalis biner ≤ 45 hari: jangan full position.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RisikoKonsentrasiTema">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Risiko Konsentrasi Tema</rdfs:label>
  <rdfs:comment xml:lang="id">Dua top pick berbagi eksposur komoditas yang sama.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorRobustLintasSkenario">
  <rdfs:subClassOf rdf:resource="#InferensiSektor"/>
  <rdfs:label xml:lang="id">Sektor Robust Lintas Skenario</rdfs:label>
  <rdfs:comment xml:lang="id">Bullish di Base &amp; Bull dan tidak bearish di Bear.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorAsimetriPositif">
  <rdfs:subClassOf rdf:resource="#InferensiSektor"/>
  <rdfs:label xml:lang="id">Sektor Asimetri Positif</rdfs:label>
  <rdfs:comment xml:lang="id">Upside (Bull−Base) ≥ 1,5 × downside (Base−Bear) dan ekspektasi ≥ 2.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorKatalisDekat">
  <rdfs:subClassOf rdf:resource="#InferensiSektor"/>
  <rdfs:label xml:lang="id">Sektor dengan Katalis Dekat</rdfs:label>
  <rdfs:comment xml:lang="id">Ada katalis ≤ 45 hari untuk sektor ini.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorPerluPemantauanKetat">
  <rdfs:subClassOf rdf:resource="#InferensiSektor"/>
  <rdfs:label xml:lang="id">Sektor Perlu Pemantauan Ketat</rdfs:label>
  <rdfs:comment xml:lang="id">Tesis sektor rapuh atau gugur.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorPilihanInti">
  <rdfs:subClassOf rdf:resource="#InferensiSektor"/>
  <rdfs:label xml:lang="id">Sektor Pilihan Inti (Core)</rdfs:label>
  <rdfs:comment xml:lang="id">Bullish &amp; robust lintas skenario: porsi utama portofolio.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SektorPilihanSatelit">
  <rdfs:subClassOf rdf:resource="#InferensiSektor"/>
  <rdfs:label xml:lang="id">Sektor Pilihan Satelit</rdfs:label>
  <rdfs:comment xml:lang="id">Taruhan asimetris kontrarian: porsi kecil, menunggu pemicu.</rdfs:comment>
</owl:Class>

<InstrumenPasarModal rdf:about="#SahamBiasa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Saham Biasa (Common Stock)</rdfs:label>
  <rdfs:comment xml:lang="id">Bukti kepemilikan perusahaan dengan hak suara RUPS dan hak atas dividen setelah kewajiban lain dipenuhi.</rdfs:comment>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#SahamPreferen">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Saham Preferen</rdfs:label>
  <rdfs:comment xml:lang="id">Saham dengan hak prioritas dividen/likuidasi, umumnya tanpa hak suara.</rdfs:comment>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#Waran">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Waran</rdfs:label>
  <rdfs:comment xml:lang="id">Hak membeli saham baru pada harga dan periode tertentu; biasanya pemanis IPO/right issue.</rdfs:comment>
  <heuristikPakar xml:lang="id">Waran deep out-of-the-money mendekati jatuh tempo bernilai ~0; jangan dikoleksi sebagai investasi.</heuristikPakar>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#HMETD_Right">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">HMETD / Right</rdfs:label>
  <rdfs:comment xml:lang="id">Hak Memesan Efek Terlebih Dahulu untuk pemegang saham lama saat right issue.</rdfs:comment>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#ETF">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Exchange Traded Fund</rdfs:label>
  <rdfs:comment xml:lang="id">Reksa dana yang unit penyertaannya diperdagangkan di bursa, umumnya mengikuti indeks (mis. LQ45, IDX30).</rdfs:comment>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#ReksaDanaSaham">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Reksa Dana Saham</rdfs:label>
  <rdfs:comment xml:lang="id">Wadah investasi kolektif minimal 80% di saham, dikelola Manajer Investasi.</rdfs:comment>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#ObligasiKorporasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Obligasi Korporasi</rdfs:label>
  <rdfs:comment xml:lang="id">Surat utang perusahaan dengan kupon tetap/mengambang.</rdfs:comment>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#SuratBerhargaNegara">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Surat Berharga Negara (SBN)</rdfs:label>
  <rdfs:comment xml:lang="id">Surat utang pemerintah; yield SBN 10Y adalah acuan risk-free domestik.</rdfs:comment>
  <heuristikPakar xml:lang="id">Yield SBN naik tajam = tekanan untuk saham valuasi tinggi &amp; properti.</heuristikPakar>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#SingleStockFutures">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Single Stock Futures</rdfs:label>
  <rdfs:comment xml:lang="id">Kontrak berjangka atas saham tunggal di BEI.</rdfs:comment>
</InstrumenPasarModal>

<InstrumenPasarModal rdf:about="#IPO">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Initial Public Offering</rdfs:label>
  <rdfs:comment xml:lang="id">Penawaran umum perdana saham ke publik.</rdfs:comment>
  <heuristikPakar xml:lang="id">Hati-hati IPO dengan free float kecil dan lock-up pendek: rawan dibanting setelah ARA berturut-turut.</heuristikPakar>
</InstrumenPasarModal>

<MekanismePerdagangan rdf:about="#Lot">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Lot</rdfs:label>
  <rdfs:comment xml:lang="id">Satuan perdagangan saham di BEI; 1 lot = 100 lembar.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#FraksiHarga">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Fraksi Harga (Tick Size)</rdfs:label>
  <rdfs:comment xml:lang="id">Kelipatan perubahan harga: Rp1 (&lt;Rp200), Rp2 (Rp200-&lt;500), Rp5 (Rp500-&lt;2.000), Rp10 (Rp2.000-&lt;5.000), Rp25 (≥Rp5.000).</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#AutoRejectionAtas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Auto Rejection Atas (ARA)</rdfs:label>
  <rdfs:comment xml:lang="id">Batas kenaikan harga harian maksimum; order di atas batas ditolak sistem JATS.</rdfs:comment>
  <heuristikPakar xml:lang="id">ARA beruntun dengan volume tipis &amp; broker tunggal = tanda saham digoreng.</heuristikPakar>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#AutoRejectionBawah">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Auto Rejection Bawah (ARB)</rdfs:label>
  <rdfs:comment xml:lang="id">Batas penurunan harga harian maksimum.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#SettlementT2">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Penyelesaian T+2</rdfs:label>
  <rdfs:comment xml:lang="id">Penyelesaian transaksi (serah saham &amp; dana) dua hari bursa setelah transaksi; dijamin KPEI.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#SesiPerdagangan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Sesi Perdagangan</rdfs:label>
  <rdfs:comment xml:lang="id">Sesi I dan Sesi II perdagangan reguler hari bursa.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PraPembukaan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pra-Pembukaan (Pre-opening)</rdfs:label>
  <rdfs:comment xml:lang="id">Periode pembentukan harga pembukaan melalui call auction.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PraPenutupan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pra-Penutupan (Pre-closing)</rdfs:label>
  <rdfs:comment xml:lang="id">Periode pembentukan harga penutupan melalui call auction.</rdfs:comment>
  <heuristikPakar xml:lang="id">Lonjakan harga khusus di pre-closing berulang kali = indikasi 'window dressing'/marking the close.</heuristikPakar>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#FullCallAuction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Full Call Auction (FCA)</rdfs:label>
  <rdfs:comment xml:lang="id">Mekanisme lelang berkala untuk saham Papan Pemantauan Khusus; order book tidak transparan.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PasarReguler">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pasar Reguler</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar dengan mekanisme tawar-menawar berkelanjutan dalam satuan lot.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PasarNegosiasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pasar Negosiasi</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar transaksi berdasarkan negosiasi (crossing/block trade) di luar order book reguler.</rdfs:comment>
  <heuristikPakar xml:lang="id">Transaksi nego besar di bawah harga pasar oleh pihak pengendali = sinyal waspada (potensi distribusi).</heuristikPakar>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PasarTunai">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pasar Tunai</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar dengan penyelesaian T+0 untuk pemenuhan kewajiban.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#OrderBook">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Order Book (Bid-Offer)</rdfs:label>
  <rdfs:comment xml:lang="id">Daftar antrean beli (bid) dan jual (offer) per tingkat harga.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#JenisOrderLimit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Limit Order</rdfs:label>
  <rdfs:comment xml:lang="id">Order dengan harga tertentu.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#JenisOrderMarket">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Market Order</rdfs:label>
  <rdfs:comment xml:lang="id">Order yang langsung dicocokkan dengan harga terbaik yang tersedia.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#KapitalisasiPasar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Kapitalisasi Pasar</rdfs:label>
  <rdfs:comment xml:lang="id">Harga × jumlah saham beredar.</rdfs:comment>
  <rumus xml:lang="id">MarketCap = Harga × SahamBeredar</rumus>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#FreeFloat">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Free Float</rdfs:label>
  <rdfs:comment xml:lang="id">Porsi saham yang dimiliki publik (&lt;5%) dan dapat diperdagangkan bebas; dasar bobot indeks MSCI (Foreign Inclusion Factor).</rdfs:comment>
  <ambangBatas xml:lang="id">Rencana OJK/BEI 2026: minimum 15% (bertahap).</ambangBatas>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#SID_RDN">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">SID &amp; RDN</rdfs:label>
  <rdfs:comment xml:lang="id">Single Investor Identification (KSEI) dan Rekening Dana Nasabah untuk dana investor.</rdfs:comment>
</MekanismePerdagangan>

<AksiKorporasiPositif rdf:about="#DividenTunai">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dividen Tunai</rdfs:label>
  <rdfs:comment xml:lang="id">Pembagian laba dalam bentuk uang; ada cum date, ex date, recording date, payment date.</rdfs:comment>
  <heuristikPakar xml:lang="id">Harga cenderung naik menjelang cum date dan terkoreksi setelah ex date (dividend trap jangka pendek).</heuristikPakar>
</AksiKorporasiPositif>

<AksiKorporasiNetral rdf:about="#DividenSaham">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dividen Saham</rdfs:label>
  <rdfs:comment xml:lang="id">Pembagian laba dalam bentuk saham baru.</rdfs:comment>
</AksiKorporasiNetral>

<AksiKorporasiPositif rdf:about="#StockSplit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Stock Split</rdfs:label>
  <rdfs:comment xml:lang="id">Pemecahan nilai nominal saham untuk meningkatkan likuiditas &amp; keterjangkauan.</rdfs:comment>
</AksiKorporasiPositif>

<AksiKorporasiNegatif rdf:about="#ReverseStockSplit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Reverse Stock Split</rdfs:label>
  <rdfs:comment xml:lang="id">Penggabungan saham; sering dilakukan emiten berharga sangat rendah.</rdfs:comment>
</AksiKorporasiNegatif>

<AksiKorporasiPositif rdf:about="#Buyback">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pembelian Kembali Saham (Buyback)</rdfs:label>
  <rdfs:comment xml:lang="id">Emiten membeli sahamnya sendiri; sinyal manajemen menilai harga undervalued.</rdfs:comment>
  <heuristikPakar xml:lang="id">Buyback saat krisis pasar (OJK mengizinkan tanpa RUPS dalam kondisi berfluktuasi signifikan) adalah sinyal kuat.</heuristikPakar>
</AksiKorporasiPositif>

<AksiKorporasiNegatif rdf:about="#RightIssue">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Right Issue (PMHMETD)</rdfs:label>
  <rdfs:comment xml:lang="id">Penambahan modal dengan HMETD; dilutif bila tidak di-exercise.</rdfs:comment>
  <heuristikPakar xml:lang="id">Right issue untuk ekspansi produktif = netral/positif; untuk bayar utang = negatif.</heuristikPakar>
</AksiKorporasiNegatif>

<AksiKorporasiNegatif rdf:about="#PrivatePlacement">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Private Placement (PMTHMETD)</rdfs:label>
  <rdfs:comment xml:lang="id">Penambahan modal tanpa HMETD kepada investor tertentu; maks 10% dalam 2 tahun.</rdfs:comment>
</AksiKorporasiNegatif>

<AksiKorporasiNetral rdf:about="#TenderOffer">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Tender Offer</rdfs:label>
  <rdfs:comment xml:lang="id">Penawaran membeli saham dari publik oleh pihak tertentu, sering dengan premium.</rdfs:comment>
</AksiKorporasiNetral>

<AksiKorporasiNetral rdf:about="#Merger">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Merger</rdfs:label>
  <rdfs:comment xml:lang="id">Penggabungan dua perusahaan atau lebih.</rdfs:comment>
</AksiKorporasiNetral>

<AksiKorporasiNetral rdf:about="#Akuisisi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Akuisisi</rdfs:label>
  <rdfs:comment xml:lang="id">Pengambilalihan pengendalian perusahaan.</rdfs:comment>
</AksiKorporasiNetral>

<AksiKorporasiNetral rdf:about="#GoPrivate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Go Private / Voluntary Delisting</rdfs:label>
  <rdfs:comment xml:lang="id">Emiten keluar dari bursa secara sukarela dengan tender offer.</rdfs:comment>
</AksiKorporasiNetral>

<AksiKorporasiNegatif rdf:about="#DelistingPaksa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Forced Delisting</rdfs:label>
  <rdfs:comment xml:lang="id">Penghapusan pencatatan oleh bursa (mis. suspensi &gt;24 bulan, going concern).</rdfs:comment>
</AksiKorporasiNegatif>

<AksiKorporasiNetral rdf:about="#RUPS">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Rapat Umum Pemegang Saham</rdfs:label>
  <rdfs:comment xml:lang="id">Forum pengambilan keputusan tertinggi (RUPST/RUPSLB).</rdfs:comment>
</AksiKorporasiNetral>

<StatusPengawasan rdf:about="#Suspensi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Suspensi Perdagangan</rdfs:label>
  <rdfs:comment xml:lang="id">Penghentian sementara perdagangan saham oleh bursa.</rdfs:comment>
</StatusPengawasan>

<StatusPengawasan rdf:about="#UnusualMarketActivity">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Unusual Market Activity (UMA)</rdfs:label>
  <rdfs:comment xml:lang="id">Pengumuman bursa atas pergerakan harga/volume tidak wajar.</rdfs:comment>
  <heuristikPakar xml:lang="id">UMA setelah reli tajam sering diikuti profit taking; UMA bukan larangan beli.</heuristikPakar>
</StatusPengawasan>

<StatusPengawasan rdf:about="#NotasiKhusus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Notasi Khusus</rdfs:label>
  <rdfs:comment xml:lang="id">Huruf penanda kondisi emiten (mis. E=ekuitas negatif, M=PKPU, X=papan pemantauan khusus).</rdfs:comment>
</StatusPengawasan>

<StatusPengawasan rdf:about="#PapanPemantauanKhusus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Papan Pemantauan Khusus</rdfs:label>
  <rdfs:comment xml:lang="id">Papan untuk saham bermasalah likuiditas/fundamental; diperdagangkan via FCA.</rdfs:comment>
</StatusPengawasan>

<StatusPengawasan rdf:about="#CircuitBreakerTradingHalt">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Trading Halt Pasar</rdfs:label>
  <rdfs:comment xml:lang="id">Penghentian perdagangan pasar bila IHSG turun tajam dalam sehari.</rdfs:comment>
</StatusPengawasan>

<StatusPengawasan rdf:about="#BatasHargaGocap">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Batas Harga Minimum Rp50</rdfs:label>
  <rdfs:comment xml:lang="id">Harga minimum di Papan Utama/Pengembangan; saham 'gocap' tertahan tak bisa turun lagi di pasar reguler.</rdfs:comment>
</StatusPengawasan>

<BiayaDanPajak rdf:about="#FeeTransaksi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Fee Broker</rdfs:label>
  <rdfs:comment xml:lang="id">Biaya beli (~0,15%) dan jual (~0,25%, termasuk pajak) tergantung sekuritas.</rdfs:comment>
</BiayaDanPajak>

<BiayaDanPajak rdf:about="#PPhFinalPenjualan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">PPh Final Penjualan Saham 0,1%</rdfs:label>
  <rdfs:comment xml:lang="id">Pajak final 0,1% dari nilai bruto penjualan saham.</rdfs:comment>
</BiayaDanPajak>

<BiayaDanPajak rdf:about="#PajakDividen">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pajak Dividen</rdfs:label>
  <rdfs:comment xml:lang="id">PPh dividen 10% final bagi WP orang pribadi dalam negeri; dapat dibebaskan bila diinvestasikan kembali sesuai ketentuan.</rdfs:comment>
</BiayaDanPajak>

<GayaInvestasi rdf:about="#ValueInvesting">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Value Investing</rdfs:label>
  <rdfs:comment xml:lang="id">Membeli saham di bawah nilai intrinsik dengan margin of safety (Graham, Buffett).</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#GrowthInvesting">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Growth Investing</rdfs:label>
  <rdfs:comment xml:lang="id">Fokus emiten dengan pertumbuhan laba tinggi berkelanjutan.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#DividendInvesting">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dividend Investing</rdfs:label>
  <rdfs:comment xml:lang="id">Fokus pada arus kas dividen stabil.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#GARP">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Growth at Reasonable Price</rdfs:label>
  <rdfs:comment xml:lang="id">Pertumbuhan dengan valuasi wajar; gunakan PEG &lt; 1.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#MomentumTrading">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Momentum Trading</rdfs:label>
  <rdfs:comment xml:lang="id">Mengikuti saham yang sedang tren kuat.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#ContrarianInvesting">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Contrarian Investing</rdfs:label>
  <rdfs:comment xml:lang="id">Membeli saat pasar panik, menjual saat euforia.</rdfs:comment>
  <heuristikPakar xml:lang="id">'Be fearful when others are greedy, greedy when others are fearful.' Krisis = peluang bagi emiten berneraca kuat.</heuristikPakar>
</GayaInvestasi>

<GayaInvestasi rdf:about="#SwingTrading">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Swing Trading</rdfs:label>
  <rdfs:comment xml:lang="id">Memegang posisi beberapa hari-minggu memanfaatkan ayunan harga.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#DayTrading">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Day Trading</rdfs:label>
  <rdfs:comment xml:lang="id">Buka-tutup posisi dalam satu hari.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#Scalping">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Scalping</rdfs:label>
  <rdfs:comment xml:lang="id">Mengambil untung kecil berkali-kali dalam hitungan menit; butuh likuiditas tinggi &amp; disiplin cut loss.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#PositionTrading">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Position Trading</rdfs:label>
  <rdfs:comment xml:lang="id">Memegang berbulan-bulan mengikuti tren besar.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#IndexInvesting">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Index/Passive Investing</rdfs:label>
  <rdfs:comment xml:lang="id">Membeli indeks (ETF) untuk mengikuti pasar.</rdfs:comment>
</GayaInvestasi>

<GayaInvestasi rdf:about="#DollarCostAveraging">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dollar Cost Averaging</rdfs:label>
  <rdfs:comment xml:lang="id">Investasi rutin dengan nominal tetap untuk meratakan harga beli; cocok untuk pemula.</rdfs:comment>
</GayaInvestasi>

<ManajemenRisiko rdf:about="#StopLoss">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Stop Loss / Cut Loss</rdfs:label>
  <rdfs:comment xml:lang="id">Batas rugi yang ditetapkan sebelum entry.</rdfs:comment>
  <rumus xml:lang="id">SL = Entry - 2 × ATR (aturan sistem)</rumus>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#TakeProfit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Take Profit</rdfs:label>
  <rdfs:comment xml:lang="id">Target keluar dengan untung.</rdfs:comment>
  <rumus xml:lang="id">TP = Entry + 3 × ATR (aturan sistem)</rumus>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#RiskRewardRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Risk/Reward Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Perbandingan potensi rugi dan untung.</rdfs:comment>
  <ambangBatas xml:lang="id">Minimal 1:1,5</ambangBatas>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#PositionSizing">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Position Sizing</rdfs:label>
  <rdfs:comment xml:lang="id">Ukuran posisi berdasar risiko per transaksi.</rdfs:comment>
  <rumus xml:lang="id">Jumlah lembar = (Modal × %Risiko) / (Entry - SL)</rumus>
  <ambangBatas xml:lang="id">Risiko 1-2% modal per transaksi</ambangBatas>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#Diversifikasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Diversifikasi</rdfs:label>
  <rdfs:comment xml:lang="id">Menyebar modal ke beberapa emiten/sektor dengan korelasi rendah.</rdfs:comment>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#TrailingStop">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Trailing Stop</rdfs:label>
  <rdfs:comment xml:lang="id">Stop loss yang digeser mengikuti kenaikan harga.</rdfs:comment>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#AveragingDown">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Averaging Down</rdfs:label>
  <rdfs:comment xml:lang="id">Menambah posisi saat harga turun; hanya untuk emiten fundamental kuat.</rdfs:comment>
  <heuristikPakar xml:lang="id">Averaging down pada value trap = bencana; pastikan bukan ZonaDistress.</heuristikPakar>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#AveragingUp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Averaging Up / Pyramiding</rdfs:label>
  <rdfs:comment xml:lang="id">Menambah posisi saat tren terkonfirmasi naik.</rdfs:comment>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#MarginOfSafety">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Margin of Safety</rdfs:label>
  <rdfs:comment xml:lang="id">Selisih nilai intrinsik dengan harga pasar.</rdfs:comment>
  <ambangBatas xml:lang="id">≥ 25-30% untuk value investor</ambangBatas>
</ManajemenRisiko>

<BiasPerilaku rdf:about="#FOMO">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Fear of Missing Out</rdfs:label>
  <rdfs:comment xml:lang="id">Membeli karena takut ketinggalan reli; sering di pucuk.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#HerdingBias">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Herding</rdfs:label>
  <rdfs:comment xml:lang="id">Ikut-ikutan mayoritas/influencer tanpa analisis.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#LossAversion">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Loss Aversion</rdfs:label>
  <rdfs:comment xml:lang="id">Rasa sakit rugi lebih besar dari senang untung; menahan saham rugi terlalu lama.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#ConfirmationBias">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Confirmation Bias</rdfs:label>
  <rdfs:comment xml:lang="id">Hanya mencari informasi yang mendukung keyakinan.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#Overconfidence">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Overconfidence</rdfs:label>
  <rdfs:comment xml:lang="id">Terlalu yakin pada analisis sendiri; overtrading.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#AnchoringBias">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Anchoring</rdfs:label>
  <rdfs:comment xml:lang="id">Terpaku pada harga beli/harga tertinggi lama.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#DispositionEffect">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Disposition Effect</rdfs:label>
  <rdfs:comment xml:lang="id">Cepat menjual saham untung, menahan saham rugi.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#RecencyBias">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Recency Bias</rdfs:label>
  <rdfs:comment xml:lang="id">Menganggap tren terbaru akan berlanjut selamanya.</rdfs:comment>
</BiasPerilaku>

<BiasPerilaku rdf:about="#PanicSelling">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Panic Selling</rdfs:label>
  <rdfs:comment xml:lang="id">Menjual karena panik saat pasar jatuh tajam; sering dimanfaatkan bandar untuk akumulasi murah.</rdfs:comment>
</BiasPerilaku>

<SiklusPasar rdf:about="#BullMarket">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bull Market</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar naik ≥20% dari titik terendah dengan higher high-higher low.</rdfs:comment>
</SiklusPasar>

<SiklusPasar rdf:about="#BearMarket">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bear Market</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar turun ≥20% dari puncak.</rdfs:comment>
  <contohPenerapan xml:lang="id">IHSG 2026: dari 8.646 (akhir 2025) ke 4.996,61 (19 Okt 2026), -42% YTD.</contohPenerapan>
</SiklusPasar>

<SiklusPasar rdf:about="#SidewaysMarket">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Sideways Market</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar bergerak mendatar dalam rentang.</rdfs:comment>
</SiklusPasar>

<FaseWyckoff rdf:about="#Wyckoff_Akumulasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Wyckoff: Akumulasi</rdfs:label>
  <rdfs:comment xml:lang="id">Bandar mengumpulkan barang di area bawah setelah downtrend; volume naik di support, harga sideways.</rdfs:comment>
</FaseWyckoff>

<FaseWyckoff rdf:about="#Wyckoff_MarkUp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Wyckoff: Mark-Up</rdfs:label>
  <rdfs:comment xml:lang="id">Harga dinaikkan setelah barang terkumpul; breakout resistance.</rdfs:comment>
</FaseWyckoff>

<FaseWyckoff rdf:about="#Wyckoff_Distribusi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Wyckoff: Distribusi</rdfs:label>
  <rdfs:comment xml:lang="id">Bandar melepas barang ke ritel di area atas.</rdfs:comment>
</FaseWyckoff>

<FaseWyckoff rdf:about="#Wyckoff_MarkDown">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Wyckoff: Mark-Down</rdfs:label>
  <rdfs:comment xml:lang="id">Harga turun setelah distribusi selesai.</rdfs:comment>
</FaseWyckoff>

<ProfilRisiko rdf:about="#ProfilKonservatif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Konservatif</rdfs:label>
  <rdfs:comment xml:lang="id">Mengutamakan keamanan modal &amp; dividen; toleransi drawdown rendah.</rdfs:comment>
</ProfilRisiko>

<ProfilRisiko rdf:about="#ProfilModerat">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Moderat</rdfs:label>
  <rdfs:comment xml:lang="id">Seimbang antara pertumbuhan dan keamanan.</rdfs:comment>
</ProfilRisiko>

<ProfilRisiko rdf:about="#ProfilAgresif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Agresif</rdfs:label>
  <rdfs:comment xml:lang="id">Toleransi volatilitas tinggi, mengejar return tinggi/trading.</rdfs:comment>
</ProfilRisiko>

<HorizonInvestasi rdf:about="#Horizon_Intraday">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Intraday</rdfs:label>
  <rdfs:comment xml:lang="id">&lt; 1 hari</rdfs:comment>
</HorizonInvestasi>

<HorizonInvestasi rdf:about="#Horizon_Pendek">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Jangka Pendek</rdfs:label>
  <rdfs:comment xml:lang="id">1 minggu - 3 bulan</rdfs:comment>
</HorizonInvestasi>

<HorizonInvestasi rdf:about="#Horizon_Menengah">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Jangka Menengah (1-3 Tahun)</rdfs:label>
  <rdfs:comment xml:lang="id">Horizon utama prediksi sektor sistem ini.</rdfs:comment>
</HorizonInvestasi>

<HorizonInvestasi rdf:about="#Horizon_Panjang">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Jangka Panjang</rdfs:label>
  <rdfs:comment xml:lang="id">&gt; 3 tahun</rdfs:comment>
</HorizonInvestasi>

<LaporanKeuangan rdf:about="#Neraca">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Laporan Posisi Keuangan (Neraca)</rdfs:label>
  <rdfs:comment xml:lang="id">Aset = Liabilitas + Ekuitas pada satu titik waktu.</rdfs:comment>
</LaporanKeuangan>

<LaporanKeuangan rdf:about="#LaporanLabaRugi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Laporan Laba Rugi</rdfs:label>
  <rdfs:comment xml:lang="id">Pendapatan, beban, laba kotor, laba usaha, laba bersih dalam satu periode.</rdfs:comment>
</LaporanKeuangan>

<LaporanKeuangan rdf:about="#LaporanArusKas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Laporan Arus Kas</rdfs:label>
  <rdfs:comment xml:lang="id">Arus kas operasi (CFO), investasi (CFI), pendanaan (CFF).</rdfs:comment>
</LaporanKeuangan>

<LaporanKeuangan rdf:about="#LaporanPerubahanEkuitas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Laporan Perubahan Ekuitas</rdfs:label>
  <rdfs:comment xml:lang="id">Perubahan modal, laba ditahan, dividen.</rdfs:comment>
</LaporanKeuangan>

<LaporanKeuangan rdf:about="#CALK">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Catatan atas Laporan Keuangan</rdfs:label>
  <rdfs:comment xml:lang="id">Rincian kebijakan akuntansi, kontinjensi, transaksi pihak berelasi.</rdfs:comment>
</LaporanKeuangan>

<LaporanKeuangan rdf:about="#OpiniAuditor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Opini Auditor</rdfs:label>
  <rdfs:comment xml:lang="id">WTP, WDP, TMP, TW; paragraf 'going concern' adalah red flag.</rdfs:comment>
</LaporanKeuangan>

<RasioValuasi rdf:about="#PER">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Price to Earnings Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Berapa tahun laba untuk 'balik modal'. Bandingkan dengan rata-rata historis &amp; sektor.</rdfs:comment>
  <rumus xml:lang="id">Harga / EPS</rumus>
  <interpretasi xml:lang="id">Berapa tahun laba untuk 'balik modal'. Bandingkan dengan rata-rata historis &amp; sektor.</interpretasi>
  <ambangBatas xml:lang="id">Murah bila &lt; 0,85× rata-rata 5 th; mahal bila ≥ 1,1×</ambangBatas>
</RasioValuasi>

<RasioValuasi rdf:about="#PBV">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Price to Book Value</rdfs:label>
  <rdfs:comment xml:lang="id">Harga relatif terhadap nilai buku; penting untuk bank &amp; properti.</rdfs:comment>
  <rumus xml:lang="id">Harga / BVPS</rumus>
  <interpretasi xml:lang="id">Harga relatif terhadap nilai buku; penting untuk bank &amp; properti.</interpretasi>
  <ambangBatas xml:lang="id">PBV &lt; 1 dengan ROE &gt; 10% sering undervalued</ambangBatas>
</RasioValuasi>

<RasioValuasi rdf:about="#PSR">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Price to Sales</rdfs:label>
  <rdfs:comment xml:lang="id">Untuk emiten belum laba (teknologi).</rdfs:comment>
  <rumus xml:lang="id">Market Cap / Penjualan</rumus>
  <interpretasi xml:lang="id">Untuk emiten belum laba (teknologi).</interpretasi>
  <ambangBatas xml:lang="id">Bandingkan dengan peers</ambangBatas>
</RasioValuasi>

<RasioValuasi rdf:about="#EV_EBITDA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">EV/EBITDA</rdfs:label>
  <rdfs:comment xml:lang="id">Netral struktur modal; baik untuk komoditas &amp; infrastruktur.</rdfs:comment>
  <rumus xml:lang="id">(Market Cap + Utang - Kas) / EBITDA</rumus>
  <interpretasi xml:lang="id">Netral struktur modal; baik untuk komoditas &amp; infrastruktur.</interpretasi>
  <ambangBatas xml:lang="id">&lt; 5x murah untuk komoditas</ambangBatas>
</RasioValuasi>

<RasioValuasi rdf:about="#PEG">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">PEG Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Menyesuaikan PER dengan pertumbuhan.</rdfs:comment>
  <rumus xml:lang="id">PER / Pertumbuhan EPS (%)</rumus>
  <interpretasi xml:lang="id">Menyesuaikan PER dengan pertumbuhan.</interpretasi>
  <ambangBatas xml:lang="id">&lt; 1 menarik</ambangBatas>
</RasioValuasi>

<RasioValuasi rdf:about="#EarningsYield">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Earnings Yield</rdfs:label>
  <rdfs:comment xml:lang="id">Bandingkan dengan yield SBN 10Y (equity risk premium).</rdfs:comment>
  <rumus xml:lang="id">EPS / Harga = 1/PER</rumus>
  <interpretasi xml:lang="id">Bandingkan dengan yield SBN 10Y (equity risk premium).</interpretasi>
  <ambangBatas xml:lang="id">EY - Yield SBN &gt; 3% menarik</ambangBatas>
</RasioValuasi>

<RasioProfitabilitas rdf:about="#ROE">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Return on Equity</rdfs:label>
  <rdfs:comment xml:lang="id">Efisiensi modal pemegang saham; gunakan DuPont.</rdfs:comment>
  <rumus xml:lang="id">Laba Bersih / Ekuitas</rumus>
  <interpretasi xml:lang="id">Efisiensi modal pemegang saham; gunakan DuPont.</interpretasi>
  <ambangBatas xml:lang="id">≥ 15% sangat baik; 8-15% cukup</ambangBatas>
</RasioProfitabilitas>

<RasioProfitabilitas rdf:about="#ROA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Return on Assets</rdfs:label>
  <rdfs:comment xml:lang="id">Efisiensi aset.</rdfs:comment>
  <rumus xml:lang="id">Laba Bersih / Total Aset</rumus>
  <interpretasi xml:lang="id">Efisiensi aset.</interpretasi>
  <ambangBatas xml:lang="id">Bank ≥ 1,5% baik</ambangBatas>
</RasioProfitabilitas>

<RasioProfitabilitas rdf:about="#ROIC">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Return on Invested Capital</rdfs:label>
  <rdfs:comment xml:lang="id">Kualitas penciptaan nilai; bandingkan dengan WACC.</rdfs:comment>
  <rumus xml:lang="id">NOPAT / (Ekuitas + Utang berbunga)</rumus>
  <interpretasi xml:lang="id">Kualitas penciptaan nilai; bandingkan dengan WACC.</interpretasi>
  <ambangBatas xml:lang="id">ROIC &gt; WACC</ambangBatas>
</RasioProfitabilitas>

<RasioProfitabilitas rdf:about="#GPM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Gross Profit Margin</rdfs:label>
  <rdfs:comment xml:lang="id">Daya tawar harga &amp; efisiensi produksi.</rdfs:comment>
  <rumus xml:lang="id">Laba Kotor / Pendapatan</rumus>
  <interpretasi xml:lang="id">Daya tawar harga &amp; efisiensi produksi.</interpretasi>
  <ambangBatas xml:lang="id">Tren stabil/naik</ambangBatas>
</RasioProfitabilitas>

<RasioProfitabilitas rdf:about="#OPM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Operating Profit Margin</rdfs:label>
  <rdfs:comment xml:lang="id">Efisiensi operasional.</rdfs:comment>
  <rumus xml:lang="id">Laba Usaha / Pendapatan</rumus>
  <interpretasi xml:lang="id">Efisiensi operasional.</interpretasi>
</RasioProfitabilitas>

<RasioProfitabilitas rdf:about="#NPM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Net Profit Margin</rdfs:label>
  <rdfs:comment xml:lang="id">Porsi laba bersih dari pendapatan.</rdfs:comment>
  <rumus xml:lang="id">Laba Bersih / Pendapatan</rumus>
  <interpretasi xml:lang="id">Porsi laba bersih dari pendapatan.</interpretasi>
  <ambangBatas xml:lang="id">≥ 15% tinggi; 5-15% sedang</ambangBatas>
</RasioProfitabilitas>

<RasioProfitabilitas rdf:about="#EBITDAMargin">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">EBITDA Margin</rdfs:label>
  <rdfs:comment xml:lang="id">Profitabilitas kas sebelum D&amp;A.</rdfs:comment>
  <rumus xml:lang="id">EBITDA / Pendapatan</rumus>
  <interpretasi xml:lang="id">Profitabilitas kas sebelum D&amp;A.</interpretasi>
</RasioProfitabilitas>

<RasioSolvabilitas rdf:about="#DER">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Debt to Equity Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Leverage; semakin tinggi semakin rentan saat bunga naik.</rdfs:comment>
  <rumus xml:lang="id">Total Liabilitas / Ekuitas</rumus>
  <interpretasi xml:lang="id">Leverage; semakin tinggi semakin rentan saat bunga naik.</interpretasi>
  <ambangBatas xml:lang="id">≤ 0,5 konservatif; &gt; 1,5 berisiko (non-bank)</ambangBatas>
</RasioSolvabilitas>

<RasioSolvabilitas rdf:about="#NetGearing">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Net Gearing</rdfs:label>
  <rdfs:comment xml:lang="id">Leverage bersih kas.</rdfs:comment>
  <rumus xml:lang="id">(Utang berbunga - Kas) / Ekuitas</rumus>
  <interpretasi xml:lang="id">Leverage bersih kas.</interpretasi>
  <ambangBatas xml:lang="id">Net cash = sangat aman</ambangBatas>
</RasioSolvabilitas>

<RasioSolvabilitas rdf:about="#InterestCoverage">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Interest Coverage Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Kemampuan bayar bunga.</rdfs:comment>
  <rumus xml:lang="id">EBIT / Beban Bunga</rumus>
  <interpretasi xml:lang="id">Kemampuan bayar bunga.</interpretasi>
  <ambangBatas xml:lang="id">&lt; 1,5x berbahaya</ambangBatas>
</RasioSolvabilitas>

<RasioSolvabilitas rdf:about="#DebtToEBITDA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Net Debt / EBITDA</rdfs:label>
  <rdfs:comment xml:lang="id">Lama pelunasan utang dari EBITDA.</rdfs:comment>
  <rumus xml:lang="id">Utang bersih / EBITDA</rumus>
  <interpretasi xml:lang="id">Lama pelunasan utang dari EBITDA.</interpretasi>
  <ambangBatas xml:lang="id">&gt; 4x berisiko</ambangBatas>
</RasioSolvabilitas>

<RasioLikuiditas rdf:about="#CurrentRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Current Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Likuiditas jangka pendek.</rdfs:comment>
  <rumus xml:lang="id">Aset Lancar / Liabilitas Lancar</rumus>
  <interpretasi xml:lang="id">Likuiditas jangka pendek.</interpretasi>
  <ambangBatas xml:lang="id">≥ 1,5 sehat</ambangBatas>
</RasioLikuiditas>

<RasioLikuiditas rdf:about="#QuickRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Quick Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Likuiditas tanpa persediaan.</rdfs:comment>
  <rumus xml:lang="id">(Aset Lancar - Persediaan) / Liabilitas Lancar</rumus>
  <interpretasi xml:lang="id">Likuiditas tanpa persediaan.</interpretasi>
  <ambangBatas xml:lang="id">≥ 1</ambangBatas>
</RasioLikuiditas>

<RasioLikuiditas rdf:about="#CashRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Cash Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Likuiditas paling ketat.</rdfs:comment>
  <rumus xml:lang="id">Kas / Liabilitas Lancar</rumus>
  <interpretasi xml:lang="id">Likuiditas paling ketat.</interpretasi>
</RasioLikuiditas>

<RasioEfisiensi rdf:about="#AssetTurnover">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Asset Turnover</rdfs:label>
  <rdfs:comment xml:lang="id">Produktivitas aset.</rdfs:comment>
  <rumus xml:lang="id">Pendapatan / Total Aset</rumus>
  <interpretasi xml:lang="id">Produktivitas aset.</interpretasi>
</RasioEfisiensi>

<RasioEfisiensi rdf:about="#InventoryTurnover">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Inventory Turnover</rdfs:label>
  <rdfs:comment xml:lang="id">Kecepatan perputaran persediaan.</rdfs:comment>
  <rumus xml:lang="id">HPP / Persediaan</rumus>
  <interpretasi xml:lang="id">Kecepatan perputaran persediaan.</interpretasi>
</RasioEfisiensi>

<RasioEfisiensi rdf:about="#DSO">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Days Sales Outstanding</rdfs:label>
  <rdfs:comment xml:lang="id">Lama penagihan piutang; naik tajam = red flag.</rdfs:comment>
  <rumus xml:lang="id">Piutang / Penjualan × 365</rumus>
  <interpretasi xml:lang="id">Lama penagihan piutang; naik tajam = red flag.</interpretasi>
</RasioEfisiensi>

<RasioEfisiensi rdf:about="#CashConversionCycle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Cash Conversion Cycle</rdfs:label>
  <rdfs:comment xml:lang="id">Siklus kas operasional.</rdfs:comment>
  <rumus xml:lang="id">DIO + DSO - DPO</rumus>
  <interpretasi xml:lang="id">Siklus kas operasional.</interpretasi>
</RasioEfisiensi>

<RasioPertumbuhan rdf:about="#EPSGrowth">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pertumbuhan EPS (YoY)</rdfs:label>
  <rdfs:comment xml:lang="id">Momentum laba.</rdfs:comment>
  <rumus xml:lang="id">(EPS_t / EPS_t-1) - 1</rumus>
  <interpretasi xml:lang="id">Momentum laba.</interpretasi>
  <ambangBatas xml:lang="id">≥ 15% tinggi; &lt; 0 menurun</ambangBatas>
</RasioPertumbuhan>

<RasioPertumbuhan rdf:about="#RevenueGrowth">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pertumbuhan Pendapatan</rdfs:label>
  <rdfs:comment xml:lang="id">Momentum bisnis.</rdfs:comment>
  <rumus xml:lang="id">(Rev_t / Rev_t-1) - 1</rumus>
  <interpretasi xml:lang="id">Momentum bisnis.</interpretasi>
</RasioPertumbuhan>

<RasioPertumbuhan rdf:about="#EPS">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Earnings per Share</rdfs:label>
  <rdfs:comment xml:lang="id">Laba per lembar saham.</rdfs:comment>
  <rumus xml:lang="id">Laba Bersih / Saham Beredar</rumus>
  <interpretasi xml:lang="id">Laba per lembar saham.</interpretasi>
</RasioPertumbuhan>

<RasioValuasi rdf:about="#BVPS">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Book Value per Share</rdfs:label>
  <rdfs:comment xml:lang="id">Nilai buku per lembar.</rdfs:comment>
  <rumus xml:lang="id">Ekuitas / Saham Beredar</rumus>
  <interpretasi xml:lang="id">Nilai buku per lembar.</interpretasi>
</RasioValuasi>

<RasioDividen rdf:about="#DividendYield">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dividend Yield</rdfs:label>
  <rdfs:comment xml:lang="id">Imbal hasil tunai.</rdfs:comment>
  <rumus xml:lang="id">DPS / Harga</rumus>
  <interpretasi xml:lang="id">Imbal hasil tunai.</interpretasi>
  <ambangBatas xml:lang="id">≥ 6% tinggi (bandingkan yield SBN)</ambangBatas>
</RasioDividen>

<RasioDividen rdf:about="#DPR">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dividend Payout Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Porsi laba dibagikan.</rdfs:comment>
  <rumus xml:lang="id">DPS / EPS</rumus>
  <interpretasi xml:lang="id">Porsi laba dibagikan.</interpretasi>
  <ambangBatas xml:lang="id">&gt; 100% tidak berkelanjutan</ambangBatas>
</RasioDividen>

<RasioPerbankan rdf:about="#NPL">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Non Performing Loan</rdfs:label>
  <rdfs:comment xml:lang="id">Kualitas aset bank.</rdfs:comment>
  <rumus xml:lang="id">Kredit bermasalah (kol 3-5) / Total kredit</rumus>
  <interpretasi xml:lang="id">Kualitas aset bank.</interpretasi>
  <ambangBatas xml:lang="id">≤ 2% sangat baik; &gt; 5% batas OJK</ambangBatas>
</RasioPerbankan>

<RasioPerbankan rdf:about="#CAR">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Capital Adequacy Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Kecukupan modal bank.</rdfs:comment>
  <rumus xml:lang="id">Modal / ATMR</rumus>
  <interpretasi xml:lang="id">Kecukupan modal bank.</interpretasi>
  <ambangBatas xml:lang="id">≥ 20% kuat; &lt; 12% lemah</ambangBatas>
</RasioPerbankan>

<RasioPerbankan rdf:about="#NIM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Net Interest Margin</rdfs:label>
  <rdfs:comment xml:lang="id">Spread bunga bank.</rdfs:comment>
  <rumus xml:lang="id">Pendapatan bunga bersih / Aset produktif</rumus>
  <interpretasi xml:lang="id">Spread bunga bank.</interpretasi>
  <ambangBatas xml:lang="id">≥ 5% tinggi</ambangBatas>
</RasioPerbankan>

<RasioPerbankan rdf:about="#LDR">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Loan to Deposit Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Intermediasi &amp; likuiditas bank.</rdfs:comment>
  <rumus xml:lang="id">Kredit / DPK</rumus>
  <interpretasi xml:lang="id">Intermediasi &amp; likuiditas bank.</interpretasi>
  <ambangBatas xml:lang="id">78-92% ideal</ambangBatas>
</RasioPerbankan>

<RasioPerbankan rdf:about="#CASA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">CASA Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Dana murah; tinggi = biaya dana rendah.</rdfs:comment>
  <rumus xml:lang="id">(Giro + Tabungan) / DPK</rumus>
  <interpretasi xml:lang="id">Dana murah; tinggi = biaya dana rendah.</interpretasi>
  <ambangBatas xml:lang="id">≥ 70% sangat baik</ambangBatas>
</RasioPerbankan>

<RasioPerbankan rdf:about="#BOPO">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">BOPO</rdfs:label>
  <rdfs:comment xml:lang="id">Efisiensi bank.</rdfs:comment>
  <rumus xml:lang="id">Beban Operasional / Pendapatan Operasional</rumus>
  <interpretasi xml:lang="id">Efisiensi bank.</interpretasi>
  <ambangBatas xml:lang="id">&lt; 70% efisien</ambangBatas>
</RasioPerbankan>

<RasioPerbankan rdf:about="#CostOfCredit">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Cost of Credit</rdfs:label>
  <rdfs:comment xml:lang="id">Beban risiko kredit.</rdfs:comment>
  <rumus xml:lang="id">Biaya pencadangan / Rata-rata kredit</rumus>
  <interpretasi xml:lang="id">Beban risiko kredit.</interpretasi>
  <ambangBatas xml:lang="id">Naik = tekanan laba</ambangBatas>
</RasioPerbankan>

<RasioArusKas rdf:about="#FreeCashFlow">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Free Cash Flow</rdfs:label>
  <rdfs:comment xml:lang="id">Kas bebas untuk dividen, buyback, bayar utang.</rdfs:comment>
  <rumus xml:lang="id">CFO - Capex</rumus>
  <interpretasi xml:lang="id">Kas bebas untuk dividen, buyback, bayar utang.</interpretasi>
  <ambangBatas xml:lang="id">Positif konsisten</ambangBatas>
</RasioArusKas>

<RasioArusKas rdf:about="#CFOtoNetIncome">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">CFO / Laba Bersih</rdfs:label>
  <rdfs:comment xml:lang="id">Kualitas laba (accrual check).</rdfs:comment>
  <rumus xml:lang="id">Arus kas operasi / Laba bersih</rumus>
  <interpretasi xml:lang="id">Kualitas laba (accrual check).</interpretasi>
  <ambangBatas xml:lang="id">≥ 1 berkualitas; &lt; 0,7 waspada</ambangBatas>
</RasioArusKas>

<RasioArusKas rdf:about="#FCFYield">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">FCF Yield</rdfs:label>
  <rdfs:comment xml:lang="id">Imbal hasil kas bebas.</rdfs:comment>
  <rumus xml:lang="id">FCF / Market Cap</rumus>
  <interpretasi xml:lang="id">Imbal hasil kas bebas.</interpretasi>
  <ambangBatas xml:lang="id">≥ 8% menarik</ambangBatas>
</RasioArusKas>

<ModelSkorRisiko rdf:about="#AltmanZScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Altman Z-Score</rdfs:label>
  <rdfs:comment xml:lang="id">Model prediksi kebangkrutan (Altman, 1968).</rdfs:comment>
  <rumus xml:lang="id">Z = 1,2X1 + 1,4X2 + 3,3X3 + 0,6X4 + 1,0X5 (X1=WC/TA, X2=RE/TA, X3=EBIT/TA, X4=MVE/TL, X5=Sales/TA)</rumus>
  <ambangBatas xml:lang="id">Z &lt; 1,81 distress; 1,81-2,99 abu-abu; ≥ 2,99 aman</ambangBatas>
</ModelSkorRisiko>

<ModelSkorRisiko rdf:about="#PiotroskiFScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Piotroski F-Score</rdfs:label>
  <rdfs:comment xml:lang="id">Skor 0-9 kualitas fundamental (profitabilitas, leverage, efisiensi).</rdfs:comment>
  <ambangBatas xml:lang="id">≥ 7 kuat; ≤ 3 lemah</ambangBatas>
</ModelSkorRisiko>

<ModelSkorRisiko rdf:about="#BeneishMScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Beneish M-Score</rdfs:label>
  <rdfs:comment xml:lang="id">Model deteksi manipulasi laba (8 variabel).</rdfs:comment>
  <ambangBatas xml:lang="id">M &gt; -1,78 indikasi manipulasi</ambangBatas>
</ModelSkorRisiko>

<MetodeValuasi rdf:about="#DCF">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Discounted Cash Flow</rdfs:label>
  <rdfs:comment xml:lang="id">Nilai kini arus kas bebas masa depan didiskon WACC.</rdfs:comment>
  <rumus xml:lang="id">V = Σ FCF_t/(1+WACC)^t + TV/(1+WACC)^n</rumus>
</MetodeValuasi>

<MetodeValuasi rdf:about="#DDM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dividend Discount Model (Gordon)</rdfs:label>
  <rdfs:comment xml:lang="id">Nilai saham dari dividen yang tumbuh konstan.</rdfs:comment>
  <rumus xml:lang="id">P = D1 / (r - g)</rumus>
</MetodeValuasi>

<MetodeValuasi rdf:about="#ValuasiRelatif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Valuasi Relatif (PER Band)</rdfs:label>
  <rdfs:comment xml:lang="id">Nilai wajar = EPS × PER rata-rata historis/peers.</rdfs:comment>
  <rumus xml:lang="id">Fair Value = EPS × PER_5th (dipakai aturan R-VAL-05)</rumus>
</MetodeValuasi>

<MetodeValuasi rdf:about="#NAV">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Net Asset Value / RNAV</rdfs:label>
  <rdfs:comment xml:lang="id">Untuk properti &amp; holding: nilai aset bersih revaluasi.</rdfs:comment>
</MetodeValuasi>

<MetodeValuasi rdf:about="#SOTP">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Sum of The Parts</rdfs:label>
  <rdfs:comment xml:lang="id">Untuk konglomerasi (ASII, holding).</rdfs:comment>
</MetodeValuasi>

<MetodeValuasi rdf:about="#GrahamNumber">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Graham Number</rdfs:label>
  <rdfs:comment xml:lang="id">Batas harga wajar defensif.</rdfs:comment>
  <rumus xml:lang="id">√(22,5 × EPS × BVPS)</rumus>
</MetodeValuasi>

<MetrikIndustriSpesifik rdf:about="#StripRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Strip Ratio (Batu Bara)</rdfs:label>
  <rdfs:comment xml:lang="id">Overburden / batu bara; makin rendah makin efisien.</rdfs:comment>
</MetrikIndustriSpesifik>

<MetrikIndustriSpesifik rdf:about="#CashCostPerTon">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Cash Cost per Ton</rdfs:label>
  <rdfs:comment xml:lang="id">Biaya tunai produksi per ton komoditas.</rdfs:comment>
</MetrikIndustriSpesifik>

<MetrikIndustriSpesifik rdf:about="#ARPU">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">ARPU (Telko)</rdfs:label>
  <rdfs:comment xml:lang="id">Average Revenue per User.</rdfs:comment>
</MetrikIndustriSpesifik>

<MetrikIndustriSpesifik rdf:about="#MarketingSales">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Marketing Sales (Properti)</rdfs:label>
  <rdfs:comment xml:lang="id">Prapenjualan properti; indikator utama pendapatan 1-3 tahun ke depan.</rdfs:comment>
</MetrikIndustriSpesifik>

<MetrikIndustriSpesifik rdf:about="#SSSG">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Same Store Sales Growth (Ritel)</rdfs:label>
  <rdfs:comment xml:lang="id">Pertumbuhan penjualan toko lama.</rdfs:comment>
</MetrikIndustriSpesifik>

<MetrikIndustriSpesifik rdf:about="#TenancyRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Tenancy Ratio (Menara)</rdfs:label>
  <rdfs:comment xml:lang="id">Rata-rata penyewa per menara.</rdfs:comment>
</MetrikIndustriSpesifik>

<MetrikIndustriSpesifik rdf:about="#AISC">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">All-in Sustaining Cost (Emas)</rdfs:label>
  <rdfs:comment xml:lang="id">Biaya produksi emas per ons; margin = harga emas - AISC.</rdfs:comment>
</MetrikIndustriSpesifik>

<IndikatorTren rdf:about="#SMA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Simple Moving Average</rdfs:label>
  <rdfs:comment xml:lang="id">Rata-rata harga n periode (MA20, MA50, MA200).</rdfs:comment>
  <ambangBatas xml:lang="id">Harga &gt; MA200 = tren primer naik</ambangBatas>
</IndikatorTren>

<IndikatorTren rdf:about="#EMA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Exponential Moving Average</rdfs:label>
  <rdfs:comment xml:lang="id">MA berbobot data terbaru.</rdfs:comment>
</IndikatorTren>

<IndikatorTren rdf:about="#MACD">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">MACD</rdfs:label>
  <rdfs:comment xml:lang="id">EMA12 - EMA26, signal EMA9; histogram &gt; 0 momentum naik.</rdfs:comment>
  <ambangBatas xml:lang="id">Histogram &gt; 0 bullish</ambangBatas>
</IndikatorTren>

<IndikatorTren rdf:about="#ADX">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Average Directional Index</rdfs:label>
  <rdfs:comment xml:lang="id">Kekuatan tren.</rdfs:comment>
  <ambangBatas xml:lang="id">&gt; 25 tren kuat</ambangBatas>
</IndikatorTren>

<IndikatorTren rdf:about="#Ichimoku">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Ichimoku Kinko Hyo</rdfs:label>
  <rdfs:comment xml:lang="id">Sistem tren (Tenkan, Kijun, Kumo, Chikou).</rdfs:comment>
  <ambangBatas xml:lang="id">Harga di atas Kumo bullish</ambangBatas>
</IndikatorTren>

<IndikatorTren rdf:about="#ParabolicSAR">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Parabolic SAR</rdfs:label>
  <rdfs:comment xml:lang="id">Titik trailing stop tren.</rdfs:comment>
</IndikatorTren>

<IndikatorMomentum rdf:about="#RSI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Relative Strength Index (14)</rdfs:label>
  <rdfs:comment xml:lang="id">Osilator 0-100.</rdfs:comment>
  <ambangBatas xml:lang="id">≥ 70/75 overbought; &lt; 30 oversold; 40-65 sehat</ambangBatas>
</IndikatorMomentum>

<IndikatorMomentum rdf:about="#Stochastic">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Stochastic Oscillator</rdfs:label>
  <rdfs:comment xml:lang="id">Posisi close relatif range.</rdfs:comment>
  <ambangBatas xml:lang="id">&gt; 80 overbought; &lt; 20 oversold</ambangBatas>
</IndikatorMomentum>

<IndikatorMomentum rdf:about="#CCI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Commodity Channel Index</rdfs:label>
  <rdfs:comment xml:lang="id">Deviasi harga dari rata-rata.</rdfs:comment>
</IndikatorMomentum>

<IndikatorMomentum rdf:about="#WilliamsR">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Williams %R</rdfs:label>
  <rdfs:comment xml:lang="id">Osilator momentum.</rdfs:comment>
</IndikatorMomentum>

<IndikatorVolatilitas rdf:about="#BollingerBands">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bollinger Bands</rdfs:label>
  <rdfs:comment xml:lang="id">MA20 ± 2 standar deviasi; squeeze mendahului ledakan harga.</rdfs:comment>
</IndikatorVolatilitas>

<IndikatorVolatilitas rdf:about="#ATR">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Average True Range</rdfs:label>
  <rdfs:comment xml:lang="id">Rata-rata rentang harga; dasar stop loss sistem.</rdfs:comment>
  <ambangBatas xml:lang="id">SL = Entry - 2×ATR</ambangBatas>
</IndikatorVolatilitas>

<IndikatorVolatilitas rdf:about="#KeltnerChannel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Keltner Channel</rdfs:label>
  <rdfs:comment xml:lang="id">EMA ± ATR.</rdfs:comment>
</IndikatorVolatilitas>

<IndikatorVolume rdf:about="#OBV">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">On Balance Volume</rdfs:label>
  <rdfs:comment xml:lang="id">Akumulasi volume naik/turun; divergensi OBV vs harga = jejak bandar.</rdfs:comment>
</IndikatorVolume>

<IndikatorVolume rdf:about="#VWAP">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Volume Weighted Average Price</rdfs:label>
  <rdfs:comment xml:lang="id">Harga rata-rata tertimbang volume intraday; acuan scalper &amp; institusi.</rdfs:comment>
  <ambangBatas xml:lang="id">Di atas VWAP = pembeli dominan</ambangBatas>
</IndikatorVolume>

<IndikatorVolume rdf:about="#MFI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Money Flow Index</rdfs:label>
  <rdfs:comment xml:lang="id">RSI berbobot volume.</rdfs:comment>
</IndikatorVolume>

<IndikatorVolume rdf:about="#AccDistLine">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Accumulation/Distribution Line</rdfs:label>
  <rdfs:comment xml:lang="id">Aliran uang berdasar posisi close dalam range.</rdfs:comment>
</IndikatorVolume>

<IndikatorVolume rdf:about="#VolumeProfile">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Volume Profile</rdfs:label>
  <rdfs:comment xml:lang="id">Distribusi volume per harga (POC, value area).</rdfs:comment>
</IndikatorVolume>

<PolaBearish rdf:about="#HeadAndShoulders">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Head and Shoulders</rdfs:label>
  <rdfs:comment xml:lang="id">Tiga puncak dengan puncak tengah tertinggi; breakdown neckline = sinyal jual.</rdfs:comment>
</PolaBearish>

<PolaBullish rdf:about="#InverseHeadAndShoulders">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Inverse Head and Shoulders</rdfs:label>
  <rdfs:comment xml:lang="id">Tiga lembah, lembah tengah terdalam; breakout neckline = beli.</rdfs:comment>
</PolaBullish>

<PolaBearish rdf:about="#DoubleTop">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Double Top</rdfs:label>
  <rdfs:comment xml:lang="id">Dua puncak setara; breakdown support tengah.</rdfs:comment>
</PolaBearish>

<PolaBullish rdf:about="#DoubleBottom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Double Bottom</rdfs:label>
  <rdfs:comment xml:lang="id">Dua lembah setara (pola 'W').</rdfs:comment>
</PolaBullish>

<PolaBullish rdf:about="#TripleBottom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Triple Bottom</rdfs:label>
  <rdfs:comment xml:lang="id">Tiga kali uji support kuat.</rdfs:comment>
</PolaBullish>

<PolaBullish rdf:about="#RoundingBottom">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Rounding Bottom</rdfs:label>
  <rdfs:comment xml:lang="id">Dasar membulat; akumulasi jangka panjang.</rdfs:comment>
</PolaBullish>

<PolaBullish rdf:about="#CupAndHandle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaKontinuasi"/>
  <rdfs:label xml:lang="id">Cup and Handle</rdfs:label>
  <rdfs:comment xml:lang="id">Mangkuk + pegangan; breakout bibir mangkuk.</rdfs:comment>
</PolaBullish>

<PolaBullish rdf:about="#BullFlag">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaKontinuasi"/>
  <rdfs:label xml:lang="id">Bull Flag</rdfs:label>
  <rdfs:comment xml:lang="id">Konsolidasi singkat setelah tiang naik tajam.</rdfs:comment>
</PolaBullish>

<PolaBearish rdf:about="#BearFlag">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaKontinuasi"/>
  <rdfs:label xml:lang="id">Bear Flag</rdfs:label>
  <rdfs:comment xml:lang="id">Konsolidasi naik singkat setelah turun tajam.</rdfs:comment>
</PolaBearish>

<PolaBullish rdf:about="#AscendingTriangle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaKontinuasi"/>
  <rdfs:label xml:lang="id">Ascending Triangle</rdfs:label>
  <rdfs:comment xml:lang="id">Resistance datar, support naik.</rdfs:comment>
</PolaBullish>

<PolaBearish rdf:about="#DescendingTriangle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaKontinuasi"/>
  <rdfs:label xml:lang="id">Descending Triangle</rdfs:label>
  <rdfs:comment xml:lang="id">Support datar, resistance turun.</rdfs:comment>
</PolaBearish>

<PolaBullish rdf:about="#FallingWedge">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Falling Wedge</rdfs:label>
  <rdfs:comment xml:lang="id">Baji menyempit turun; breakout ke atas.</rdfs:comment>
</PolaBullish>

<PolaBearish rdf:about="#RisingWedge">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaReversal"/>
  <rdfs:label xml:lang="id">Rising Wedge</rdfs:label>
  <rdfs:comment xml:lang="id">Baji menyempit naik; breakdown ke bawah.</rdfs:comment>
</PolaBearish>

<PolaKontinuasi rdf:about="#SymmetricalTriangle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Symmetrical Triangle</rdfs:label>
  <rdfs:comment xml:lang="id">Konsolidasi menyempit; arah tergantung breakout.</rdfs:comment>
</PolaKontinuasi>

<PolaKontinuasi rdf:about="#RectangleRange">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Rectangle / Trading Range</rdfs:label>
  <rdfs:comment xml:lang="id">Harga bergerak di antara support-resistance datar.</rdfs:comment>
</PolaKontinuasi>

<CandlestickBullish rdf:about="#Hammer">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Hammer</rdfs:label>
  <rdfs:comment xml:lang="id">Badan kecil di atas, ekor bawah panjang di area support.</rdfs:comment>
</CandlestickBullish>

<CandlestickBullish rdf:about="#InvertedHammer">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Inverted Hammer</rdfs:label>
  <rdfs:comment xml:lang="id">Ekor atas panjang di dasar tren turun.</rdfs:comment>
</CandlestickBullish>

<CandlestickBullish rdf:about="#BullishEngulfing">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bullish Engulfing</rdfs:label>
  <rdfs:comment xml:lang="id">Lilin hijau menelan lilin merah sebelumnya.</rdfs:comment>
</CandlestickBullish>

<CandlestickBullish rdf:about="#MorningStar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Morning Star</rdfs:label>
  <rdfs:comment xml:lang="id">Pola 3 lilin pembalikan naik.</rdfs:comment>
</CandlestickBullish>

<CandlestickBullish rdf:about="#PiercingLine">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Piercing Line</rdfs:label>
  <rdfs:comment xml:lang="id">Lilin hijau menutup di atas setengah badan merah sebelumnya.</rdfs:comment>
</CandlestickBullish>

<CandlestickBullish rdf:about="#ThreeWhiteSoldiers">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Three White Soldiers</rdfs:label>
  <rdfs:comment xml:lang="id">Tiga lilin hijau berturut-turut.</rdfs:comment>
</CandlestickBullish>

<CandlestickBullish rdf:about="#BullishHarami">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bullish Harami</rdfs:label>
  <rdfs:comment xml:lang="id">Lilin kecil di dalam badan lilin merah besar.</rdfs:comment>
</CandlestickBullish>

<CandlestickBullish rdf:about="#BullishMarubozu">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bullish Marubozu</rdfs:label>
  <rdfs:comment xml:lang="id">Lilin hijau tanpa ekor; dominasi pembeli penuh.</rdfs:comment>
</CandlestickBullish>

<CandlestickBearish rdf:about="#ShootingStar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Shooting Star</rdfs:label>
  <rdfs:comment xml:lang="id">Ekor atas panjang di puncak tren naik.</rdfs:comment>
</CandlestickBearish>

<CandlestickBearish rdf:about="#HangingMan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Hanging Man</rdfs:label>
  <rdfs:comment xml:lang="id">Bentuk hammer di puncak tren.</rdfs:comment>
</CandlestickBearish>

<CandlestickBearish rdf:about="#BearishEngulfing">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bearish Engulfing</rdfs:label>
  <rdfs:comment xml:lang="id">Lilin merah menelan lilin hijau.</rdfs:comment>
</CandlestickBearish>

<CandlestickBearish rdf:about="#EveningStar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Evening Star</rdfs:label>
  <rdfs:comment xml:lang="id">Pola 3 lilin pembalikan turun.</rdfs:comment>
</CandlestickBearish>

<CandlestickBearish rdf:about="#DarkCloudCover">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dark Cloud Cover</rdfs:label>
  <rdfs:comment xml:lang="id">Lilin merah menutup di bawah setengah badan hijau.</rdfs:comment>
</CandlestickBearish>

<CandlestickBearish rdf:about="#ThreeBlackCrows">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Three Black Crows</rdfs:label>
  <rdfs:comment xml:lang="id">Tiga lilin merah berturut-turut.</rdfs:comment>
</CandlestickBearish>

<CandlestickIndecision rdf:about="#Doji">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Doji</rdfs:label>
  <rdfs:comment xml:lang="id">Open ≈ close; keraguan pasar.</rdfs:comment>
</CandlestickIndecision>

<CandlestickIndecision rdf:about="#SpinningTop">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Spinning Top</rdfs:label>
  <rdfs:comment xml:lang="id">Badan kecil, ekor atas-bawah.</rdfs:comment>
</CandlestickIndecision>

<CandlestickBullish rdf:about="#DragonflyDoji">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dragonfly Doji</rdfs:label>
  <rdfs:comment xml:lang="id">Doji dengan ekor bawah panjang di support.</rdfs:comment>
</CandlestickBullish>

<CandlestickBearish rdf:about="#GravestoneDoji">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Gravestone Doji</rdfs:label>
  <rdfs:comment xml:lang="id">Doji dengan ekor atas panjang di resistance.</rdfs:comment>
</CandlestickBearish>

<KonsepTeknikal rdf:about="#Support">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Support</rdfs:label>
  <rdfs:comment xml:lang="id">Area harga di mana permintaan cukup kuat menahan penurunan.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#Resistance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Resistance</rdfs:label>
  <rdfs:comment xml:lang="id">Area harga di mana penawaran menahan kenaikan.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#Trendline">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Trendline</rdfs:label>
  <rdfs:comment xml:lang="id">Garis penghubung higher low (uptrend) / lower high (downtrend).</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#Breakout">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Breakout</rdfs:label>
  <rdfs:comment xml:lang="id">Harga menembus resistance dengan volume besar.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#Breakdown">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Breakdown</rdfs:label>
  <rdfs:comment xml:lang="id">Harga menembus support ke bawah.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#FalseBreakout">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">False Breakout / Bull Trap</rdfs:label>
  <rdfs:comment xml:lang="id">Breakout gagal yang menjebak pembeli.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#Pullback">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pullback</rdfs:label>
  <rdfs:comment xml:lang="id">Koreksi sementara dalam tren naik.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#GoldenCross">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Golden Cross</rdfs:label>
  <rdfs:comment xml:lang="id">MA50 memotong MA200 dari bawah.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#DeathCross">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Death Cross</rdfs:label>
  <rdfs:comment xml:lang="id">MA50 memotong MA200 dari atas.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#BullishDivergence">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bullish Divergence</rdfs:label>
  <rdfs:comment xml:lang="id">Harga lower low, RSI/OBV higher low.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#BearishDivergence">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bearish Divergence</rdfs:label>
  <rdfs:comment xml:lang="id">Harga higher high, RSI/OBV lower high.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#GapUp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Gap Up</rdfs:label>
  <rdfs:comment xml:lang="id">Harga buka di atas high sebelumnya.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#BreakawayGap">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Breakaway Gap</rdfs:label>
  <rdfs:comment xml:lang="id">Gap di awal tren baru.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#ExhaustionGap">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Exhaustion Gap</rdfs:label>
  <rdfs:comment xml:lang="id">Gap di akhir tren; tanda kelelahan.</rdfs:comment>
</KonsepTeknikal>

<KonsepTeknikal rdf:about="#HigherHighHigherLow">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Higher High - Higher Low</rdfs:label>
  <rdfs:comment xml:lang="id">Struktur tren naik.</rdfs:comment>
</KonsepTeknikal>

<TeoriTeknikal rdf:about="#DowTheory">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Dow Theory</rdfs:label>
  <rdfs:comment xml:lang="id">Tren primer, sekunder, minor; indeks harus saling konfirmasi; volume konfirmasi tren.</rdfs:comment>
</TeoriTeknikal>

<TeoriTeknikal rdf:about="#ElliottWave">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Elliott Wave</rdfs:label>
  <rdfs:comment xml:lang="id">5 gelombang impuls + 3 gelombang koreksi (A-B-C).</rdfs:comment>
</TeoriTeknikal>

<TeoriTeknikal rdf:about="#FibonacciRetracement">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Fibonacci Retracement</rdfs:label>
  <rdfs:comment xml:lang="id">Level koreksi 23,6%, 38,2%, 50%, 61,8%, 78,6%.</rdfs:comment>
</TeoriTeknikal>

<TeoriTeknikal rdf:about="#WyckoffMethod">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Metode Wyckoff</rdfs:label>
  <rdfs:comment xml:lang="id">Composite Man, hukum supply-demand, cause-effect, effort-result.</rdfs:comment>
</TeoriTeknikal>

<TeoriTeknikal rdf:about="#SectorRotationTheory">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Teori Rotasi Sektor</rdfs:label>
  <rdfs:comment xml:lang="id">Sektor unggul bergantian mengikuti fase siklus ekonomi (Early→Mid→Late→Resesi).</rdfs:comment>
</TeoriTeknikal>

<KonsepBandarmology rdf:about="#BrokerSummary">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Broker Summary</rdfs:label>
  <rdfs:comment xml:lang="id">Rekap net buy/sell per broker pada satu saham dan periode.</rdfs:comment>
  <heuristikPakar xml:lang="id">Top 3 buyer konsisten (broker asing/institusi) selama &gt;10 hari = akumulasi.</heuristikPakar>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#NetForeignFlow">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Net Foreign Flow</rdfs:label>
  <rdfs:comment xml:lang="id">Selisih beli-jual investor asing.</rdfs:comment>
  <heuristikPakar xml:lang="id">Asing net sell besar di big caps saat MSCI freeze = outflow pasif, bukan selalu fundamental.</heuristikPakar>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#TopBuyerSeller">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Top Buyer/Top Seller</rdfs:label>
  <rdfs:comment xml:lang="id">Broker dengan net buy/sell terbesar.</rdfs:comment>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#AvgPriceBandar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Average Price Bandar</rdfs:label>
  <rdfs:comment xml:lang="id">Harga rata-rata beli broker akumulator; menjadi 'support psikologis' bandar.</rdfs:comment>
  <heuristikPakar xml:lang="id">Harga di bawah avg bandar = bandar 'nyangkut', biasanya akan dijaga/diangkat.</heuristikPakar>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#DoneDetail">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Done Detail / Trade Book</rdfs:label>
  <rdfs:comment xml:lang="id">Rincian transaksi yang terjadi per harga &amp; broker.</rdfs:comment>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#RunningTrade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Running Trade</rdfs:label>
  <rdfs:comment xml:lang="id">Aliran transaksi real-time.</rdfs:comment>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#BidOfferImbalance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bid-Offer Imbalance</rdfs:label>
  <rdfs:comment xml:lang="id">Ketimpangan antrean bid vs offer.</rdfs:comment>
  <heuristikPakar xml:lang="id">Bid tebal yang ditarik sebelum dimakan = fake bid (spoofing).</heuristikPakar>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#IcebergOrder">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Iceberg Order</rdfs:label>
  <rdfs:comment xml:lang="id">Order besar yang ditampilkan sebagian kecil.</rdfs:comment>
  <heuristikPakar xml:lang="id">Offer kecil yang terus terisi ulang di satu harga = bandar distribusi diam-diam.</heuristikPakar>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#CrossingBlock">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Crossing / Block Trade</rdfs:label>
  <rdfs:comment xml:lang="id">Transaksi tutup sendiri antar-akun pada pasar nego.</rdfs:comment>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#ForeignInclusionFactor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Foreign Inclusion Factor (FIF)</rdfs:label>
  <rdfs:comment xml:lang="id">Faktor porsi saham yang dapat dibeli asing di indeks MSCI.</rdfs:comment>
  <heuristikPakar xml:lang="id">Freeze FIF oleh MSCI membatasi bobot Indonesia di portofolio global.</heuristikPakar>
</KonsepBandarmology>

<KonsepBandarmology rdf:about="#AccDistBrokerScore">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Skor Akumulasi/Distribusi Broker</rdfs:label>
  <rdfs:comment xml:lang="id">Skor -100..100 dari konsentrasi net buy top-5 broker vs bottom-5 (fitur 'Bandar Detector').</rdfs:comment>
  <heuristikPakar xml:lang="id">≥ 20 akumulasi; ≤ -20 distribusi</heuristikPakar>
</KonsepBandarmology>

<PolaBandarBullish rdf:about="#PolaAkumulasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Akumulasi</rdfs:label>
  <rdfs:comment xml:lang="id">Bandar mengumpulkan barang secara bertahap; harga ditahan sideways, volume di support naik.</rdfs:comment>
</PolaBandarBullish>

<PolaBandarBullish rdf:about="#PolaMarkUp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Mark-Up</rdfs:label>
  <rdfs:comment xml:lang="id">Harga diangkat cepat setelah barang cukup; offer dimakan agresif (haka).</rdfs:comment>
</PolaBandarBullish>

<PolaBandarBullish rdf:about="#PolaShakeout">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Shakeout</rdfs:label>
  <rdfs:comment xml:lang="id">Harga dibanting singkat menembus support untuk memancing cut loss ritel, lalu kembali naik.</rdfs:comment>
</PolaBandarBullish>

<PolaBandarBullish rdf:about="#PolaSpring">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Spring (Wyckoff)</rdfs:label>
  <rdfs:comment xml:lang="id">False breakdown di dasar akumulasi.</rdfs:comment>
</PolaBandarBullish>

<PolaBandarBullish rdf:about="#PolaReAkumulasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Re-Akumulasi</rdfs:label>
  <rdfs:comment xml:lang="id">Konsolidasi akumulasi lanjutan di tengah uptrend.</rdfs:comment>
</PolaBandarBullish>

<PolaBandarBearish rdf:about="#PolaDistribusi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Distribusi</rdfs:label>
  <rdfs:comment xml:lang="id">Bandar melepas barang ke ritel di atas; berita positif sering muncul bersamaan.</rdfs:comment>
</PolaBandarBearish>

<PolaBandarBearish rdf:about="#PolaUTAD">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Upthrust After Distribution</rdfs:label>
  <rdfs:comment xml:lang="id">False breakout di puncak distribusi.</rdfs:comment>
</PolaBandarBearish>

<PolaBandarBearish rdf:about="#PolaMarkDown">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Mark-Down</rdfs:label>
  <rdfs:comment xml:lang="id">Penurunan setelah distribusi selesai.</rdfs:comment>
</PolaBandarBearish>

<PolaBandarBearish rdf:about="#PolaPumpAndDump">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdf:type rdf:resource="#PolaManipulatif"/>
  <rdfs:label xml:lang="id">Pump and Dump ('Goreng')</rdfs:label>
  <rdfs:comment xml:lang="id">Harga dipompa dengan rumor lalu dibuang ke ritel.</rdfs:comment>
</PolaBandarBearish>

<PolaManipulatif rdf:about="#PolaWashTrade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Wash Trade</rdfs:label>
  <rdfs:comment xml:lang="id">Transaksi semu untuk menciptakan kesan likuid; dilarang UU Pasar Modal.</rdfs:comment>
</PolaManipulatif>

<PolaManipulatif rdf:about="#PolaSpoofing">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Spoofing / Fake Bid</rdfs:label>
  <rdfs:comment xml:lang="id">Order palsu besar untuk memengaruhi persepsi lalu dibatalkan.</rdfs:comment>
</PolaManipulatif>

<PolaManipulatif rdf:about="#PolaPaintingTheTape">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Painting the Tape / Marking the Close</rdfs:label>
  <rdfs:comment xml:lang="id">Mengatur harga penutupan.</rdfs:comment>
</PolaManipulatif>

<PolaBandarBullish rdf:about="#PolaHakaHaki">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Haka (Hajar Kanan)</rdfs:label>
  <rdfs:comment xml:lang="id">Beli agresif langsung di offer; tanda urgensi pembeli besar.</rdfs:comment>
</PolaBandarBullish>

<PolaScalper rdf:about="#Scalp_OpeningRangeBreakout">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Opening Range Breakout</rdfs:label>
  <rdfs:comment xml:lang="id">Entry saat harga menembus high 15-30 menit pertama dengan volume.</rdfs:comment>
</PolaScalper>

<PolaScalper rdf:about="#Scalp_VWAPReclaim">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">VWAP Reclaim</rdfs:label>
  <rdfs:comment xml:lang="id">Entry saat harga kembali di atas VWAP setelah sempat di bawah.</rdfs:comment>
</PolaScalper>

<PolaScalper rdf:about="#Scalp_MomentumIgnition">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Momentum Ignition</rdfs:label>
  <rdfs:comment xml:lang="id">Lonjakan volume &amp; haka beruntun memicu momentum singkat.</rdfs:comment>
</PolaScalper>

<PolaScalper rdf:about="#Scalp_BidAskSqueeze">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bid-Ask Squeeze</rdfs:label>
  <rdfs:comment xml:lang="id">Offer tipis + bid tebal; harga mudah naik 1-3 tick.</rdfs:comment>
</PolaScalper>

<PolaScalper rdf:about="#Scalp_FirstPullback">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">First Pullback</rdfs:label>
  <rdfs:comment xml:lang="id">Entry pada koreksi pertama setelah breakout.</rdfs:comment>
</PolaScalper>

<PolaScalper rdf:about="#Scalp_GapAndGo">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Gap and Go</rdfs:label>
  <rdfs:comment xml:lang="id">Gap up dengan volume besar berlanjut naik.</rdfs:comment>
</PolaScalper>

<PolaScalper rdf:about="#Scalp_EndOfDayRun">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">End of Day Run</rdfs:label>
  <rdfs:comment xml:lang="id">Kenaikan menjelang pre-closing (waspada marking the close).</rdfs:comment>
</PolaScalper>

<SumberSentimen rdf:about="#Sumber_BeritaFinansial">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Berita Finansial</rdfs:label>
  <rdfs:comment xml:lang="id">Media bisnis (Bisnis.com, Kontan, CNBC Indonesia, Bloomberg, Reuters).</rdfs:comment>
</SumberSentimen>

<SumberSentimen rdf:about="#Sumber_RisetAnalis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Riset Analis</rdfs:label>
  <rdfs:comment xml:lang="id">Rekomendasi &amp; target harga sekuritas.</rdfs:comment>
</SumberSentimen>

<SumberSentimen rdf:about="#Sumber_MediaSosial">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Media Sosial</rdfs:label>
  <rdfs:comment xml:lang="id">Stockbit stream, X/Twitter, Telegram; bobot kredibilitas rendah, rawan pompom.</rdfs:comment>
</SumberSentimen>

<SumberSentimen rdf:about="#Sumber_KeterbukaanInformasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Keterbukaan Informasi IDX</rdfs:label>
  <rdfs:comment xml:lang="id">Pengumuman resmi emiten/bursa; kredibilitas tertinggi.</rdfs:comment>
</SumberSentimen>

<SumberSentimen rdf:about="#Sumber_RegulatorBankSentral">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Rilis Regulator &amp; Bank Sentral</rdfs:label>
  <rdfs:comment xml:lang="id">OJK, BI, The Fed, BPS.</rdfs:comment>
</SumberSentimen>

<SumberSentimen rdf:about="#Sumber_Rumor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Rumor</rdfs:label>
  <rdfs:comment xml:lang="id">Informasi tak terverifikasi; diabaikan bila kredibilitas &lt; 0,7.</rdfs:comment>
</SumberSentimen>

<KategoriSentimen rdf:about="#Sentimen_Positif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Positif</rdfs:label>
  <rdfs:comment xml:lang="id">Skor ≥ 0,2</rdfs:comment>
</KategoriSentimen>

<KategoriSentimen rdf:about="#Sentimen_Netral">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Netral</rdfs:label>
  <rdfs:comment xml:lang="id">-0,2 &lt; skor &lt; 0,2</rdfs:comment>
</KategoriSentimen>

<KategoriSentimen rdf:about="#Sentimen_Negatif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Negatif</rdfs:label>
  <rdfs:comment xml:lang="id">Skor ≤ -0,2</rdfs:comment>
</KategoriSentimen>

<KomponenML rdf:about="#ML_SentimentScorer">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Aspect-Based Sentiment Scorer</rdfs:label>
  <rdfs:comment xml:lang="id">Skor leksikon finansial Indonesia + arah variabel makro × sensitivitas sektor (sentiment_scorer.py). Output: skorSentimen berita, sektor, emiten.</rdfs:comment>
</KomponenML>

<KomponenML rdf:about="#ML_PatternDetector">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Detektor Pola Chart/Candle</rdfs:label>
  <rdfs:comment xml:lang="id">Modul pengenal pola dari data OHLCV; output terdeteksiPola (input ke SWRL).</rdfs:comment>
</KomponenML>

<KomponenML rdf:about="#ML_BacktestWeightCalibrator">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Kalibrator Bobot Backtest</rdfs:label>
  <rdfs:comment xml:lang="id">Penyesuaian bobot ambang melalui walk-forward backtest; tetap di bawah kendali aturan pakar.</rdfs:comment>
</KomponenML>

<FaseSiklusEkonomi rdf:about="#Fase_EarlyCycle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Early Cycle (Pemulihan)</rdfs:label>
  <rdfs:comment xml:lang="id">Suku bunga turun, kredit pulih; unggul: keuangan, konsumer siklikal, properti, teknologi.</rdfs:comment>
</FaseSiklusEkonomi>

<FaseSiklusEkonomi rdf:about="#Fase_MidCycle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Mid Cycle (Ekspansi)</rdfs:label>
  <rdfs:comment xml:lang="id">Pertumbuhan stabil; unggul: teknologi, industri, barang baku.</rdfs:comment>
</FaseSiklusEkonomi>

<FaseSiklusEkonomi rdf:about="#Fase_LateCycle">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Late Cycle (Overheating/Ketat)</rdfs:label>
  <rdfs:comment xml:lang="id">Inflasi &amp; bunga tinggi; unggul: energi, barang baku, kesehatan, konsumer primer.</rdfs:comment>
</FaseSiklusEkonomi>

<FaseSiklusEkonomi rdf:about="#Fase_ResesiStagflasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Resesi / Stagflasi</rdfs:label>
  <rdfs:comment xml:lang="id">Pertumbuhan turun, risk-off; unggul: konsumer primer, kesehatan, infrastruktur/utilitas, emas.</rdfs:comment>
</FaseSiklusEkonomi>

<TemaStruktural rdf:about="#Tema_HilirisasiMineral">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Hilirisasi Nikel &amp; Mineral</rdfs:label>
  <rdfs:comment xml:lang="id">Larangan ekspor bijih &amp; smelter; Indonesia produsen nikel terbesar dunia; rantai baterai EV.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_EmasSafeHaven">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Emas Safe Haven &amp; Bank Sentral</rdfs:label>
  <rdfs:comment xml:lang="id">Pembelian emas bank sentral dan premi geopolitik mendorong harga emas rekor.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_KetahananEnergi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Ketahanan Energi &amp; Gas</rdfs:label>
  <rdfs:comment xml:lang="id">Premi risiko Timur Tengah; gas sebagai energi transisi; batu bara substitusi saat minyak mahal.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_TransisiEnergi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Transisi Energi (Headwind Batu Bara)</rdfs:label>
  <rdfs:comment xml:lang="id">Komitmen net zero menekan valuasi batu bara jangka panjang.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_MakanBergiziGratis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Program Makan Bergizi Gratis (MBG)</rdfs:label>
  <rdfs:comment xml:lang="id">Belanja pemerintah besar untuk pangan &amp; protein (unggas, telur, susu).</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_Biodiesel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Mandatori Biodiesel B40/B50</rdfs:label>
  <rdfs:comment xml:lang="id">Menyerap CPO domestik; menopang harga CPO.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_DataCenterAI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Data Center &amp; AI</rdfs:label>
  <rdfs:comment xml:lang="id">Investasi hyperscaler &amp; kebutuhan konektivitas, fiber, menara, listrik.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_KonsolidasiTelko">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Konsolidasi Telko (XLSmart)</rdfs:label>
  <rdfs:comment xml:lang="id">Persaingan rasional pasca-merger; ARPU membaik.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_InklusiKeuangan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Inklusi &amp; Pendalaman Keuangan</rdfs:label>
  <rdfs:comment xml:lang="id">Penetrasi kredit rendah, bank digital, ultra-mikro.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_PopulasiKesehatan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Belanja Kesehatan &amp; JKN</rdfs:label>
  <rdfs:comment xml:lang="id">Belanja kesehatan per kapita rendah, penuaan, JKN.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_TigaJutaRumah">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Program 3 Juta Rumah</rdfs:label>
  <rdfs:comment xml:lang="id">Dorongan perumahan rakyat &amp; insentif PPN DTP.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_Danantara">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Danantara &amp; Konsolidasi BUMN</rdfs:label>
  <rdfs:comment xml:lang="id">Superholding BUMN; potensi efisiensi namun ada risiko kebijakan dividen.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_ReformasiPasarModal">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Reformasi Free Float &amp; Transparansi</rdfs:label>
  <rdfs:comment xml:lang="id">Min. free float 15%, keterbukaan pemegang &gt;1%, HSC alert; kunci pemulihan kepercayaan asing 1-3 th.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</skorKekuatanTema>
</TemaStruktural>

<TemaStruktural rdf:about="#Tema_DigitalisasiKonsumen">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Digitalisasi Konsumen</rdfs:label>
  <rdfs:comment xml:lang="id">E-commerce, ride-hailing, fintech; profitabilitas masih jadi isu.</rdfs:comment>
  <skorKekuatanTema rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</skorKekuatanTema>
</TemaStruktural>

<AturanPakar rdf:about="#H01_Petrodolar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Efek Petrodolar</rdfs:label>
  <rdfs:comment xml:lang="id">Minyak naik → surplus petrodolar &amp; USD kuat → dana asing keluar EM → IHSG tertekan, namun energi &amp; batu bara diuntungkan (substitusi energi).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H02_FedHawkish">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Fed Hawkish → EM Tertekan</rdfs:label>
  <rdfs:comment xml:lang="id">Fed menaikkan/menahan bunga tinggi → yield UST naik → DXY menguat → rupiah melemah → asing jual big caps bank.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H03_RupiahLemah">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Rupiah Lemah</rdfs:label>
  <rdfs:comment xml:lang="id">Eksportir berbasis USD (batu bara, CPO, nikel, emas) untung; importir bahan baku (farmasi, pakan, gandum, elektronik) tertekan.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H04_SukuBungaBI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">BI Rate Naik</rdfs:label>
  <rdfs:comment xml:lang="id">Bunga naik → KPR &amp; kredit kendaraan melemah → properti &amp; otomotif tertekan; bank dengan CASA tinggi relatif tahan.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H05_Inflasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Inflasi Pangan</rdfs:label>
  <rdfs:comment xml:lang="id">Inflasi pangan → daya beli turun → konsumer non-primer tertekan; produsen pangan dengan pricing power bertahan.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H06_RiskOffEmas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Risk-off → Emas</rdfs:label>
  <rdfs:comment xml:lang="id">Konflik &amp; ketidakpastian → safe haven emas → penambang emas (ANTM, MDKA, BRMS, AMMN via tembaga-emas) diuntungkan.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H07_MSCIFreeze">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">MSCI Freeze</rdfs:label>
  <rdfs:comment xml:lang="id">Freeze FIF/ancaman reklasifikasi → dana pasif keluar dari konstituen MSCI (big caps) → diskon valuasi ekstrem → peluang 1-3 th bila reformasi diterima.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H08_ContrarianKrisis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Kontrarian Krisis</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar -40% dengan sektor di bawah 0,7× PER historis: emiten neraca kuat &amp; dividen tinggi historis memberi return terbaik 1-3 th (preseden 2008-09, 2020-21).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H09_SmartMoney">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Smart Money Divergence</rdfs:label>
  <rdfs:comment xml:lang="id">Harga turun + ritel jual + broker asing/institusi akumulasi = fase akumulasi; jangan ikut panic selling.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H10_DistribusiBerita">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Distribusi saat Berita Bagus</rdfs:label>
  <rdfs:comment xml:lang="id">Berita sangat positif + RSI tinggi + broker ritel net buy besar = distribusi; ambil untung.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H11_ValueTrap">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Value Trap</rdfs:label>
  <rdfs:comment xml:lang="id">PER rendah tapi laba turun, utang tinggi, downtrend = murah karena memang buruk.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H12_KonfluensiPilar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Konfluensi Multi-Pilar</rdfs:label>
  <rdfs:comment xml:lang="id">Keyakinan tinggi hanya bila ≥3 pilar (fundamental, teknikal, bandar, sentimen, makro-geopolitik) searah.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H13_PerangDagang">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Perang Dagang AS-China</rdfs:label>
  <rdfs:comment xml:lang="id">Tarif → permintaan China melemah → logam industri &amp; batu bara tertekan; relokasi pabrik ke ASEAN positif kawasan industri.</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H14_OPEC">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Keputusan OPEC+</rdfs:label>
  <rdfs:comment xml:lang="id">Pemangkasan produksi → minyak naik; penambahan kuota → minyak turun (negatif MEDC, positif maskapai/logistik).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H15_BelanjaPemerintah">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PenjelasanEdukatif"/>
  <rdfs:label xml:lang="id">Belanja Pemerintah</rdfs:label>
  <rdfs:comment xml:lang="id">Program MBG → permintaan protein &amp; pangan → unggas (CPIN, JPFA) &amp; produsen pangan; batas: ruang fiskal &amp; twin deficit.</rdfs:comment>
</AturanPakar>

<KeluaranSistem rdf:about="#Output_PrediksiSektor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG8_DecentWork"/>
  <rdfs:label xml:lang="id">Prediksi Sektor 1-3 Tahun</rdfs:label>
  <rdfs:comment xml:lang="id">Peringkat sektor + jalur penjelasan (tailwind/headwind/tema/preseden).</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_TopPickEmiten">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG8_DecentWork"/>
  <mendukungSDG rdf:resource="#SDG1_NoPoverty"/>
  <rdfs:label xml:lang="id">Top Pick Emiten per Sektor</rdfs:label>
  <rdfs:comment xml:lang="id">Top-3 emiten di sektor bullish berdasarkan skor total multi-pilar.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_KesehatanFundamental">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG1_NoPoverty"/>
  <rdfs:label xml:lang="id">Kesehatan Fundamental &amp; Risiko Collapse</rdfs:label>
  <rdfs:comment xml:lang="id">Zona Altman, going concern, manipulasi laba, bank modal lemah.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_SinyalQuantTrade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG8_DecentWork"/>
  <rdfs:label xml:lang="id">Sinyal Quant Trade</rdfs:label>
  <rdfs:comment xml:lang="id">Entry/exit, buy on weakness, scalping, harga SL/TP berbasis ATR.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_SkenarioWhatIf">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG4_QualityEducation"/>
  <rdfs:label xml:lang="id">Analisis Skenario What-If</rdfs:label>
  <rdfs:comment xml:lang="id">Perbandingan Base/Bull/Bear per sektor.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_KecocokanProfil">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG10_ReducedInequalities"/>
  <rdfs:label xml:lang="id">Kecocokan Profil Investor</rdfs:label>
  <rdfs:comment xml:lang="id">Rekomendasi sesuai profil risiko persona.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_PenjelasanEdukatif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG4_QualityEducation"/>
  <mendukungSDG rdf:resource="#SDG10_ReducedInequalities"/>
  <rdfs:label xml:lang="id">Penjelasan Edukatif (Explainable)</rdfs:label>
  <rdfs:comment xml:lang="id">Jejak penalaran + definisi konsep dasar untuk pemula.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_PeringatanRisiko">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mendukungSDG rdf:resource="#SDG1_NoPoverty"/>
  <rdfs:label xml:lang="id">Peringatan Risiko</rdfs:label>
  <rdfs:comment xml:lang="id">Value trap, distribusi ke ritel, red flag berita, outflow pasif.</rdfs:comment>
</KeluaranSistem>

<TujuanSDG rdf:about="#SDG1_NoPoverty">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">SDG 1 - Tanpa Kemiskinan</rdfs:label>
  <rdfs:comment xml:lang="id">Kesejahteraan finansial jangka panjang.</rdfs:comment>
</TujuanSDG>

<TujuanSDG rdf:about="#SDG4_QualityEducation">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">SDG 4 - Pendidikan Berkualitas</rdfs:label>
  <rdfs:comment xml:lang="id">Edukasi berbasis kasus &amp; penalaran yang dapat dijelaskan.</rdfs:comment>
</TujuanSDG>

<TujuanSDG rdf:about="#SDG8_DecentWork">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">SDG 8 - Pekerjaan Layak &amp; Pertumbuhan Ekonomi</rdfs:label>
  <rdfs:comment xml:lang="id">Literasi &amp; kualitas keputusan investasi.</rdfs:comment>
</TujuanSDG>

<TujuanSDG rdf:about="#SDG10_ReducedInequalities">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">SDG 10 - Berkurangnya Kesenjangan</rdfs:label>
  <rdfs:comment xml:lang="id">Demokratisasi insight setara analis senior bagi ritel.</rdfs:comment>
</TujuanSDG>

<IndikatorEkonomiRiil rdf:about="#Def_PDB">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Pertumbuhan PDB</rdfs:label>
  <rdfs:comment xml:lang="id">Pertumbuhan output ekonomi riil (yoy).</rdfs:comment>
  <heuristikPakar xml:lang="id">PDB melambat → konsumer non-primer &amp; properti tertekan.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorEkonomiRiil rdf:about="#Def_NeracaPerdagangan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Neraca Perdagangan</rdfs:label>
  <rdfs:comment xml:lang="id">Ekspor - impor barang.</rdfs:comment>
  <heuristikPakar xml:lang="id">Surplus mengecil → tekanan rupiah.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorEkonomiRiil rdf:about="#Def_TransaksiBerjalan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Neraca Transaksi Berjalan</rdfs:label>
  <rdfs:comment xml:lang="id">Current account: perdagangan barang-jasa, pendapatan primer &amp; sekunder.</rdfs:comment>
  <heuristikPakar xml:lang="id">Defisit membesar + defisit finansial = twin deficit → rupiah rentan.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorEkonomiRiil rdf:about="#Def_CadanganDevisa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Cadangan Devisa</rdfs:label>
  <rdfs:comment xml:lang="id">Aset valas BI untuk stabilisasi rupiah.</rdfs:comment>
  <heuristikPakar xml:lang="id">Turun cepat = BI agresif intervensi.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorEkonomiRiil rdf:about="#Def_PMI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">PMI Manufaktur</rdfs:label>
  <rdfs:comment xml:lang="id">Purchasing Managers' Index; &gt; 50 ekspansi.</rdfs:comment>
  <heuristikPakar xml:lang="id">PMI &lt; 50 beruntun → industri &amp; bahan baku melemah.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorEkonomiRiil rdf:about="#Def_IKK">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Indeks Keyakinan Konsumen</rdfs:label>
  <rdfs:comment xml:lang="id">Survei BI; &gt; 100 optimis.</rdfs:comment>
  <heuristikPakar xml:lang="id">IKK turun → ritel &amp; otomotif melemah.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorEkonomiRiil rdf:about="#Def_PenjualanMobil">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Penjualan Mobil (Gaikindo)</rdfs:label>
  <rdfs:comment xml:lang="id">Indikator daya beli kelas menengah.</rdfs:comment>
  <heuristikPakar xml:lang="id">Dasar proyeksi ASII &amp; AUTO.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorMoneter rdf:about="#Def_YieldSBN10Y">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Yield SBN 10 Tahun</rdfs:label>
  <rdfs:comment xml:lang="id">Imbal hasil obligasi pemerintah acuan.</rdfs:comment>
  <heuristikPakar xml:lang="id">Yield naik → cost of equity naik → PER wajar turun.</heuristikPakar>
</IndikatorMoneter>

<IndikatorMoneter rdf:about="#Def_YieldUST10Y">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Yield US Treasury 10Y</rdfs:label>
  <rdfs:comment xml:lang="id">Risk-free global.</rdfs:comment>
  <heuristikPakar xml:lang="id">Yield UST tertinggi sejak 2002 (Okt 2026) menekan aset EM.</heuristikPakar>
</IndikatorMoneter>

<IndikatorMoneter rdf:about="#Def_DotPlot">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">FOMC Dot Plot</rdfs:label>
  <rdfs:comment xml:lang="id">Proyeksi suku bunga tiap anggota FOMC.</rdfs:comment>
  <heuristikPakar xml:lang="id">Median dot naik = hawkish.</heuristikPakar>
</IndikatorMoneter>

<IndikatorMoneter rdf:about="#Def_QT_QE">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Quantitative Tightening / Easing</rdfs:label>
  <rdfs:comment xml:lang="id">Pengurangan/penambahan neraca bank sentral.</rdfs:comment>
  <heuristikPakar xml:lang="id">QT menyedot likuiditas global.</heuristikPakar>
</IndikatorMoneter>

<IndikatorMoneter rdf:about="#Def_CarryTrade">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Carry Trade (Yen/USD)</rdfs:label>
  <rdfs:comment xml:lang="id">Meminjam mata uang berbunga rendah untuk aset berimbal tinggi.</rdfs:comment>
  <heuristikPakar xml:lang="id">Unwinding carry trade = risk-off mendadak di EM.</heuristikPakar>
</IndikatorMoneter>

<IndikatorMoneter rdf:about="#Def_FedFundsFutures">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Fed Funds Futures (CME FedWatch)</rdfs:label>
  <rdfs:comment xml:lang="id">Probabilitas pasar atas keputusan FOMC.</rdfs:comment>
  <heuristikPakar xml:lang="id">Perubahan probabilitas &gt; 20 pp = repricing cepat.</heuristikPakar>
</IndikatorMoneter>

<IndikatorAliranDana rdf:about="#Def_NetForeignBEI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Net Foreign Buy/Sell BEI</rdfs:label>
  <rdfs:comment xml:lang="id">Aliran dana asing harian di pasar reguler.</rdfs:comment>
  <heuristikPakar xml:lang="id">Net sell berturut &gt; 10 hari di big caps = tekanan IHSG.</heuristikPakar>
</IndikatorAliranDana>

<IndikatorEkonomiRiil rdf:about="#Def_CPI_US">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">CPI/PCE Amerika Serikat</rdfs:label>
  <rdfs:comment xml:lang="id">Inflasi AS; PCE adalah acuan The Fed.</rdfs:comment>
  <heuristikPakar xml:lang="id">Core PCE &gt; 3% → Fed sulit memangkas.</heuristikPakar>
</IndikatorEkonomiRiil>

<IndikatorHargaKomoditas rdf:about="#Def_HargaMinyak">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Harga Minyak (Brent/WTI)</rdfs:label>
  <rdfs:comment xml:lang="id">Acuan energi global.</rdfs:comment>
  <heuristikPakar xml:lang="id">Brent &gt; US$100 → inflasi impor &amp; beban subsidi APBN.</heuristikPakar>
</IndikatorHargaKomoditas>

<IndikatorHargaKomoditas rdf:about="#Def_HBA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Harga Batubara Acuan (HBA)</rdfs:label>
  <rdfs:comment xml:lang="id">Acuan pemerintah untuk royalti &amp; DMO.</rdfs:comment>
</IndikatorHargaKomoditas>

<IndikatorHargaKomoditas rdf:about="#Def_HargaReferensiCPO">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Harga Referensi CPO (Kemendag)</rdfs:label>
  <rdfs:comment xml:lang="id">Dasar bea keluar &amp; pungutan ekspor CPO.</rdfs:comment>
</IndikatorHargaKomoditas>

<InstrumenPasarModal rdf:about="#TahapanIPO">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Tahapan IPO</rdfs:label>
  <rdfs:comment xml:lang="id">Pra-efektif → bookbuilding → efektif OJK → penawaran umum (e-IPO) → penjatahan → pencatatan di BEI.</rdfs:comment>
</InstrumenPasarModal>

<MekanismePerdagangan rdf:about="#LockUp">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Lock-up Period</rdfs:label>
  <rdfs:comment xml:lang="id">Larangan menjual saham pra-IPO dalam periode tertentu.</rdfs:comment>
  <heuristikPakar xml:lang="id">Berakhirnya lock-up sering memicu tekanan jual.</heuristikPakar>
</MekanismePerdagangan>

<AksiKorporasiPositif rdf:about="#CumExDate">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Cum Date &amp; Ex Date</rdfs:label>
  <rdfs:comment xml:lang="id">Cum date: hari terakhir berhak dividen di pasar reguler; ex date: hari pertama tanpa hak.</rdfs:comment>
</AksiKorporasiPositif>

<MekanismePerdagangan rdf:about="#PapanUtama">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Papan Utama</rdfs:label>
  <rdfs:comment xml:lang="id">Papan untuk emiten besar dengan rekam jejak.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PapanPengembangan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Papan Pengembangan</rdfs:label>
  <rdfs:comment xml:lang="id">Papan untuk emiten yang belum memenuhi papan utama.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PapanAkselerasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Papan Akselerasi</rdfs:label>
  <rdfs:comment xml:lang="id">Papan untuk emiten aset skala kecil/menengah.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#PapanEkonomiBaru">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Papan Ekonomi Baru</rdfs:label>
  <rdfs:comment xml:lang="id">Papan untuk perusahaan teknologi/inovasi dengan saham hak suara multipel.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#ShortSelling">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Short Selling</rdfs:label>
  <rdfs:comment xml:lang="id">Menjual efek yang belum dimiliki; di BEI terbatas pada efek &amp; anggota bursa tertentu.</rdfs:comment>
</MekanismePerdagangan>

<MekanismePerdagangan rdf:about="#MarginTrading">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Transaksi Margin</rdfs:label>
  <rdfs:comment xml:lang="id">Pembelian dengan pinjaman dana dari sekuritas; forced sell saat harga jatuh memperdalam koreksi.</rdfs:comment>
  <heuristikPakar xml:lang="id">Saat crash, forced sell margin menciptakan harga di bawah nilai wajar (peluang bagi kas tunai).</heuristikPakar>
</MekanismePerdagangan>

<ManajemenRisiko rdf:about="#Diversifikasi_Sektor">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Batas Konsentrasi Sektor</rdfs:label>
  <rdfs:comment xml:lang="id">Batasi maksimal ~25-30% portofolio per sektor.</rdfs:comment>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#MaxDrawdown">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Maximum Drawdown</rdfs:label>
  <rdfs:comment xml:lang="id">Penurunan terbesar dari puncak ke lembah portofolio.</rdfs:comment>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#SharpeRatio">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Sharpe Ratio</rdfs:label>
  <rdfs:comment xml:lang="id">Return lebih per unit volatilitas.</rdfs:comment>
  <rumus xml:lang="id">(Rp - Rf) / σp</rumus>
</ManajemenRisiko>

<ManajemenRisiko rdf:about="#Beta">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Beta Saham</rdfs:label>
  <rdfs:comment xml:lang="id">Sensitivitas return saham terhadap IHSG.</rdfs:comment>
  <ambangBatas xml:lang="id">&gt; 1 lebih volatil dari pasar</ambangBatas>
</ManajemenRisiko>

<KomponenML rdf:about="#WalkForwardBacktest">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Backtest Walk-Forward</rdfs:label>
  <rdfs:comment xml:lang="id">Evaluasi rolling: kalibrasi di jendela t, uji di t+1, terhadap baseline IHSG/LQ45.</rdfs:comment>
</KomponenML>

<Regulator rdf:about="#OJK">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <mengawasi rdf:resource="#KSEI"/>
  <mengawasi rdf:resource="#BEI_Bursa"/>
  <mengawasi rdf:resource="#KPEI"/>
  <rdfs:label xml:lang="id">Otoritas Jasa Keuangan</rdfs:label>
  <rdfs:comment xml:lang="id">Pengatur &amp; pengawas sektor jasa keuangan; 2026 menggulirkan reformasi free float &amp; transparansi.</rdfs:comment>
</Regulator>

<SelfRegulatoryOrganization rdf:about="#BEI_Bursa">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bursa Efek Indonesia</rdfs:label>
  <rdfs:comment xml:lang="id">Penyelenggara bursa; penerbit IHSG, LQ45, IDX30, dll.</rdfs:comment>
</SelfRegulatoryOrganization>

<SelfRegulatoryOrganization rdf:about="#KSEI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Kustodian Sentral Efek Indonesia</rdfs:label>
  <rdfs:comment xml:lang="id">Kustodian &amp; penerbit SID.</rdfs:comment>
</SelfRegulatoryOrganization>

<SelfRegulatoryOrganization rdf:about="#KPEI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Kliring Penjaminan Efek Indonesia</rdfs:label>
  <rdfs:comment xml:lang="id">Kliring &amp; penjaminan penyelesaian T+2.</rdfs:comment>
</SelfRegulatoryOrganization>

<BankSentral rdf:about="#BankIndonesia">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bank Indonesia</rdfs:label>
  <rdfs:comment xml:lang="id">Otoritas moneter; RDG Okt 2026 menahan BI Rate 5,75%, menaikkan Deposit Facility ke 5%, rencana turunkan GWM.</rdfs:comment>
</BankSentral>

<BankSentral rdf:about="#TheFed">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">The Federal Reserve (FOMC)</rdfs:label>
  <rdfs:comment xml:lang="id">Bank sentral AS; FOMC 28 Okt &amp; 9 Des 2026; mayoritas pejabat melihat ruang kenaikan.</rdfs:comment>
</BankSentral>

<BankSentral rdf:about="#ECB">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">European Central Bank</rdfs:label>
  <rdfs:comment xml:lang="id">Bank sentral zona euro.</rdfs:comment>
</BankSentral>

<BankSentral rdf:about="#BankOfJapan">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bank of Japan</rdfs:label>
  <rdfs:comment xml:lang="id">Normalisasi bunga Jepang memengaruhi yen carry trade.</rdfs:comment>
</BankSentral>

<BankSentral rdf:about="#PBoC">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">People's Bank of China</rdfs:label>
  <rdfs:comment xml:lang="id">Stimulus China memengaruhi permintaan komoditas.</rdfs:comment>
</BankSentral>

<Institusi rdf:about="#BPS">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Badan Pusat Statistik</rdfs:label>
  <rdfs:comment xml:lang="id">Rilis inflasi, PDB, neraca dagang.</rdfs:comment>
</Institusi>

<Institusi rdf:about="#Kemenkeu">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Kementerian Keuangan</rdfs:label>
  <rdfs:comment xml:lang="id">Kebijakan fiskal &amp; APBN.</rdfs:comment>
</Institusi>

<Institusi rdf:about="#Kemendag">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Kementerian Perdagangan</rdfs:label>
  <rdfs:comment xml:lang="id">Penetapan harga referensi CPO &amp; bea keluar.</rdfs:comment>
</Institusi>

<Institusi rdf:about="#Danantara">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">BPI Danantara</rdfs:label>
  <rdfs:comment xml:lang="id">Superholding/sovereign fund pengelola BUMN (berdiri 2025).</rdfs:comment>
</Institusi>

<OrganisasiInternasional rdf:about="#OPEC_Plus">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">OPEC+</rdfs:label>
  <rdfs:comment xml:lang="id">Kartel produsen minyak + sekutu (Rusia dll).</rdfs:comment>
</OrganisasiInternasional>

<OrganisasiInternasional rdf:about="#IMF">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">International Monetary Fund</rdfs:label>
  <rdfs:comment xml:lang="id">Proyeksi pertumbuhan global.</rdfs:comment>
</OrganisasiInternasional>

<LembagaPemeringkat rdf:about="#SnP_Ratings">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">S&amp;P Global Ratings</rdfs:label>
  <rdfs:comment xml:lang="id">Mempertahankan Indonesia BBB/A-2 outlook stabil (2026).</rdfs:comment>
</LembagaPemeringkat>

<LembagaPemeringkat rdf:about="#Moodys">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Moody's</rdfs:label>
  <rdfs:comment xml:lang="id">Lembaga pemeringkat.</rdfs:comment>
</LembagaPemeringkat>

<LembagaPemeringkat rdf:about="#FitchRatings">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Fitch Ratings</rdfs:label>
  <rdfs:comment xml:lang="id">Lembaga pemeringkat.</rdfs:comment>
</LembagaPemeringkat>

<OrganisasiInternasional rdf:about="#EIA">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">U.S. Energy Information Administration</rdfs:label>
  <rdfs:comment xml:lang="id">Proyeksi Brent Q4 2026 ~US$105 (laporan 6 Okt 2026).</rdfs:comment>
</OrganisasiInternasional>

<PenyediaIndeks rdf:about="#Penyedia_BEI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Bursa Efek Indonesia</rdfs:label>
</PenyediaIndeks>

<PenyediaIndeks rdf:about="#Penyedia_MSCI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">MSCI Inc.</rdfs:label>
</PenyediaIndeks>

<PenyediaIndeks rdf:about="#Penyedia_FTSERussell">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">FTSE Russell (LSEG)</rdfs:label>
</PenyediaIndeks>

<PenyediaIndeks rdf:about="#Penyedia_SPDJI">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">S&amp;P Dow Jones Indices</rdfs:label>
</PenyediaIndeks>

<PenyediaIndeks rdf:about="#Penyedia_NasdaqInc">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Nasdaq Inc.</rdfs:label>
