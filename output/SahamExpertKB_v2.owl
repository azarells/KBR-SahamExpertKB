</owl:Class>

<owl:Class rdf:about="#IndikatorCoincident">
  <rdfs:subClassOf rdf:resource="#IndikatorKatalog"/>
  <rdfs:label xml:lang="id">Indikator Coincident</rdfs:label>
  <rdfs:comment xml:lang="id">Bergerak bersamaan (harga, kurs, volume).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#IndikatorLagging">
  <rdfs:subClassOf rdf:resource="#IndikatorKatalog"/>
  <rdfs:label xml:lang="id">Indikator Lagging</rdfs:label>
  <rdfs:comment xml:lang="id">Mengonfirmasi setelah kejadian (laba, inflasi, rasio keuangan).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#PenandaKualitasData">
  <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
