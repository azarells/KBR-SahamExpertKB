<swrl:Imp rdf:about="#Aturan_R_DAT_04">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#TesisInvestasi"/>
          <swrl:argument1 rdf:resource="urn:swrl#t"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#indikatorKunciTesis"/>
              <swrl:argument1 rdf:resource="urn:swrl#t"/>
              <swrl:argument2 rdf:resource="urn:swrl#i"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:ClassAtom>
                  <swrl:classPredicate rdf:resource="#DataKedaluwarsa"/>
