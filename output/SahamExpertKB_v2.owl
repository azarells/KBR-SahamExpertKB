  <rdfs:comment xml:lang="id">Alasan utama sebuah posisi + indikator kunci + kriteria invalidasi (kill switch).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TesisValid">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
