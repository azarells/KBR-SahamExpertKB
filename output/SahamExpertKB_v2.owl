<owl:Class rdf:about="#StrategiAkumulasiBertahap">
  <rdfs:subClassOf rdf:resource="#InferensiPasar"/>
  <rdfs:label xml:lang="id">Strategi Akumulasi Bertahap</rdfs:label>
