<swrl:Imp rdf:about="#Aturan_R_DAT_01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#IndikatorMakro"/>
          <swrl:argument1 rdf:resource="urn:swrl#i"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#umurDataHari"/>
              <swrl:argument1 rdf:resource="urn:swrl#i"/>
              <swrl:argument2 rdf:resource="urn:swrl#u"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#frekuensiHari"/>
                  <swrl:argument1 rdf:resource="urn:swrl#i"/>
                  <swrl:argument2 rdf:resource="urn:swrl#f"/>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:BuiltinAtom>
                      <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#multiply"/>
                      <swrl:arguments>
                        <rdf:Description>
                          <rdf:first rdf:resource="urn:swrl#b"/>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first rdf:resource="urn:swrl#f"/>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                  <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5</rdf:first>
                                </rdf:Description>
                              </rdf:rest>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </swrl:arguments>
                    </swrl:BuiltinAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:BuiltinAtom>
                          <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThan"/>
                          <swrl:arguments>
                            <rdf:Description>
                              <rdf:first rdf:resource="urn:swrl#u"/>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:first rdf:resource="urn:swrl#b"/>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                </rdf:Description>
                              </rdf:rest>
                            </rdf:Description>
                          </swrl:arguments>
                        </swrl:BuiltinAtom>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#DataKedaluwarsa"/>
          <swrl:argument1 rdf:resource="urn:swrl#i"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-DAT-01</rdfs:label>
  <rdfs:comment xml:lang="id">[Kualitas Data] Data kedaluwarsa bila umur &gt; 5 × frekuensi pembaruan</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-DAT-01</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kualitas Data</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_DAT_02">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
