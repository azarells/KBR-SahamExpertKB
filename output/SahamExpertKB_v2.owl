  <rdfs:comment xml:lang="id">(Inferensi) regime terdeteksi dari skor stres pasar.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#InferensiPasar">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
