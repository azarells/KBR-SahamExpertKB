  <rdfs:comment xml:lang="id">Laba direvisi naik &amp; murah, tetapi harga belum bereaksi (teknikal ≤ 4).</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#MurahKarenaLabaTurun">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Murah karena Laba Turun</rdfs:label>
  <rdfs:comment xml:lang="id">Undervalued + revisi turun: peringatan dini value trap.</rdfs:comment>
