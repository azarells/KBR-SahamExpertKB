      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#CelahEkspektasiPositif"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
