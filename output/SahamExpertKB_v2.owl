  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ADP-03</rdfs:label>
  <rdfs:comment xml:lang="id">[Adaptif Regime] Top pick adaptif: skor adaptif ≥ ambang regime, sektor ekspektasi ≥ 2, penalti ≥ -1</rdfs:comment>
