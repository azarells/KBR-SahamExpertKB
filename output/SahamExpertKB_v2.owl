                  <swrl:argument1 rdf:resource="urn:swrl#e"/>
                </swrl:ClassAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#direkomendasikanUntuk"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
          <swrl:argument2 rdf:resource="urn:swrl#i"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-04</rdfs:label>
  <rdfs:comment xml:lang="id">[Stakeholder] Rekomendasi persona konservatif</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-04</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stakeholder</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_PRF_05">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#InvestorRitel"/>
          <swrl:argument1 rdf:resource="urn:swrl#i"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#memilikiProfilRisiko"/>
              <swrl:argument1 rdf:resource="urn:swrl#i"/>
              <swrl:argument2 rdf:resource="#ProfilModerat"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:ClassAtom>
                  <swrl:classPredicate rdf:resource="#CocokModerat"/>
                  <swrl:argument1 rdf:resource="urn:swrl#e"/>
                </swrl:ClassAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#termasukSektor"/>
                      <swrl:argument1 rdf:resource="urn:swrl#e"/>
                      <swrl:argument2 rdf:resource="urn:swrl#s"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:ClassAtom>
                          <swrl:classPredicate rdf:resource="#SektorBullish"/>
                          <swrl:argument1 rdf:resource="urn:swrl#s"/>
                        </swrl:ClassAtom>
                      </rdf:first>
                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#direkomendasikanUntuk"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
          <swrl:argument2 rdf:resource="urn:swrl#i"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-05</rdfs:label>
  <rdfs:comment xml:lang="id">[Stakeholder] Rekomendasi persona moderat (hanya sektor bullish)</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-05</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stakeholder</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_PRF_06">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#InvestorRitel"/>
          <swrl:argument1 rdf:resource="urn:swrl#i"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
