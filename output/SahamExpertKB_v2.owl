<TesisInvestasi rdf:about="#Tesis_BarangBaku_EmasNikel">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <tesisUntukSektor rdf:resource="#Sektor_BarangBaku"/>
  <indikatorKunciTesis rdf:resource="#Makro_Emas"/>
  <rdfs:label xml:lang="id">Tesis: Emas &amp; nikel menopang Barang Baku</rdfs:label>
  <rdfs:comment xml:lang="id">Emas tetap tinggi (safe haven, bank sentral) &amp; kuota nikel. Gugur bila emas &lt; US$3.800.</rdfs:comment>
  <ambangInvalidasiBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">3800.0</ambangInvalidasiBawah>
  <ambangInvalidasiAtas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1000000000.0</ambangInvalidasiAtas>
</TesisInvestasi>

<TesisInvestasi rdf:about="#Tesis_Energi_PremiGeopolitik">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <tesisUntukSektor rdf:resource="#Sektor_Energi"/>
  <indikatorKunciTesis rdf:resource="#Makro_Brent"/>
  <rdfs:label xml:lang="id">Tesis: Premi geopolitik minyak</rdfs:label>
  <rdfs:comment xml:lang="id">Premi risiko Timur Tengah menjaga harga energi. Gugur bila Brent &lt; US$75 (de-eskalasi penuh).</rdfs:comment>
  <ambangInvalidasiBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">75.0</ambangInvalidasiBawah>
  <ambangInvalidasiAtas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1000000000.0</ambangInvalidasiAtas>
</TesisInvestasi>

<TesisInvestasi rdf:about="#Tesis_Kesehatan_Defensif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <tesisUntukSektor rdf:resource="#Sektor_Kesehatan"/>
  <indikatorKunciTesis rdf:resource="#Makro_USDIDR"/>
  <rdfs:label xml:lang="id">Tesis: Kesehatan defensif</rdfs:label>
  <rdfs:comment xml:lang="id">Permintaan stabil &amp; valuasi turun. Gugur bila USD/IDR &gt; 19.500 (bahan baku impor).</rdfs:comment>
  <ambangInvalidasiBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</ambangInvalidasiBawah>
  <ambangInvalidasiAtas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">19500.0</ambangInvalidasiAtas>
</TesisInvestasi>

<TesisInvestasi rdf:about="#Tesis_Keuangan_Kontrarian">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <tesisUntukSektor rdf:resource="#Sektor_Keuangan"/>
  <indikatorKunciTesis rdf:resource="#Makro_CDS5Y"/>
  <rdfs:label xml:lang="id">Tesis kontrarian: Big banks pasca-kapitulasi</rdfs:label>
  <rdfs:comment xml:lang="id">Diskon ekstrem akibat outflow pasif. Terpicu bila CDS &lt; 85 bps; gugur bila CDS &gt; 150 bps.</rdfs:comment>
  <ambangInvalidasiBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</ambangInvalidasiBawah>
  <ambangInvalidasiAtas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">150.0</ambangInvalidasiAtas>
  <ambangPemicuBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">85.0</ambangPemicuBawah>
</TesisInvestasi>

<TesisInvestasi rdf:about="#Tesis_Infrastruktur_DataCenter">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <tesisUntukSektor rdf:resource="#Sektor_Infrastruktur"/>
  <indikatorKunciTesis rdf:resource="#Makro_YieldSBN10Y"/>
  <rdfs:label xml:lang="id">Tesis kontrarian: Infrastruktur digital</rdfs:label>
  <rdfs:comment xml:lang="id">Data center &amp; konsolidasi telko. Terpicu bila yield SBN &lt; 6,75%; gugur bila &gt; 8%.</rdfs:comment>
  <ambangInvalidasiBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</ambangInvalidasiBawah>
  <ambangInvalidasiAtas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.0</ambangInvalidasiAtas>
  <ambangPemicuBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.75</ambangPemicuBawah>
</TesisInvestasi>

<TesisInvestasi rdf:about="#Tesis_KonsumenPrimer_MBG">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <tesisUntukSektor rdf:resource="#Sektor_KonsumenPrimer"/>
  <indikatorKunciTesis rdf:resource="#Makro_InflasiID"/>
  <rdfs:label xml:lang="id">Tesis: Konsumen primer (MBG &amp; CPO)</rdfs:label>
  <rdfs:comment xml:lang="id">Belanja MBG &amp; biodiesel. Gugur bila inflasi &gt; 5% (daya beli runtuh).</rdfs:comment>
  <ambangInvalidasiBawah rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.0</ambangInvalidasiBawah>
  <ambangInvalidasiAtas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">5.0</ambangInvalidasiAtas>
</TesisInvestasi>

<AturanPakar rdf:about="#H16_RegimeAware">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Sinyal yang sama bermakna berbeda per regime</rdfs:label>
  <rdfs:comment xml:lang="id">Saat krisis likuiditas, teknikal &amp; sentimen menyesatkan (semua saham di bawah MA200); bobot dipindah ke neraca, valuasi, dan jejak smart money (R-REG, R-ADP).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H17_PricedIn">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Berita buruk, harga tidak turun</rdfs:label>
  <rdfs:comment xml:lang="id">Bila berita negatif tidak lagi menekan harga dan bandar akumulasi, berita sudah priced-in (R-REF-01).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H18_SellTheNews">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Berita bagus, harga tidak naik</rdfs:label>
  <rdfs:comment xml:lang="id">Berita positif + kalah dari pasar + distribusi = sell the news (R-REF-02).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H19_Kapitulasi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Kapitulasi &amp; akumulasi bertahap</rdfs:label>
  <rdfs:comment xml:lang="id">Hari crash ≥10% + drawdown ≥40% + breadth washout = zona akumulasi generasional; beli 3 tranche, bukan sekaligus (R-PAS, R-KAP).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H20_RevisiLaba">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Ikuti arah revisi, bukan level</rdfs:label>
  <rdfs:comment xml:lang="id">Pasar membayar perubahan ekspektasi; revisi naik + harga tertinggal = celah ekspektasi (R-REV).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H21_ReactionFunction">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Antisipasi reaksi otoritas</rdfs:label>
  <rdfs:comment xml:lang="id">Rupiah lemah + inflasi naik → BI naik pre-emptif; Brent &gt;100 → risiko penyesuaian BBM; drawdown dalam → stabilisasi pasar (R-ANT).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H22_ERP">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Bandingkan dengan obligasi</rdfs:label>
  <rdfs:comment xml:lang="id">Earnings yield − yield SBN: ERP tinggi berarti saham murah relatif aset bebas risiko domestik (R-ERP).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H23_Robustness">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Pilih posisi yang tahan banyak skenario</rdfs:label>
  <rdfs:comment xml:lang="id">Utamakan sektor robust lintas skenario; ambil taruhan asimetris bila upside ≥ 1,5× downside (R-ROB).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H24_Konfluensi">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Keyakinan dari konfluensi, kehati-hatian dari konflik</rdfs:label>
  <rdfs:comment xml:lang="id">≥5 pilar searah = keyakinan; fundamental vs bandar bertentangan = tunggu konfirmasi (R-KON).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H25_Sizing">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Ukuran posisi dari risiko, bukan keyakinan</rdfs:label>
  <rdfs:comment xml:lang="id">Ukuran = risiko per transaksi / jarak stop (2×ATR); risiko dipangkas di regime krisis (R-POS).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H26_KillSwitch">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Setiap tesis punya kriteria gugur</rdfs:label>
  <rdfs:comment xml:lang="id">Tetapkan indikator kunci &amp; ambang invalidasi sebelum masuk; buffer &lt; 10% = tesis rapuh (R-TES).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H27_KatalisBiner">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Jangan full position sebelum katalis biner</rdfs:label>
  <rdfs:comment xml:lang="id">FOMC, review MSCI, pemilu: masuk bertahap dan sisakan kas (R-KAT).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H28_Governance">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Diskon tata kelola</rdfs:label>
  <rdfs:comment xml:lang="id">Free float &lt; 15%, gadai saham pengendali, ARA beruntun dengan broker terkonsentrasi = risiko yang tak terlihat di rasio (R-GOV).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H29_Intermarket">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Pasar obligasi &amp; CDS mendahului saham</rdfs:label>
  <rdfs:comment xml:lang="id">Dasar IHSG lebih kredibel bila CDS &amp; rupiah sudah membaik lebih dulu (R-PAS-06/07).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H30_DataKualitas">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Tahu batas data sendiri</rdfs:label>
  <rdfs:comment xml:lang="id">Rekomendasi yang bertumpu pada data indikatif/kedaluwarsa wajib diverifikasi (R-DAT).</rdfs:comment>
</AturanPakar>

<AturanPakar rdf:about="#H31_ForcedSelling">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <heuristikDigunakanOleh rdf:resource="#Output_PrediksiSektor"/>
  <heuristikDigunakanOleh rdf:resource="#Output_SinyalQuantTrade"/>
  <rdfs:label xml:lang="id">Penjualan paksa tidak sensitif harga</rdfs:label>
  <rdfs:comment xml:lang="id">Outflow pasif (reklasifikasi indeks) menjual tanpa melihat valuasi; setelah tanggal efektif tekanan mekanis berakhir — pakar membeli setelah, bukan sebelum, eksekusi.</rdfs:comment>
</AturanPakar>

<KeluaranSistem rdf:about="#Output_RegimeDanStrategiPasar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Regime &amp; Strategi Pasar</rdfs:label>
  <rdfs:comment xml:lang="id">Deteksi regime, kapitulasi, akumulasi bertahap, antisipasi kebijakan.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_TesisDanKillSwitch">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Tesis &amp; Kill Switch</rdfs:label>
  <rdfs:comment xml:lang="id">Pemantauan validitas tesis &amp; ambang invalidasi.</rdfs:comment>
</KeluaranSistem>

<KeluaranSistem rdf:about="#Output_KalenderKatalis">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <rdfs:label xml:lang="id">Kalender Katalis</rdfs:label>
  <rdfs:comment xml:lang="id">Katalis biner/musiman ≤ 45 hari &amp; strategi tranche.</rdfs:comment>
</KeluaranSistem>

<swrl:Imp rdf:about="#Aturan_R_FUND_01a">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Emiten"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#roe"/>
              <swrl:argument1 rdf:resource="urn:swrl#e"/>
              <swrl:argument2 rdf:resource="urn:swrl#v"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                  <swrl:arguments>
                    <rdf:Description>
                      <rdf:first rdf:resource="urn:swrl#v"/>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</rdf:first>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:DatavaluedPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#poinROE"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
          <swrl:argument2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</swrl:argument2>
        </swrl:DatavaluedPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-FUND-01a</rdfs:label>
  <rdfs:comment xml:lang="id">[Fundamental] Poin ROE: roe ∈ [15.0, +inf) → poinROE 2</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-FUND-01a</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental</pilarAnalisis>
</swrl:Imp>

