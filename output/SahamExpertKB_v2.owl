            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#TesisGugur"/>
          <swrl:argument1 rdf:resource="urn:swrl#t"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-TES-02</rdfs:label>
  <rdfs:comment xml:lang="id">[Tesis &amp; Invalidasi] Tesis gugur: indikator di atas ambang invalidasi atas</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-TES-02</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tesis &amp; Invalidasi</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_TES_03">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#TesisInvestasi"/>
          <swrl:argument1 rdf:resource="urn:swrl#t"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:IndividualPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#indikatorKunciTesis"/>
              <swrl:argument1 rdf:resource="urn:swrl#t"/>
              <swrl:argument2 rdf:resource="urn:swrl#i"/>
            </swrl:IndividualPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#nilaiIndikator"/>
                  <swrl:argument1 rdf:resource="urn:swrl#i"/>
                  <swrl:argument2 rdf:resource="urn:swrl#v"/>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#ambangInvalidasiBawah"/>
                      <swrl:argument1 rdf:resource="urn:swrl#t"/>
                      <swrl:argument2 rdf:resource="urn:swrl#b"/>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:BuiltinAtom>
                          <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                          <swrl:arguments>
                            <rdf:Description>
                              <rdf:first rdf:resource="urn:swrl#v"/>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:first rdf:resource="urn:swrl#b"/>
                                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                </rdf:Description>
                              </rdf:rest>
                            </rdf:Description>
                          </swrl:arguments>
                        </swrl:BuiltinAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#ambangInvalidasiAtas"/>
                              <swrl:argument1 rdf:resource="urn:swrl#t"/>
                              <swrl:argument2 rdf:resource="urn:swrl#a"/>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#v"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#a"/>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#TesisValid"/>
          <swrl:argument1 rdf:resource="urn:swrl#t"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-TES-03</rdfs:label>
  <rdfs:comment xml:lang="id">[Tesis &amp; Invalidasi] Tesis valid: indikator di dalam rentang</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-TES-03</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tesis &amp; Invalidasi</pilarAnalisis>
