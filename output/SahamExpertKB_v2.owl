<AntisipasiKebijakan rdf:about="#Antisipasi_BIHikePreemptif">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <antisipasiMengaktifkan rdf:resource="#Mv_SukuBungaBINaik"/>
  <rdfs:label xml:lang="id">BI Naikkan Suku Bunga Pre-emptif</rdfs:label>
  <rdfs:comment xml:lang="id">Rupiah ≥ 17.500 &amp; inflasi ≥ 3% → BI cenderung menaikkan bunga sebelum konsensus.</rdfs:comment>
</AntisipasiKebijakan>

<AntisipasiKebijakan rdf:about="#Antisipasi_PenyesuaianBBM">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <antisipasiMengaktifkan rdf:resource="#Mv_KenaikanHargaBBM"/>
  <rdfs:label xml:lang="id">Penyesuaian Harga BBM / Subsidi</rdfs:label>
  <rdfs:comment xml:lang="id">Brent ≥ US$100 → tekanan subsidi → probabilitas kenaikan harga BBM.</rdfs:comment>
</AntisipasiKebijakan>

<AntisipasiKebijakan rdf:about="#Antisipasi_OutflowSBN">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <antisipasiMengaktifkan rdf:resource="#Mv_OutflowSBN"/>
  <rdfs:label xml:lang="id">Outflow Asing dari SBN</rdfs:label>
  <rdfs:comment xml:lang="id">Fed ≥ 4% &amp; spread SBN-UST ≤ 225 bps → daya tarik SBN turun.</rdfs:comment>
</AntisipasiKebijakan>

<AntisipasiKebijakan rdf:about="#Antisipasi_StabilisasiPasar">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <antisipasiMengaktifkan rdf:resource="#Mv_DukunganLikuiditasDomestik"/>
  <rdfs:label xml:lang="id">Stabilisasi Pasar oleh Otoritas &amp; Institusi Domestik</rdfs:label>
  <rdfs:comment xml:lang="id">Drawdown ≤ -35% → buyback tanpa RUPS, dana pensiun/BUMN membeli blue chip (buyer of last resort).</rdfs:comment>
</AntisipasiKebijakan>

<AntisipasiKebijakan rdf:about="#Antisipasi_PremiRisikoNegara">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <antisipasiMengaktifkan rdf:resource="#Mv_PremiRisikoNegaraNaik"/>
  <rdfs:label xml:lang="id">Kenaikan Premi Risiko Negara</rdfs:label>
  <rdfs:comment xml:lang="id">CDS ≥ 90 bps → asing mengurangi eksposur Indonesia.</rdfs:comment>
</AntisipasiKebijakan>

