  <rdfs:comment xml:lang="id">Kekuatan relatif vs IHSG ≥ +5 pp.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#UnderperformPasar">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Kalah dari Pasar</rdfs:label>
  <rdfs:comment xml:lang="id">Kekuatan relatif vs IHSG ≤ -5 pp.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KapitulasiEmiten">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Kapitulasi Emiten</rdfs:label>
  <rdfs:comment xml:lang="id">Volume ≥ 1,8×, RSI &lt; 35, turun ≥ 15% sebulan.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RevisiLabaNaik">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Revisi Laba Naik</rdfs:label>
  <rdfs:comment xml:lang="id">Konsensus EPS 3 bulan direvisi naik ≥ 5%.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#RevisiLabaTurun">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
  <rdfs:label xml:lang="id">Revisi Laba Turun</rdfs:label>
  <rdfs:comment xml:lang="id">Konsensus EPS 3 bulan direvisi turun ≥ 5%.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#CelahEkspektasiPositif">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
