<swrl:Imp rdf:about="#Aturan_R_POS_01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Emiten"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#RegimeAktif"/>
              <swrl:argument1 rdf:resource="urn:swrl#r"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:DatavaluedPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#risikoPerTransaksiPersen"/>
                  <swrl:argument1 rdf:resource="urn:swrl#r"/>
                  <swrl:argument2 rdf:resource="urn:swrl#x"/>
                </swrl:DatavaluedPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:DatavaluedPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#atrPersen"/>
                      <swrl:argument1 rdf:resource="urn:swrl#e"/>
                      <swrl:argument2 rdf:resource="urn:swrl#a"/>
                    </swrl:DatavaluedPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:BuiltinAtom>
                          <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#multiply"/>
                          <swrl:arguments>
                            <rdf:Description>
                              <rdf:first rdf:resource="urn:swrl#d"/>
                              <rdf:rest>
                                <rdf:Description>
                                  <rdf:first rdf:resource="urn:swrl#a"/>
                                  <rdf:rest>
                                    <rdf:Description>
                                      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                      <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">2.0</rdf:first>
                                    </rdf:Description>
                                  </rdf:rest>
                                </rdf:Description>
                              </rdf:rest>
                            </rdf:Description>
                          </swrl:arguments>
                        </swrl:BuiltinAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:BuiltinAtom>
                              <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#divide"/>
                              <swrl:arguments>
                                <rdf:Description>
                                  <rdf:first rdf:resource="urn:swrl#q"/>
                                  <rdf:rest>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#x"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#d"/>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </rdf:rest>
                                </rdf:Description>
                              </swrl:arguments>
                            </swrl:BuiltinAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#multiply"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#u"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#q"/>
                                          <rdf:rest>
                                            <rdf:Description>
                                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">100.0</rdf:first>
                                            </rdf:Description>
                                          </rdf:rest>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:DatavaluedPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#ukuranPosisiMaksPersen"/>
          <swrl:argument1 rdf:resource="urn:swrl#e"/>
          <swrl:argument2 rdf:resource="urn:swrl#u"/>
        </swrl:DatavaluedPropertyAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-01</rdfs:label>
  <rdfs:comment xml:lang="id">[Manajemen Posisi] Ukuran posisi maks (% modal) = risiko per transaksi (regime) / (2 × ATR%) × 100</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-01</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manajemen Posisi</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_POS_02">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#KandidatTopPickAdaptif"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#KandidatTopPickAdaptif"/>
              <swrl:argument1 rdf:resource="urn:swrl#b"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:IndividualPropertyAtom>
                  <swrl:propertyPredicate rdf:resource="#eksposurKomoditasPendapatan"/>
                  <swrl:argument1 rdf:resource="urn:swrl#a"/>
                  <swrl:argument2 rdf:resource="urn:swrl#k"/>
                </swrl:IndividualPropertyAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:IndividualPropertyAtom>
                      <swrl:propertyPredicate rdf:resource="#eksposurKomoditasPendapatan"/>
                      <swrl:argument1 rdf:resource="urn:swrl#b"/>
                      <swrl:argument2 rdf:resource="urn:swrl#k"/>
                    </swrl:IndividualPropertyAtom>
                  </rdf:first>
                  <rdf:rest>
                    <rdf:Description>
                      <rdf:first>
                        <swrl:DatavaluedPropertyAtom>
                          <swrl:propertyPredicate rdf:resource="#kodeSaham"/>
                          <swrl:argument1 rdf:resource="urn:swrl#a"/>
                          <swrl:argument2 rdf:resource="urn:swrl#x"/>
                        </swrl:DatavaluedPropertyAtom>
                      </rdf:first>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:first>
                            <swrl:DatavaluedPropertyAtom>
                              <swrl:propertyPredicate rdf:resource="#kodeSaham"/>
                              <swrl:argument1 rdf:resource="urn:swrl#b"/>
                              <swrl:argument2 rdf:resource="urn:swrl#y"/>
                            </swrl:DatavaluedPropertyAtom>
                          </rdf:first>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:first>
                                <swrl:BuiltinAtom>
                                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#notEqual"/>
                                  <swrl:arguments>
                                    <rdf:Description>
                                      <rdf:first rdf:resource="urn:swrl#x"/>
                                      <rdf:rest>
                                        <rdf:Description>
                                          <rdf:first rdf:resource="urn:swrl#y"/>
                                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                                        </rdf:Description>
                                      </rdf:rest>
                                    </rdf:Description>
                                  </swrl:arguments>
                                </swrl:BuiltinAtom>
                              </rdf:first>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </rdf:rest>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:IndividualPropertyAtom>
          <swrl:propertyPredicate rdf:resource="#terkonsentrasiDengan"/>
          <swrl:argument1 rdf:resource="urn:swrl#a"/>
          <swrl:argument2 rdf:resource="urn:swrl#b"/>
        </swrl:IndividualPropertyAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:ClassAtom>
              <swrl:classPredicate rdf:resource="#RisikoKonsentrasiTema"/>
              <swrl:argument1 rdf:resource="urn:swrl#a"/>
            </swrl:ClassAtom>
          </rdf:first>
          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-02</rdfs:label>
  <rdfs:comment xml:lang="id">[Manajemen Posisi] Konsentrasi tema: dua top pick adaptif berbagi komoditas pendapatan</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-02</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manajemen Posisi</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_KAT_01">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#Katalis"/>
          <swrl:argument1 rdf:resource="urn:swrl#k"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
            <swrl:DatavaluedPropertyAtom>
              <swrl:propertyPredicate rdf:resource="#hariMenujuKatalis"/>
              <swrl:argument1 rdf:resource="urn:swrl#k"/>
              <swrl:argument2 rdf:resource="urn:swrl#d"/>
            </swrl:DatavaluedPropertyAtom>
          </rdf:first>
          <rdf:rest>
            <rdf:Description>
              <rdf:first>
                <swrl:BuiltinAtom>
                  <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#greaterThanOrEqual"/>
                  <swrl:arguments>
                    <rdf:Description>
                      <rdf:first rdf:resource="urn:swrl#d"/>
                      <rdf:rest>
                        <rdf:Description>
                          <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                          <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</rdf:first>
                        </rdf:Description>
                      </rdf:rest>
                    </rdf:Description>
                  </swrl:arguments>
                </swrl:BuiltinAtom>
              </rdf:first>
              <rdf:rest>
                <rdf:Description>
                  <rdf:first>
                    <swrl:BuiltinAtom>
                      <swrl:builtin rdf:resource="http://www.w3.org/2003/11/swrlb#lessThanOrEqual"/>
                      <swrl:arguments>
                        <rdf:Description>
                          <rdf:first rdf:resource="urn:swrl#d"/>
                          <rdf:rest>
                            <rdf:Description>
                              <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                              <rdf:first rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">45</rdf:first>
                            </rdf:Description>
                          </rdf:rest>
                        </rdf:Description>
                      </swrl:arguments>
                    </swrl:BuiltinAtom>
                  </rdf:first>
                  <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
                </rdf:Description>
              </rdf:rest>
            </rdf:Description>
          </rdf:rest>
        </rdf:Description>
      </rdf:rest>
    </rdf:Description>
  </swrl:body>
  <swrl:head>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#KatalisDekat"/>
          <swrl:argument1 rdf:resource="urn:swrl#k"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    </rdf:Description>
  </swrl:head>
  <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAT-01</rdfs:label>
  <rdfs:comment xml:lang="id">[Katalis] Katalis dekat: 0-45 hari ke depan</rdfs:comment>
  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAT-01</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Katalis</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_KAT_02">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#KatalisDekat"/>
          <swrl:argument1 rdf:resource="urn:swrl#k"/>
        </swrl:ClassAtom>
      </rdf:first>
      <rdf:rest>
        <rdf:Description>
          <rdf:first>
