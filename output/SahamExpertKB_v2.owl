</owl:Class>

<owl:Class rdf:about="#AntisipasiTerpicu">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
  <rdfs:label xml:lang="id">Antisipasi Terpicu</rdfs:label>
  <rdfs:comment xml:lang="id">(Inferensi) kondisi pemicu reaction function terpenuhi.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#Katalis">
  <rdfs:subClassOf rdf:resource="#PenalaranPakar"/>
