<owl:Class rdf:about="#KatalisTerjadwal">
  <rdfs:subClassOf rdf:resource="#Katalis"/>
  <rdfs:label xml:lang="id">Katalis Terjadwal Rutin</rdfs:label>
  <rdfs:comment xml:lang="id">Rilis laporan keuangan, rebalancing indeks.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#KatalisDekat">
  <rdfs:subClassOf rdf:resource="#KategoriInferensi"/>
  <rdfs:label xml:lang="id">Katalis Dekat</rdfs:label>
  <rdfs:comment xml:lang="id">(Inferensi) katalis ≤ 45 hari ke depan.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#TesisInvestasi">
  <rdfs:subClassOf rdf:resource="#PenalaranPakar"/>
