  <rdfs:comment xml:lang="id">Emiten fiktif untuk pengujian aturan (validation &amp; verification), BUKAN saham nyata.</rdfs:comment>
</owl:Class>

<owl:Class rdf:about="#SinyalKetahananBeritaBuruk">
  <rdfs:subClassOf rdf:resource="#InferensiEmiten"/>
