  <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-06</kodeAturan>
  <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stakeholder</pilarAnalisis>
</swrl:Imp>

<swrl:Imp rdf:about="#Aturan_R_PRF_07">
  <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
  <swrl:body>
    <rdf:Description>
      <rdf:first>
        <swrl:ClassAtom>
          <swrl:classPredicate rdf:resource="#InvestorRitel"/>
