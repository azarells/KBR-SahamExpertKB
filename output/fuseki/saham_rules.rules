[R_POS_01: (?e rdf:type ex:Emiten) (?r rdf:type ex:RegimeAktif) (?r ex:risikoPerTransaksiPersen ?x) (?e ex:atrPersen ?a) product(?a, '2.0'^^xsd:double, ?d) quotient(?x, ?d, ?q) product(?q, '100.0'^^xsd:double, ?u) -> (?e ex:ukuranPosisiMaksPersen ?u)]

