[R_TES_03: (?t rdf:type ex:TesisInvestasi) (?t ex:indikatorKunciTesis ?i) (?i ex:nilaiIndikator ?v) (?t ex:ambangInvalidasiBawah ?b) ge(?v, ?b) (?t ex:ambangInvalidasiAtas ?a) le(?v, ?a) -> (?t rdf:type ex:TesisValid)]

# R-TES-04 | Tesis & Invalidasi | Buffer ke batas bawah (%)
[R_TES_04: (?t rdf:type ex:TesisInvestasi) (?t ex:indikatorKunciTesis ?i) (?i ex:nilaiIndikator ?v) (?t ex:ambangInvalidasiBawah ?b) greaterThan(?b, '0.0'^^xsd:double) difference(?v, ?b, ?d) quotient(?d, ?v, ?q) product(?q, '100.0'^^xsd:double, ?p) -> (?t ex:bufferBawahPersen ?p)]

# R-TES-05 | Tesis & Invalidasi | Buffer ke batas atas (%)
[R_TES_05: (?t rdf:type ex:TesisInvestasi) (?t ex:indikatorKunciTesis ?i) (?i ex:nilaiIndikator ?v) (?t ex:ambangInvalidasiAtas ?a) lessThan(?a, '100000000.0'^^xsd:double) difference(?a, ?v, ?d) quotient(?d, ?v, ?q) product(?q, '100.0'^^xsd:double, ?p) -> (?t ex:bufferAtasPersen ?p)]

# R-TES-06 | Tesis & Invalidasi | Tesis rapuh: buffer bawah < 10%
[R_TES_06: (?t rdf:type ex:TesisInvestasi) (?t ex:bufferBawahPersen ?p) lessThan(?p, '10.0'^^xsd:double) -> (?t rdf:type ex:TesisRapuh)]

# R-TES-07 | Tesis & Invalidasi | Tesis rapuh: buffer atas < 10%
[R_TES_07: (?t rdf:type ex:TesisInvestasi) (?t ex:bufferAtasPersen ?p) lessThan(?p, '10.0'^^xsd:double) -> (?t rdf:type ex:TesisRapuh)]

