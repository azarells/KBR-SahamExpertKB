[R_ADP_01a: (?e rdf:type ex:Emiten) (?e ex:skorAccDistBroker ?a) ge(?a, '20.0'^^xsd:double) (?e ex:kekuatanRelatifPersen ?r) ge(?r, '5.0'^^xsd:double) -> (?e ex:poinSmartMoney 2)]

# R-ADP-01b | Adaptif Regime | Poin smart money 1: akumulasi ≥ 20 tetapi belum mengungguli pasar
[R_ADP_01b: (?e rdf:type ex:Emiten) (?e ex:skorAccDistBroker ?a) ge(?a, '20.0'^^xsd:double) (?e ex:kekuatanRelatifPersen ?r) lessThan(?r, '5.0'^^xsd:double) -> (?e ex:poinSmartMoney 1)]

# R-ADP-01c | Adaptif Regime | Poin smart money 0: akumulasi < 20
[R_ADP_01c: (?e rdf:type ex:Emiten) (?e ex:skorAccDistBroker ?a) lessThan(?a, '20.0'^^xsd:double) -> (?e ex:poinSmartMoney 0)]

# R-ADP-02 | Adaptif Regime | SKOR ADAPTIF = Σ bobot(regime aktif) × pilar (9 pilar)
[R_ADP_02: (?e rdf:type ex:Emiten) (?r rdf:type ex:RegimeAktif) (?r ex:bobotFundamental ?w1) (?r ex:bobotValuasi ?w2) (?r ex:bobotTeknikal ?w3) (?r ex:bobotBandar ?w4) (?r ex:bobotSentimen ?w5) (?r ex:bobotSektor ?w6) (?r ex:bobotRisiko ?w7) (?r ex:bobotLikuiditas ?w8) (?r ex:bobotSmartMoney ?w9) (?e ex:skorFundamental ?v1) (?e ex:skorValuasi ?v2) (?e ex:skorTeknikal ?v3) (?e ex:skorBandar ?v4) (?e ex:skorSentimen ?v5) (?e ex:skorKontribusiSektorEV ?v6) (?e ex:penaltiRisiko ?v7) (?e ex:poinLikuiditas ?v8) (?e ex:poinSmartMoney ?v9) product(?w1, ?v1, ?m1) product(?w2, ?v2, ?m2) product(?w3, ?v3, ?m3) product(?w4, ?v4, ?m4) product(?w5, ?v5, ?m5) product(?w6, ?v6, ?m6) product(?w7, ?v7, ?m7) product(?w8, ?v8, ?m8) product(?w9, ?v9, ?m9) sum(?m1, ?m2, ?_t1) sum(?_t1, ?m3, ?_t2) sum(?_t2, ?m4, ?_t3) sum(?_t3, ?m5, ?_t4) sum(?_t4, ?m6, ?_t5) sum(?_t5, ?m7, ?_t6) sum(?_t6, ?m8, ?_t7) sum(?_t7, ?m9, ?s) -> (?e ex:skorAdaptifRegime ?s)]

# R-ADP-03 | Adaptif Regime | Top pick adaptif: skor adaptif ≥ ambang regime, sektor ekspektasi ≥ 2, penalti ≥ -1
[R_ADP_03: (?e rdf:type ex:Emiten) (?r rdf:type ex:RegimeAktif) (?r ex:ambangTopPickAdaptif ?t) (?e ex:skorAdaptifRegime ?s) ge(?s, ?t) (?e ex:skorKontribusiSektorEV ?c) ge(?c, 0) (?e ex:penaltiRisiko ?p) ge(?p, -1) (?e ex:termasukSektor ?sk) -> (?e rdf:type ex:KandidatTopPickAdaptif) (?sk ex:topPickAdaptifSektor ?e)]

