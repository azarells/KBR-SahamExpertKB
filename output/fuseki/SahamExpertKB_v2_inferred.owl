        <rdfs:comment xml:lang="id">[Sentimen] Poin sentimen emiten: skorSentimenEmiten ∈ [-inf, -0.3) → skorSentimen -2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_02 -->

