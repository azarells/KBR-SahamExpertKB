    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MACD -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MACD">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTren"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">MACD</rdfs:label>
        <rdfs:comment xml:lang="id">EMA12 - EMA26, signal EMA9; histogram &gt; 0 momentum naik.</rdfs:comment>
        <ambangBatas xml:lang="id">Histogram &gt; 0 bullish</ambangBatas>
