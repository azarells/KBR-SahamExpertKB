        <rdfs:comment xml:lang="id">Kekuatan relatif vs IHSG ≤ -5 pp.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Undervalued -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Undervalued">
