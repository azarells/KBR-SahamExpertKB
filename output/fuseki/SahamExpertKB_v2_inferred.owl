        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refleksivitas</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Refleksivitas] Berita buruk priced-in: sentimen negatif, mengungguli pasar, bandar akumulasi</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_REF_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_REF_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
