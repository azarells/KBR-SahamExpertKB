        <rdfs:comment xml:lang="id">[Stakeholder] Persona konservatif: akumulasi bertahap pada emiten berdividen</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_REF_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_REF_01">
