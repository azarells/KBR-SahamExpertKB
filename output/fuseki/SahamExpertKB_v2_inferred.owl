        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-TEK-02c</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Teknikal</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Teknikal] Poin RSI-14: rsi14 ∈ [40.0, 65.0) → poinRSI 2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_TEK_02d -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_TEK_02d">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
