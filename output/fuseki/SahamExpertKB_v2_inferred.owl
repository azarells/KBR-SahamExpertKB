        <rdfs:comment xml:lang="id">[Kualitas Data] Kandidat akumulasi bertahap berbasis data indikatif wajib diverifikasi</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_DAT_04 -->

