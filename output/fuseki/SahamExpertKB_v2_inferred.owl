        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">PER &lt; 0,85 × rata-rata PER 5 tahun.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Validator -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Validator">
