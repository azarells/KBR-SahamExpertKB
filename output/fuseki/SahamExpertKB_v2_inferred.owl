        <rdfs:label xml:lang="id">Kenaikan Premi Risiko Negara</rdfs:label>
        <rdfs:comment xml:lang="id">CDS ≥ 90 bps → asing mengurangi eksposur Indonesia.</rdfs:comment>
        <antisipasiMengaktifkan rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Mv_PremiRisikoNegaraNaik"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Antisipasi_StabilisasiPasar -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Antisipasi_StabilisasiPasar">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AntisipasiKebijakan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AntisipasiTerpicu"/>
