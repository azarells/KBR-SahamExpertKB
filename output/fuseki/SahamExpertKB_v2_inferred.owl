        <rdfs:comment xml:lang="id">[Bandarmology] Poin Acc/Dist broker: skorAccDistBroker ∈ [-10.0, 10.0) → poinAccDist 1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_01d -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_01d">
