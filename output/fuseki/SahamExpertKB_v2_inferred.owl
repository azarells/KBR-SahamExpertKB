        <rdfs:comment xml:lang="id">[Sentimen] Poin sentimen emiten: skorSentimenEmiten ∈ [0.1, 0.3) → skorSentimen 1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_01c -->

