        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdfs:comment xml:lang="id">Kategori hasil penalaran atas emiten.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiPasar -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiPasar">
        <rdfs:label xml:lang="id">Inferensi Level Pasar</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdfs:comment xml:lang="id">Kesimpulan atas keadaan pasar keseluruhan.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiSektor -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiSektor">
