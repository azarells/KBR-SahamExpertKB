        <rdfs:comment xml:lang="id">[Teknikal] Lonjakan volume ≥ 2× rata-rata</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_TEK_06 -->

