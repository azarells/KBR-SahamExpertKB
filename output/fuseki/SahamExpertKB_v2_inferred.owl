        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Day Trading</rdfs:label>
        <rdfs:comment xml:lang="id">Buka-tutup posisi dalam satu hari.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#DeathCross -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#DeathCross">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonsepTeknikal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Death Cross</rdfs:label>
        <rdfs:comment xml:lang="id">MA50 memotong MA200 dari atas.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#DebtToEBITDA -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#DebtToEBITDA">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioSolvabilitas"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Net Debt / EBITDA</rdfs:label>
        <ambangBatas xml:lang="id">&gt; 4x berisiko</ambangBatas>
        <interpretasi xml:lang="id">Lama pelunasan utang dari EBITDA.</interpretasi>
        <rdfs:comment xml:lang="id">Lama pelunasan utang dari EBITDA.</rdfs:comment>
        <rumus xml:lang="id">Utang bersih / EBITDA</rumus>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_CPI_US -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_CPI_US">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorEkonomiRiil"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">CPI/PCE Amerika Serikat</rdfs:label>
        <heuristikPakar xml:lang="id">Core PCE &gt; 3% → Fed sulit memangkas.</heuristikPakar>
        <rdfs:comment xml:lang="id">Inflasi AS; PCE adalah acuan The Fed.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_CadanganDevisa -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_CadanganDevisa">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorEkonomiRiil"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Cadangan Devisa</rdfs:label>
        <rdfs:comment xml:lang="id">Aset valas BI untuk stabilisasi rupiah.</rdfs:comment>
        <heuristikPakar xml:lang="id">Turun cepat = BI agresif intervensi.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_CarryTrade -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_CarryTrade">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMoneter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Carry Trade (Yen/USD)</rdfs:label>
        <rdfs:comment xml:lang="id">Meminjam mata uang berbunga rendah untuk aset berimbal tinggi.</rdfs:comment>
        <heuristikPakar xml:lang="id">Unwinding carry trade = risk-off mendadak di EM.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_DotPlot -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_DotPlot">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMoneter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">FOMC Dot Plot</rdfs:label>
        <heuristikPakar xml:lang="id">Median dot naik = hawkish.</heuristikPakar>
        <rdfs:comment xml:lang="id">Proyeksi suku bunga tiap anggota FOMC.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_FedFundsFutures -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_FedFundsFutures">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMoneter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Fed Funds Futures (CME FedWatch)</rdfs:label>
        <heuristikPakar xml:lang="id">Perubahan probabilitas &gt; 20 pp = repricing cepat.</heuristikPakar>
        <rdfs:comment xml:lang="id">Probabilitas pasar atas keputusan FOMC.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_HBA -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_HBA">
