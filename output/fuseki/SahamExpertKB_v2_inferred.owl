        <rdfs:comment xml:lang="id">Harga &gt; MA50 &gt; MA200.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TrenTurun -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TrenTurun">
