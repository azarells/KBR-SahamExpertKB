        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-03</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology] Skor bandarmology = acc/dist + asing (0-5)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_04 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_04">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-04</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-04</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology] Akumulasi bandar: Acc/Dist ≥ 20</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_05 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_05">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-05</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-05</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology] Distribusi bandar: Acc/Dist ≤ -20</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_06 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_06">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-06</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-06</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology] Smart money divergence: bandar akumulasi saat harga turun &amp; ritel jual (Wyckoff akumulasi)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_07 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_07">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-07</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-07</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology] Distribusi ke ritel: bandar jual, broker ritel net buy</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_08 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_08">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-08</rdfs:label>
