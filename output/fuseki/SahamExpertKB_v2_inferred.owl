        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-02c</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology] Poin net foreign 20 hari: netAsing20HariM ∈ [-50.0, 0.0) → poinAsing 0</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_02d -->

