        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sentimen</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Sentimen] Poin sentimen emiten: skorSentimenEmiten ∈ [0.3, +inf) → skorSentimen 2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_01b -->

