    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_05b">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
