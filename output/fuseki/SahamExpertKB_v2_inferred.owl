        <negaraAsal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Indonesia</negaraAsal>
        <memilikiKonstituen rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BBCA"/>
        <memilikiKonstituen rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BBRI"/>
        <memilikiKonstituen rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BMRI"/>
        <diterbitkanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Penyedia_FTSERussell"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FallingWedge -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FallingWedge">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaBullish"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaChart"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaReversal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Falling Wedge</rdfs:label>
        <rdfs:comment xml:lang="id">Baji menyempit turun; breakout ke atas.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FalseBreakout -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FalseBreakout">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonsepTeknikal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">False Breakout / Bull Trap</rdfs:label>
        <rdfs:comment xml:lang="id">Breakout gagal yang menjebak pembeli.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_EarlyCycle -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_EarlyCycle">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseSiklusEkonomi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Early Cycle (Pemulihan)</rdfs:label>
        <rdfs:comment xml:lang="id">Suku bunga turun, kredit pulih; unggul: keuangan, konsumer siklikal, properti, teknologi.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_LateCycle -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_LateCycle">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseSiklusEkonomi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Late Cycle (Overheating/Ketat)</rdfs:label>
        <rdfs:comment xml:lang="id">Inflasi &amp; bunga tinggi; unggul: energi, barang baku, kesehatan, konsumer primer.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_MidCycle -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_MidCycle">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseSiklusEkonomi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Mid Cycle (Ekspansi)</rdfs:label>
        <rdfs:comment xml:lang="id">Pertumbuhan stabil; unggul: teknologi, industri, barang baku.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_ResesiStagflasi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_ResesiStagflasi">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseSiklusEkonomi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Resesi / Stagflasi</rdfs:label>
        <rdfs:comment xml:lang="id">Pertumbuhan turun, risk-off; unggul: konsumer primer, kesehatan, infrastruktur/utilitas, emas.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FeeTransaksi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FeeTransaksi">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BiayaDanPajak"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Fee Broker</rdfs:label>
        <rdfs:comment xml:lang="id">Biaya beli (~0,15%) dan jual (~0,25%, termasuk pajak) tergantung sekuritas.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FibonacciRetracement -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FibonacciRetracement">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TeoriTeknikal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Fibonacci Retracement</rdfs:label>
        <rdfs:comment xml:lang="id">Level koreksi 23,6%, 38,2%, 50%, 61,8%, 78,6%.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FitchRatings -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FitchRatings">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EntitasPasarModal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Institusi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#LembagaPemeringkat"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#OrganisasiInternasional"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Fitch Ratings</rdfs:label>
        <rdfs:comment xml:lang="id">Lembaga pemeringkat.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ForeignInclusionFactor -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ForeignInclusionFactor">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Bandarmology"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonsepBandarmology"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Foreign Inclusion Factor (FIF)</rdfs:label>
        <rdfs:comment xml:lang="id">Faktor porsi saham yang dapat dibeli asing di indeks MSCI.</rdfs:comment>
        <heuristikPakar xml:lang="id">Freeze FIF oleh MSCI membatasi bobot Indonesia di portofolio global.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FraksiHarga -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FraksiHarga">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MekanismePerdagangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Fraksi Harga (Tick Size)</rdfs:label>
        <rdfs:comment xml:lang="id">Kelipatan perubahan harga: Rp1 (&lt;Rp200), Rp2 (Rp200-&lt;500), Rp5 (Rp500-&lt;2.000), Rp10 (Rp2.000-&lt;5.000), Rp25 (≥Rp5.000).</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FreeCashFlow -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FreeCashFlow">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioArusKas"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Free Cash Flow</rdfs:label>
        <rumus xml:lang="id">CFO - Capex</rumus>
        <interpretasi xml:lang="id">Kas bebas untuk dividen, buyback, bayar utang.</interpretasi>
        <rdfs:comment xml:lang="id">Kas bebas untuk dividen, buyback, bayar utang.</rdfs:comment>
        <ambangBatas xml:lang="id">Positif konsisten</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FreeFloat -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FreeFloat">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MekanismePerdagangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Free Float</rdfs:label>
        <rdfs:comment xml:lang="id">Porsi saham yang dimiliki publik (&lt;5%) dan dapat diperdagangkan bebas; dasar bobot indeks MSCI (Foreign Inclusion Factor).</rdfs:comment>
        <ambangBatas xml:lang="id">Rencana OJK/BEI 2026: minimum 15% (bertahap).</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FullCallAuction -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FullCallAuction">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MekanismePerdagangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Full Call Auction (FCA)</rdfs:label>
        <rdfs:comment xml:lang="id">Mekanisme lelang berkala untuk saham Papan Pemantauan Khusus; order book tidak transparan.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#GARP -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#GARP">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#GayaInvestasi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Growth at Reasonable Price</rdfs:label>
        <rdfs:comment xml:lang="id">Pertumbuhan dengan valuasi wajar; gunakan PEG &lt; 1.</rdfs:comment>
    </owl:Thing>
    


