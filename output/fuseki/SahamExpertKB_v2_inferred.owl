        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdfs:comment xml:lang="id">OBV, VWAP, MFI, Accumulation/Distribution, Volume Profile.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten">
