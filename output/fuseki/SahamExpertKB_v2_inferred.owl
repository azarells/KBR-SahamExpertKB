        <rdfs:comment xml:lang="id">Ada konflik sinyal antarpilar: tunda entry penuh.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#UnderperformPasar -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#UnderperformPasar">
