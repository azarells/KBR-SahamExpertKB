        <rdfs:comment xml:lang="id">[Sentimen] Sentimen positif ≥ 0,2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_03 -->

