        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiPasar"/>
        <rdfs:comment xml:lang="id">Kapitulasi + washout + premi risiko tinggi: peluang 1-3 th terbaik secara historis.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ZonaAman -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ZonaAman">
        <rdfs:label xml:lang="id">Zona Aman (Z ≥ 2,99)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Risiko kebangkrutan rendah.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ZonaDistress -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ZonaDistress">
