        <rdfs:comment xml:lang="id">[Valuasi Relatif Obligasi] 4 ≤ ERP &lt; 8 pp menarik</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ERP_04 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ERP_04">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ERP-04</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ERP-04</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Valuasi Relatif Obligasi</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Valuasi Relatif Obligasi] ERP &lt; 0: SBN lebih menarik</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_FUND_01a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_FUND_01a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
