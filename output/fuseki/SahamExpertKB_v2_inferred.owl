        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorEkonomiRiil"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Pertumbuhan PDB</rdfs:label>
        <heuristikPakar xml:lang="id">PDB melambat → konsumer non-primer &amp; properti tertekan.</heuristikPakar>
        <rdfs:comment xml:lang="id">Pertumbuhan output ekonomi riil (yoy).</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_PMI -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_PMI">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorEkonomiRiil"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">PMI Manufaktur</rdfs:label>
        <heuristikPakar xml:lang="id">PMI &lt; 50 beruntun → industri &amp; bahan baku melemah.</heuristikPakar>
        <rdfs:comment xml:lang="id">Purchasing Managers&apos; Index; &gt; 50 ekspansi.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_PenjualanMobil -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_PenjualanMobil">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
