        <rdfs:comment xml:lang="id">Order palsu besar untuk memengaruhi persepsi lalu dibatalkan.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaSpring -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaSpring">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Bandarmology"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaBandar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaBandarBullish"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Spring (Wyckoff)</rdfs:label>
        <rdfs:comment xml:lang="id">False breakdown di dasar akumulasi.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaUTAD -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaUTAD">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Bandarmology"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaBandar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaBandarBearish"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Upthrust After Distribution</rdfs:label>
        <rdfs:comment xml:lang="id">False breakout di puncak distribusi.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaWashTrade -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaWashTrade">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Bandarmology"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaBandar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaManipulatif"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Wash Trade</rdfs:label>
        <rdfs:comment xml:lang="id">Transaksi semu untuk menciptakan kesan likuid; dilarang UU Pasar Modal.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PositionSizing -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PositionSizing">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ManajemenRisiko"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Position Sizing</rdfs:label>
        <rumus xml:lang="id">Jumlah lembar = (Modal × %Risiko) / (Entry - SL)</rumus>
        <ambangBatas xml:lang="id">Risiko 1-2% modal per transaksi</ambangBatas>
        <rdfs:comment xml:lang="id">Ukuran posisi berdasar risiko per transaksi.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PositionTrading -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PositionTrading">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#GayaInvestasi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Position Trading</rdfs:label>
        <rdfs:comment xml:lang="id">Memegang berbulan-bulan mengikuti tren besar.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PraPembukaan -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PraPembukaan">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MekanismePerdagangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Pra-Pembukaan (Pre-opening)</rdfs:label>
        <rdfs:comment xml:lang="id">Periode pembentukan harga pembukaan melalui call auction.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PraPenutupan -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PraPenutupan">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MekanismePerdagangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Pra-Penutupan (Pre-closing)</rdfs:label>
        <heuristikPakar xml:lang="id">Lonjakan harga khusus di pre-closing berulang kali = indikasi &apos;window dressing&apos;/marking the close.</heuristikPakar>
        <rdfs:comment xml:lang="id">Periode pembentukan harga penutupan melalui call auction.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PrivatePlacement -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PrivatePlacement">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AksiKorporasi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AksiKorporasiNegatif"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Private Placement (PMTHMETD)</rdfs:label>
        <rdfs:comment xml:lang="id">Penambahan modal tanpa HMETD kepada investor tertentu; maks 10% dalam 2 tahun.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilAgresif -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilAgresif">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilRisiko"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Agresif</rdfs:label>
        <rdfs:comment xml:lang="id">Toleransi volatilitas tinggi, mengejar return tinggi/trading.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilKonservatif -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilKonservatif">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilRisiko"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Konservatif</rdfs:label>
        <rdfs:comment xml:lang="id">Mengutamakan keamanan modal &amp; dividen; toleransi drawdown rendah.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilModerat -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilModerat">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ProfilRisiko"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Moderat</rdfs:label>
        <rdfs:comment xml:lang="id">Seimbang antara pertumbuhan dan keamanan.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Pullback -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Pullback">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonsepTeknikal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Pullback</rdfs:label>
        <rdfs:comment xml:lang="id">Koreksi sementara dalam tren naik.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#QuickRatio -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#QuickRatio">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioLikuiditas"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Quick Ratio</rdfs:label>
        <rumus xml:lang="id">(Aset Lancar - Persediaan) / Liabilitas Lancar</rumus>
        <interpretasi xml:lang="id">Likuiditas tanpa persediaan.</interpretasi>
        <rdfs:comment xml:lang="id">Likuiditas tanpa persediaan.</rdfs:comment>
        <ambangBatas xml:lang="id">≥ 1</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ROA -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ROA">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioProfitabilitas"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Return on Assets</rdfs:label>
        <ambangBatas xml:lang="id">Bank ≥ 1,5% baik</ambangBatas>
        <rdfs:comment xml:lang="id">Efisiensi aset.</rdfs:comment>
        <interpretasi xml:lang="id">Efisiensi aset.</interpretasi>
        <rumus xml:lang="id">Laba Bersih / Total Aset</rumus>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ROE -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ROE">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioProfitabilitas"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Return on Equity</rdfs:label>
        <interpretasi xml:lang="id">Efisiensi modal pemegang saham; gunakan DuPont.</interpretasi>
        <rdfs:comment xml:lang="id">Efisiensi modal pemegang saham; gunakan DuPont.</rdfs:comment>
        <rumus xml:lang="id">Laba Bersih / Ekuitas</rumus>
        <ambangBatas xml:lang="id">≥ 15% sangat baik; 8-15% cukup</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ROIC -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ROIC">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioProfitabilitas"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Return on Invested Capital</rdfs:label>
        <rdfs:comment xml:lang="id">Kualitas penciptaan nilai; bandingkan dengan WACC.</rdfs:comment>
        <interpretasi xml:lang="id">Kualitas penciptaan nilai; bandingkan dengan WACC.</interpretasi>
        <rumus xml:lang="id">NOPAT / (Ekuitas + Utang berbunga)</rumus>
        <ambangBatas xml:lang="id">ROIC &gt; WACC</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RSI -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RSI">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMomentum"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Relative Strength Index (14)</rdfs:label>
        <rdfs:comment xml:lang="id">Osilator 0-100.</rdfs:comment>
        <ambangBatas xml:lang="id">≥ 70/75 overbought; &lt; 30 oversold; 40-65 sehat</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RUPS -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RUPS">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AksiKorporasi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AksiKorporasiNetral"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Rapat Umum Pemegang Saham</rdfs:label>
        <rdfs:comment xml:lang="id">Forum pengambilan keputusan tertinggi (RUPST/RUPSLB).</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RecencyBias -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RecencyBias">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BiasPerilaku"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Recency Bias</rdfs:label>
        <rdfs:comment xml:lang="id">Menganggap tren terbaru akan berlanjut selamanya.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RectangleRange -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RectangleRange">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaChart"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PolaKontinuasi"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Rectangle / Trading Range</rdfs:label>
        <rdfs:comment xml:lang="id">Harga bergerak di antara support-resistance datar.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Regime_KrisisLikuiditas -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Regime_KrisisLikuiditas">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RegimeAktif"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RegimePasar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Krisis Likuiditas / Kapitulasi</rdfs:label>
        <bobotSentimen rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</bobotSentimen>
        <risikoPerTransaksiPersen rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</risikoPerTransaksiPersen>
        <bobotTeknikal rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</bobotTeknikal>
        <bobotLikuiditas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotLikuiditas>
        <bobotBandar rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotBandar>
        <bobotSektor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotSektor>
        <bobotSmartMoney rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</bobotSmartMoney>
        <bobotValuasi rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</bobotValuasi>
        <bobotFundamental rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</bobotFundamental>
        <bobotRisiko rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.5</bobotRisiko>
        <ambangTopPickAdaptif rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">24.7</ambangTopPickAdaptif>
        <porsiTranche2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</porsiTranche2>
        <porsiTranche1 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</porsiTranche1>
        <porsiTranche3 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</porsiTranche3>
        <rdfs:comment xml:lang="id">Harga digerakkan penjualan paksa. Pakar: utamakan neraca kuat &amp; valuasi, ikuti jejak smart money, abaikan teknikal jangka pendek &amp; kebisingan sentimen, hukum berat neraca lemah, risiko per transaksi dipangkas setengah.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Regime_Netral -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Regime_Netral">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RegimePasar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Netral</rdfs:label>
        <bobotValuasi rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotValuasi>
        <bobotLikuiditas rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotLikuiditas>
        <bobotTeknikal rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotTeknikal>
        <bobotBandar rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotBandar>
        <bobotSentimen rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotSentimen>
        <risikoPerTransaksiPersen rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</risikoPerTransaksiPersen>
        <bobotFundamental rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotFundamental>
        <bobotSmartMoney rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotSmartMoney>
        <bobotSektor rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotSektor>
        <bobotRisiko rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.0</bobotRisiko>
        <porsiTranche3 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</porsiTranche3>
        <ambangTopPickAdaptif rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">22.75</ambangTopPickAdaptif>
        <porsiTranche2 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30</porsiTranche2>
        <porsiTranche1 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50</porsiTranche1>
