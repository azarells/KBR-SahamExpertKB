        <rdfs:comment xml:lang="id">[Rotasi Sektor] Skor rotasi bila skenario berada di Fase_LateCycle</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ROT_MidCycle -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ROT_MidCycle">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ROT-MidCycle</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ROT-MidCycle</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotasi Sektor</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Rotasi Sektor] Skor rotasi bila skenario berada di Fase_MidCycle</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ROT_ResesiStagflasi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ROT_ResesiStagflasi">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ROT-ResesiStagflasi</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ROT-ResesiStagflasi</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotasi Sektor</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Rotasi Sektor] Skor rotasi bila skenario berada di Fase_ResesiStagflasi</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_RS_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_RS_01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-RS-01</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-RS-01</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refleksivitas</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Refleksivitas] Kekuatan relatif = perubahan 20 hari − perubahan IHSG 1 bulan</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_RS_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_RS_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-RS-02</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-RS-02</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refleksivitas</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Refleksivitas] Mengungguli pasar ≥ +5 pp</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_RS_03 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_RS_03">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-RS-03</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-RS-03</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Refleksivitas</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Refleksivitas] Kalah dari pasar ≤ -5 pp</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_01a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_01a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-01a</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Makro-Geopolitik</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-01a</kodeAturan>
        <rdfs:comment xml:lang="id">[Makro-Geopolitik] Skor makro-geo bagian A = Σ sensitivitas × arah (faktor 1-6: energi, USD, suku bunga, inflasi, emas, logam/China)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_01b -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_01b">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-01b</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Makro-Geopolitik</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-01b</kodeAturan>
        <rdfs:comment xml:lang="id">[Makro-Geopolitik] Skor makro-geo bagian B = Σ sensitivitas × arah (faktor 7-12: risk-off, belanja pemerintah, daya beli, tarif, CPO, digital)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_01c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_01c">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-01c</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Makro-Geopolitik</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-01c</kodeAturan>
        <rdfs:comment xml:lang="id">[Makro-Geopolitik] Skor makro-geo = bagian A + bagian B (12 faktor)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-02</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-02</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Sektor] Rasio valuasi sektor = PER / PER 5 th</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03a</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03a</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Sektor] Skor valuasi sektor: rasioValuasiSektor ∈ [-inf, 0.6) → skorValuasiSektor 3 SektorMurahHistoris</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03b -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03b">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03b</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03b</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Sektor] Skor valuasi sektor: rasioValuasiSektor ∈ [0.6, 0.85) → skorValuasiSektor 2 SektorMurahHistoris</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03c">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03c</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03c</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Sektor] Skor valuasi sektor: rasioValuasiSektor ∈ [0.85, 1.1) → skorValuasiSektor 1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03d -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_03d">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03d</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-03d</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Sektor] Skor valuasi sektor: rasioValuasiSektor ∈ [1.1, +inf) → skorValuasiSektor 0</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_04 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_04">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-04</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-04</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tema Struktural</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Tema Struktural] Skor tema tertimbang = tema × 2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_05 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_05">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-05</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-05</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tema Struktural</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Tema Struktural] Sektor didukung tema (skor ≥ 2)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06a</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06a</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology-Sektor] Poin aliran asing sektor 3 bulan: aliranAsing3BulanT ∈ [1.0, +inf) → poinAliranAsing 2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06b -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06b">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06b</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06b</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology-Sektor] Poin aliran asing sektor 3 bulan: aliranAsing3BulanT ∈ [0.0, 1.0) → poinAliranAsing 1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06c">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06c</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06c</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology-Sektor] Poin aliran asing sektor 3 bulan: aliranAsing3BulanT ∈ [-5.0, 0.0) → poinAliranAsing 0</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06d -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_06d">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06d</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology-Sektor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-06d</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology-Sektor] Poin aliran asing sektor 3 bulan: aliranAsing3BulanT ∈ [-inf, -5.0) → poinAliranAsing -1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_07 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_07">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-07</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-07</kodeAturan>
        <rdfs:comment xml:lang="id">[Integrasi] SKOR OUTLOOK = makro-geo + valuasi + tema×2 + sentimen + aliran asing + rotasi</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08a</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08a</kodeAturan>
        <rdfs:comment xml:lang="id">[Integrasi] Kelas penilaian PenilaianBullishKuat</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08b -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08b">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08b</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08b</kodeAturan>
        <rdfs:comment xml:lang="id">[Integrasi] Kelas penilaian PenilaianBullishModerat</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08c">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08c</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08c</kodeAturan>
        <rdfs:comment xml:lang="id">[Integrasi] Kelas penilaian PenilaianNetral</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08d -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_08d">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08d</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Integrasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-08d</kodeAturan>
        <rdfs:comment xml:lang="id">[Integrasi] Kelas penilaian PenilaianBearish</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_09 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_09">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-09</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-09</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skenario</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Skenario] Penilaian di skenario aktif</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_10 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_10">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-10</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-10</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Skenario</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Skenario] Skor outlook sektor mengikuti skenario aktif</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_11 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_11">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-11</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEK-11</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Rotasi Sektor</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Rotasi Sektor] Sektor favorit fase siklus (rotasi ≥ 2 di skenario aktif)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_12a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEK_12a">
