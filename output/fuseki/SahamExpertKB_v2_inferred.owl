        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Likuiditas</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-EMT-02b</kodeAturan>
        <rdfs:comment xml:lang="id">[Likuiditas] Poin likuiditas (nilai transaksi harian): likuiditasHarianM ∈ [20.0, 100.0) → poinLikuiditas 1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_EMT_02c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_EMT_02c">
