    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H01_Petrodolar -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H01_Petrodolar">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Efek Petrodolar</rdfs:label>
        <rdfs:comment xml:lang="id">Minyak naik → surplus petrodolar &amp; USD kuat → dana asing keluar EM → IHSG tertekan, namun energi &amp; batu bara diuntungkan (substitusi energi).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H02_FedHawkish -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H02_FedHawkish">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Fed Hawkish → EM Tertekan</rdfs:label>
        <rdfs:comment xml:lang="id">Fed menaikkan/menahan bunga tinggi → yield UST naik → DXY menguat → rupiah melemah → asing jual big caps bank.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H03_RupiahLemah -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H03_RupiahLemah">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Rupiah Lemah</rdfs:label>
        <rdfs:comment xml:lang="id">Eksportir berbasis USD (batu bara, CPO, nikel, emas) untung; importir bahan baku (farmasi, pakan, gandum, elektronik) tertekan.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H04_SukuBungaBI -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H04_SukuBungaBI">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">BI Rate Naik</rdfs:label>
        <rdfs:comment xml:lang="id">Bunga naik → KPR &amp; kredit kendaraan melemah → properti &amp; otomotif tertekan; bank dengan CASA tinggi relatif tahan.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H05_Inflasi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H05_Inflasi">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Inflasi Pangan</rdfs:label>
        <rdfs:comment xml:lang="id">Inflasi pangan → daya beli turun → konsumer non-primer tertekan; produsen pangan dengan pricing power bertahan.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H06_RiskOffEmas -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H06_RiskOffEmas">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Risk-off → Emas</rdfs:label>
        <rdfs:comment xml:lang="id">Konflik &amp; ketidakpastian → safe haven emas → penambang emas (ANTM, MDKA, BRMS, AMMN via tembaga-emas) diuntungkan.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H07_MSCIFreeze -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H07_MSCIFreeze">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">MSCI Freeze</rdfs:label>
        <rdfs:comment xml:lang="id">Freeze FIF/ancaman reklasifikasi → dana pasif keluar dari konstituen MSCI (big caps) → diskon valuasi ekstrem → peluang 1-3 th bila reformasi diterima.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H08_ContrarianKrisis -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H08_ContrarianKrisis">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Kontrarian Krisis</rdfs:label>
        <rdfs:comment xml:lang="id">Pasar -40% dengan sektor di bawah 0,7× PER historis: emiten neraca kuat &amp; dividen tinggi historis memberi return terbaik 1-3 th (preseden 2008-09, 2020-21).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H09_SmartMoney -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H09_SmartMoney">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Smart Money Divergence</rdfs:label>
        <rdfs:comment xml:lang="id">Harga turun + ritel jual + broker asing/institusi akumulasi = fase akumulasi; jangan ikut panic selling.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H10_DistribusiBerita -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H10_DistribusiBerita">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Distribusi saat Berita Bagus</rdfs:label>
        <rdfs:comment xml:lang="id">Berita sangat positif + RSI tinggi + broker ritel net buy besar = distribusi; ambil untung.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H11_ValueTrap -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H11_ValueTrap">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Value Trap</rdfs:label>
        <rdfs:comment xml:lang="id">PER rendah tapi laba turun, utang tinggi, downtrend = murah karena memang buruk.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H12_KonfluensiPilar -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H12_KonfluensiPilar">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Konfluensi Multi-Pilar</rdfs:label>
        <rdfs:comment xml:lang="id">Keyakinan tinggi hanya bila ≥3 pilar (fundamental, teknikal, bandar, sentimen, makro-geopolitik) searah.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H13_PerangDagang -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H13_PerangDagang">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Perang Dagang AS-China</rdfs:label>
        <rdfs:comment xml:lang="id">Tarif → permintaan China melemah → logam industri &amp; batu bara tertekan; relokasi pabrik ke ASEAN positif kawasan industri.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H14_OPEC -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H14_OPEC">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Keputusan OPEC+</rdfs:label>
        <rdfs:comment xml:lang="id">Pemangkasan produksi → minyak naik; penambahan kuota → minyak turun (negatif MEDC, positif maskapai/logistik).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H15_BelanjaPemerintah -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H15_BelanjaPemerintah">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Belanja Pemerintah</rdfs:label>
        <rdfs:comment xml:lang="id">Program MBG → permintaan protein &amp; pangan → unggas (CPIN, JPFA) &amp; produsen pangan; batas: ruang fiskal &amp; twin deficit.</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PenjelasanEdukatif"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H16_RegimeAware -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H16_RegimeAware">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Sinyal yang sama bermakna berbeda per regime</rdfs:label>
        <rdfs:comment xml:lang="id">Saat krisis likuiditas, teknikal &amp; sentimen menyesatkan (semua saham di bawah MA200); bobot dipindah ke neraca, valuasi, dan jejak smart money (R-REG, R-ADP).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H17_PricedIn -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H17_PricedIn">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Berita buruk, harga tidak turun</rdfs:label>
        <rdfs:comment xml:lang="id">Bila berita negatif tidak lagi menekan harga dan bandar akumulasi, berita sudah priced-in (R-REF-01).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H18_SellTheNews -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H18_SellTheNews">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Berita bagus, harga tidak naik</rdfs:label>
        <rdfs:comment xml:lang="id">Berita positif + kalah dari pasar + distribusi = sell the news (R-REF-02).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H19_Kapitulasi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H19_Kapitulasi">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Kapitulasi &amp; akumulasi bertahap</rdfs:label>
        <rdfs:comment xml:lang="id">Hari crash ≥10% + drawdown ≥40% + breadth washout = zona akumulasi generasional; beli 3 tranche, bukan sekaligus (R-PAS, R-KAP).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H20_RevisiLaba -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H20_RevisiLaba">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Ikuti arah revisi, bukan level</rdfs:label>
        <rdfs:comment xml:lang="id">Pasar membayar perubahan ekspektasi; revisi naik + harga tertinggal = celah ekspektasi (R-REV).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H21_ReactionFunction -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H21_ReactionFunction">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Antisipasi reaksi otoritas</rdfs:label>
        <rdfs:comment xml:lang="id">Rupiah lemah + inflasi naik → BI naik pre-emptif; Brent &gt;100 → risiko penyesuaian BBM; drawdown dalam → stabilisasi pasar (R-ANT).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H22_ERP -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H22_ERP">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Bandingkan dengan obligasi</rdfs:label>
        <rdfs:comment xml:lang="id">Earnings yield − yield SBN: ERP tinggi berarti saham murah relatif aset bebas risiko domestik (R-ERP).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H23_Robustness -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H23_Robustness">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Pilih posisi yang tahan banyak skenario</rdfs:label>
        <rdfs:comment xml:lang="id">Utamakan sektor robust lintas skenario; ambil taruhan asimetris bila upside ≥ 1,5× downside (R-ROB).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H24_Konfluensi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H24_Konfluensi">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Keyakinan dari konfluensi, kehati-hatian dari konflik</rdfs:label>
        <rdfs:comment xml:lang="id">≥5 pilar searah = keyakinan; fundamental vs bandar bertentangan = tunggu konfirmasi (R-KON).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H25_Sizing -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H25_Sizing">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Ukuran posisi dari risiko, bukan keyakinan</rdfs:label>
        <rdfs:comment xml:lang="id">Ukuran = risiko per transaksi / jarak stop (2×ATR); risiko dipangkas di regime krisis (R-POS).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H26_KillSwitch -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H26_KillSwitch">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Setiap tesis punya kriteria gugur</rdfs:label>
        <rdfs:comment xml:lang="id">Tetapkan indikator kunci &amp; ambang invalidasi sebelum masuk; buffer &lt; 10% = tesis rapuh (R-TES).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H27_KatalisBiner -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H27_KatalisBiner">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Jangan full position sebelum katalis biner</rdfs:label>
        <rdfs:comment xml:lang="id">FOMC, review MSCI, pemilu: masuk bertahap dan sisakan kas (R-KAT).</rdfs:comment>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_PrediksiSektor"/>
        <heuristikDigunakanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Output_SinyalQuantTrade"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H28_Governance -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#H28_Governance">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AturanPakar"/>
