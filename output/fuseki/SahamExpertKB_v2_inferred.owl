        <rdfs:comment xml:lang="id">[Robustness Skenario] Kontribusi sektor berbasis ekspektasi probabilistik = -3</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ROT_EarlyCycle -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ROT_EarlyCycle">
