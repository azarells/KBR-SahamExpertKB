        <rdfs:comment xml:lang="id">[Bandarmology] Poin Acc/Dist broker: skorAccDistBroker ∈ [30.0, +inf) → poinAccDist 3</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_01b -->

