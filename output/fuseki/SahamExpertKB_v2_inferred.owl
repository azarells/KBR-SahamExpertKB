    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TahapanIPO -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TahapanIPO">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InstrumenPasarModal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Tahapan IPO</rdfs:label>
        <rdfs:comment xml:lang="id">Pra-efektif → bookbuilding → efektif OJK → penawaran umum (e-IPO) → penjatahan → pencatatan di BEI.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TakeProfit -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TakeProfit">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ManajemenRisiko"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Take Profit</rdfs:label>
        <rumus xml:lang="id">TP = Entry + 3 × ATR (aturan sistem)</rumus>
