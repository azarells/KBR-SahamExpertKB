    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseAkumulasiWyckoff -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseAkumulasiWyckoff">
