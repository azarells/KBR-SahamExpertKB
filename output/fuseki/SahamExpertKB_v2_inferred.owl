        <rdfs:label xml:lang="id">Bear Case: Stagflasi &amp; Reklasifikasi</rdfs:label>
        <arahLogamChina rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</arahLogamChina>
        <arahDayaBeli rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-2</arahDayaBeli>
