        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Stakeholder</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Stakeholder] Persona moderat: top pick adaptif tanpa konflik</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_09 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_09">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
