        <rdfs:comment xml:lang="id">[Stakeholder] Rekomendasi scalper intraday</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_08 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_08">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
