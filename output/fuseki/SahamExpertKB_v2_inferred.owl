        <rdfs:label xml:lang="id">Bullish Engulfing</rdfs:label>
        <rdfs:comment xml:lang="id">Lilin hijau menelan lilin merah sebelumnya.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BullishHarami -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BullishHarami">
