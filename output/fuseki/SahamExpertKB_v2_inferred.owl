        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-08</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology-Wyckoff] Fase akumulasi: akumulasi di bawah MA200</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_09 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_09">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-09</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Bandarmology-Wyckoff</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-09</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology-Wyckoff] Fase mark-up: akumulasi + di atas MA200 + MA50 &gt; MA200</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_10 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_10">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-10</rdfs:label>
