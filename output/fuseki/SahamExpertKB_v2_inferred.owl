    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RevenueGrowth -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RevenueGrowth">
