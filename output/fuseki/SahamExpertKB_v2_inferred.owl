    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#UnusualMarketActivity -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#UnusualMarketActivity">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#StatusPengawasan"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Unusual Market Activity (UMA)</rdfs:label>
        <rdfs:comment xml:lang="id">Pengumuman bursa atas pergerakan harga/volume tidak wajar.</rdfs:comment>
        <heuristikPakar xml:lang="id">UMA setelah reli tajam sering diikuti profit taking; UMA bukan larangan beli.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#VIX -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#VIX">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EntitasPasarModal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndeksGlobal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndeksSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorRisikoGlobal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">CBOE Volatility Index (VIX)</rdfs:label>
        <negaraAsal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Amerika Serikat</negaraAsal>
        <kodeIndeks rdf:datatype="http://www.w3.org/2001/XMLSchema#string">VIX</kodeIndeks>
        <rdfs:comment xml:lang="id">&apos;Indeks ketakutan&apos;; &gt; 30 = risk-off tajam.</rdfs:comment>
        <memengaruhiIndeks rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IHSG"/>
        <diterbitkanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Penyedia_CBOE"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#VWAP -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#VWAP">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorVolume"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Volume Weighted Average Price</rdfs:label>
        <ambangBatas xml:lang="id">Di atas VWAP = pembeli dominan</ambangBatas>
        <rdfs:comment xml:lang="id">Harga rata-rata tertimbang volume intraday; acuan scalper &amp; institusi.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ValuasiRelatif -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ValuasiRelatif">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MetodeValuasi"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Valuasi Relatif (PER Band)</rdfs:label>
        <rumus xml:lang="id">Fair Value = EPS × PER_5th (dipakai aturan R-VAL-05)</rumus>
        <rdfs:comment xml:lang="id">Nilai wajar = EPS × PER rata-rata historis/peers.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ValueInvesting -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ValueInvesting">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#GayaInvestasi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Value Investing</rdfs:label>
        <rdfs:comment xml:lang="id">Membeli saham di bawah nilai intrinsik dengan margin of safety (Graham, Buffett).</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#VolumeProfile -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#VolumeProfile">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorVolume"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Volume Profile</rdfs:label>
        <rdfs:comment xml:lang="id">Distribusi volume per harga (POC, value area).</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#WalkForwardBacktest -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#WalkForwardBacktest">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisSentimen"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomponenML"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Backtest Walk-Forward</rdfs:label>
        <rdfs:comment xml:lang="id">Evaluasi rolling: kalibrasi di jendela t, uji di t+1, terhadap baseline IHSG/LQ45.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Waran -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Waran">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InstrumenPasarModal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Waran</rdfs:label>
        <rdfs:comment xml:lang="id">Hak membeli saham baru pada harga dan periode tertentu; biasanya pemanis IPO/right issue.</rdfs:comment>
        <heuristikPakar xml:lang="id">Waran deep out-of-the-money mendekati jatuh tempo bernilai ~0; jangan dikoleksi sebagai investasi.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#WilliamsR -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#WilliamsR">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMomentum"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Williams %R</rdfs:label>
        <rdfs:comment xml:lang="id">Osilator momentum.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#WyckoffMethod -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#WyckoffMethod">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisTeknikal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#TeoriTeknikal"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Metode Wyckoff</rdfs:label>
        <rdfs:comment xml:lang="id">Composite Man, hukum supply-demand, cause-effect, effort-result.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_Akumulasi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_Akumulasi">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseWyckoff"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#SiklusPasar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Wyckoff: Akumulasi</rdfs:label>
        <rdfs:comment xml:lang="id">Bandar mengumpulkan barang di area bawah setelah downtrend; volume naik di support, harga sideways.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_Distribusi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_Distribusi">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseWyckoff"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#SiklusPasar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Wyckoff: Distribusi</rdfs:label>
        <rdfs:comment xml:lang="id">Bandar melepas barang ke ritel di area atas.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_MarkDown -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_MarkDown">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseWyckoff"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#SiklusPasar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Wyckoff: Mark-Down</rdfs:label>
        <rdfs:comment xml:lang="id">Harga turun setelah distribusi selesai.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_MarkUp -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Wyckoff_MarkUp">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#FaseWyckoff"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#SiklusPasar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Wyckoff: Mark-Up</rdfs:label>
        <rdfs:comment xml:lang="id">Harga dinaikkan setelah barang terkumpul; breakout resistance.</rdfs:comment>
    </owl:Thing>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // General axioms
    //
