        <rdfs:comment xml:lang="id">[Bandarmology] Poin net foreign 20 hari: netAsing20HariM ∈ [0.0, 50.0) → poinAsing 1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_02c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_02c">
