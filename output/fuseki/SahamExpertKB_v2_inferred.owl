        <arahEmas rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arahEmas>
        <arahSukuBunga rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arahSukuBunga>
        <arahRiskOff rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arahRiskOff>
        <cbrUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrUSD>
        <arahInflasi rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arahInflasi>
        <arahTarif rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arahTarif>
        <cbrFed rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrFed>
        <cbrRiskOff rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrRiskOff>
        <cbrMinyak rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrMinyak>
        <arahUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arahUSD>
        <arahEnergi rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</arahEnergi>
        <cbrInflasi rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrInflasi>
