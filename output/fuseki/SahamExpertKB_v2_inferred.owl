        <rdfs:comment xml:lang="id">[Stakeholder] Rekomendasi persona moderat (hanya sektor bullish)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_06 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_06">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-06</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-06</kodeAturan>
