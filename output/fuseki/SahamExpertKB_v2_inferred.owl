    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Skenario_Base_2027_2028 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Skenario_Base_2027_2028">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Skenario"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#SkenarioAktif"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Base Case 2027-2028: Normalisasi Bertahap</rdfs:label>
        <arahDayaBeli rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">-1</arahDayaBeli>
        <arahLogamChina rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</arahLogamChina>
        <probabilitasSkenario rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.5</probabilitasSkenario>
        <arahInflasi rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahInflasi>
        <arahUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahUSD>
        <arahCPO rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahCPO>
        <arahEnergi rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahEnergi>
        <arahSukuBunga rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahSukuBunga>
        <arahEmas rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahEmas>
        <arahDigital rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahDigital>
        <cbrKomoditas rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cbrKomoditas>
        <arahBelanjaPemerintah rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahBelanjaPemerintah>
        <cbrInflasi rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</cbrInflasi>
        <arahRiskOff rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahRiskOff>
        <statusAktif rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</statusAktif>
        <arahTarif rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</arahTarif>
        <cbrFed rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrFed>
        <cbrMinyak rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrMinyak>
        <cbrRiskOff rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrRiskOff>
        <cbrUSD rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</cbrUSD>
        <rdfs:comment xml:lang="id">Premi risiko Timur Tengah bertahan namun minyak menormal ke US$80-90; Fed (sudah naik ke 4%) tahan tinggi lalu turun 2027; rupiah lemah; konsultasi MSCI standalone berlarut hingga Jun 2027; emas kuat tetapi tertahan kenaikan Fed (arah +1).</rdfs:comment>
        <faseSiklus rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Fase_LateCycle"/>
        <analogDengan rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Kasus_FedHike_PerangDagang_2018"/>
        <analogDengan rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Kasus_Supercycle_2022"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Skenario_Bear_Stagflasi -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Skenario_Bear_Stagflasi">
