        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Risiko kebangkrutan tinggi dalam 1-2 tahun.</rdfs:comment>
    </owl:Class>
    


