        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdfs:comment xml:lang="id">Kategori hasil penalaran atas sektor.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Institusi -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Institusi">
        <rdfs:label xml:lang="id">Institusi / Otoritas</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EntitasPasarModal"/>
        <rdfs:comment xml:lang="id">Regulator, bank sentral, SRO, lembaga statistik, organisasi internasional.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InstrumenPasarModal -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InstrumenPasarModal">
        <rdfs:label xml:lang="id">Instrumen Pasar Modal</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdfs:comment xml:lang="id">Jenis efek yang diperdagangkan.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InvestorRitel -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InvestorRitel">
        <rdfs:label xml:lang="id">Investor Ritel (Persona)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EndUser"/>
        <rdfs:comment xml:lang="id">Persona pengguna akhir dengan profil risiko &amp; horizon.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatAkumulasiBertahap -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatAkumulasiBertahap">
        <rdfs:label xml:lang="id">Kandidat Akumulasi Bertahap</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Saat kapitulasi: kualitas + murah + jejak akumulasi → beli 3 tranche.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatTopPick -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatTopPick">
        <rdfs:label xml:lang="id">Kandidat Top Pick</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Skor total ≥ 22 di sektor bullish.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatTopPickAdaptif -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatTopPickAdaptif">
        <rdfs:label xml:lang="id">Top Pick Adaptif-Regime</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Skor terbobot regime ≥ ambang regime &amp; sektor ber-ekspektasi ≥ 2.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatWatchlist -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KandidatWatchlist">
        <rdfs:label xml:lang="id">Watchlist</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Skor total 17-21 di sektor bullish.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KapitulasiEmiten -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KapitulasiEmiten">
        <rdfs:label xml:lang="id">Kapitulasi Emiten</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Volume ≥ 1,8×, RSI &lt; 35, turun ≥ 15% sebulan.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KapitulasiPasar -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KapitulasiPasar">
        <rdfs:label xml:lang="id">Kapitulasi Pasar</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiPasar"/>
        <rdfs:comment xml:lang="id">Drawdown ≥ 40% + hari crash ≥ 10%: penjualan paksa/panik selesai sebagian.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Katalis -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Katalis">
        <rdfs:label xml:lang="id">Katalis Terjadwal</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdfs:comment xml:lang="id">Peristiwa terjadwal yang dapat menggerakkan harga.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisBiner -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisBiner">
        <rdfs:label xml:lang="id">Katalis Biner</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Katalis"/>
        <rdfs:comment xml:lang="id">Hasil dua arah dengan dampak besar (FOMC, MSCI, pemilu).</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisDekat -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisDekat">
        <rdfs:label xml:lang="id">Katalis Dekat</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdfs:comment xml:lang="id">(Inferensi) katalis ≤ 45 hari ke depan.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisMusiman -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisMusiman">
        <rdfs:label xml:lang="id">Katalis Musiman</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Katalis"/>
        <rdfs:comment xml:lang="id">Pola kalender (window dressing, Ramadan-Lebaran, musim dividen).</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisTerjadwal -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KatalisTerjadwal">
        <rdfs:label xml:lang="id">Katalis Terjadwal Rutin</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Katalis"/>
        <rdfs:comment xml:lang="id">Rilis laporan keuangan, rebalancing indeks.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi">
        <rdfs:label xml:lang="id">Kategori Hasil Inferensi</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="id">Kelas-kelas yang keanggotaannya diturunkan oleh aturan SWRL (bukan diisi manual).</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriSentimen -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriSentimen">
        <rdfs:label xml:lang="id">Kategori Sentimen</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisSentimen"/>
        <rdfs:comment xml:lang="id">Positif, Netral, Negatif.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KebijakanDagangTarif -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KebijakanDagangTarif">
        <rdfs:label xml:lang="id">Kebijakan Dagang &amp; Tarif</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PeristiwaGeopolitik"/>
        <rdfs:comment xml:lang="id">Tarif, sanksi, perang dagang.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KebijakanDomestik -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KebijakanDomestik">
        <rdfs:label xml:lang="id">Kebijakan Domestik Indonesia</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PeristiwaGeopolitik"/>
        <rdfs:comment xml:lang="id">Program pemerintah, regulasi OJK/BEI, fiskal.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KebijakanMoneter -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KebijakanMoneter">
        <rdfs:label xml:lang="id">Keputusan Kebijakan Moneter</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PeristiwaGeopolitik"/>
        <rdfs:comment xml:lang="id">Keputusan The Fed (FOMC), BI (RDG), bank sentral lain.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeluaranSistem -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeluaranSistem">
