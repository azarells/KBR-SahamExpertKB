    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_05c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_05c">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEN-05c</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEN-05c</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sentimen</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Sentimen] Poin sentimen sektor: skorSentimenSektor ∈ [-0.1, 0.1) → poinSentimenSektor 0</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_05d -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_SEN_05d">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEN-05d</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-SEN-05d</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Sentimen</pilarAnalisis>
