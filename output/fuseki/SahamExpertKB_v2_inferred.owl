        <rdfs:comment xml:lang="id">Lilin hijau tanpa ekor; dominasi pembeli penuh.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Buyback -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Buyback">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AksiKorporasi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AksiKorporasiPositif"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Pembelian Kembali Saham (Buyback)</rdfs:label>
        <heuristikPakar xml:lang="id">Buyback saat krisis pasar (OJK mengizinkan tanpa RUPS dalam kondisi berfluktuasi signifikan) adalah sinyal kuat.</heuristikPakar>
        <rdfs:comment xml:lang="id">Emiten membeli sahamnya sendiri; sinyal manajemen menilai harga undervalued.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CAC40 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CAC40">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EntitasPasarModal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndeksEropa"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndeksGlobal"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndeksSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">CAC 40</rdfs:label>
        <jumlahKonstituen rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">40</jumlahKonstituen>
        <kodeIndeks rdf:datatype="http://www.w3.org/2001/XMLSchema#string">CAC40</kodeIndeks>
        <negaraAsal rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Prancis</negaraAsal>
        <diterbitkanOleh rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Penyedia_Euronext"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CALK -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CALK">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#LaporanKeuangan"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Catatan atas Laporan Keuangan</rdfs:label>
        <rdfs:comment xml:lang="id">Rincian kebijakan akuntansi, kontinjensi, transaksi pihak berelasi.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CAR -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CAR">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioPerbankan"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Capital Adequacy Ratio</rdfs:label>
        <rdfs:comment xml:lang="id">Kecukupan modal bank.</rdfs:comment>
        <interpretasi xml:lang="id">Kecukupan modal bank.</interpretasi>
        <rumus xml:lang="id">Modal / ATMR</rumus>
        <ambangBatas xml:lang="id">≥ 20% kuat; &lt; 12% lemah</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CASA -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CASA">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioKeuangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RasioPerbankan"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">CASA Ratio</rdfs:label>
        <rumus xml:lang="id">(Giro + Tabungan) / DPK</rumus>
        <rdfs:comment xml:lang="id">Dana murah; tinggi = biaya dana rendah.</rdfs:comment>
        <interpretasi xml:lang="id">Dana murah; tinggi = biaya dana rendah.</interpretasi>
        <ambangBatas xml:lang="id">≥ 70% sangat baik</ambangBatas>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CCI -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#CCI">
