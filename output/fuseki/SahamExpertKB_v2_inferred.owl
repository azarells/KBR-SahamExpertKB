        <rdfs:comment xml:lang="id">[Bandarmology] Poin Acc/Dist broker: skorAccDistBroker ∈ [-inf, -10.0) → poinAccDist 0</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_02a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_02a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
