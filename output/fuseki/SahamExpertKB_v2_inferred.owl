        <rdfs:comment xml:lang="id">[Likuiditas] Poin likuiditas (nilai transaksi harian): likuiditasHarianM ∈ [100.0, +inf) → poinLikuiditas 2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_EMT_02b -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_EMT_02b">
