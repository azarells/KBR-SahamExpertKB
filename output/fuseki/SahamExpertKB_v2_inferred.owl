        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tata Kelola</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Tata Kelola] Free float &lt; 15% → risiko HSC/dikeluarkan indeks</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_GOV_02 -->

