        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Murah tetapi fundamental lemah &amp; downtrend - jebakan bagi pemula.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ZonaAbuAbu -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ZonaAbuAbu">
        <rdfs:label xml:lang="id">Zona Abu-abu (1,81 ≤ Z &lt; 2,99)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Perlu pemantauan.</rdfs:comment>
    </owl:Class>
    


