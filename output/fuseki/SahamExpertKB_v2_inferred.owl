        <rdfs:comment xml:lang="id">Pasar naik ≥20% dari titik terendah dengan higher high-higher low.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BullishDivergence -->

