        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdfs:comment xml:lang="id">MA, EMA, MACD, ADX, Ichimoku, Parabolic SAR.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorVolatilitas -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorVolatilitas">
        <rdfs:label xml:lang="id">Indikator Volatilitas</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorTeknikal"/>
        <rdfs:comment xml:lang="id">Bollinger Bands, ATR, Keltner Channel.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorVolume -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorVolume">
