        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Emiten"/>
        <rdfs:comment xml:lang="id">Emiten bank; dinilai dengan rasio khusus perbankan (NPL, CAR, NIM, LDR).</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EmitenSyariah -->

