    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KON_12 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KON_12">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KON-12</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Konflik Sinyal</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KON-12</kodeAturan>
        <rdfs:comment xml:lang="id">[Konflik Sinyal] Sentimen positif tetapi bandar distribusi</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KON_13 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KON_13">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KON-13</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Konflik Sinyal</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KON-13</kodeAturan>
        <rdfs:comment xml:lang="id">[Konflik Sinyal] Murah karena laba turun → tunggu</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_00 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_00">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-00</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-00</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Regime Pasar</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Regime Pasar] Kondisi pasar aktif (statusAktifKondisi = 1)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-01</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-01</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Struktur Pasar</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Struktur Pasar] Premi risiko negara tinggi: CDS ≥ 90 bps</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-02</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-02</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Struktur Pasar</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Struktur Pasar] Breadth washout: &lt; 25% saham di atas MA200</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_03 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_03">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-03</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-03</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Struktur Pasar</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Struktur Pasar] Kapitulasi pasar: drawdown ≤ -40% &amp; hari crash ≤ -10%</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_04 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_04">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-04</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-04</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Struktur Pasar</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Struktur Pasar] Zona akumulasi generasional: kapitulasi + washout + premi risiko tinggi</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_05 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_05">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-05</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermarket</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-05</kodeAturan>
        <rdfs:comment xml:lang="id">[Intermarket] Dasar belum terkonfirmasi: CDS &amp; rupiah masih memburuk</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_06 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_06">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-06</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Intermarket</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-06</kodeAturan>
        <rdfs:comment xml:lang="id">[Intermarket] Divergensi intermarket bullish: CDS &amp; rupiah membaik saat IHSG masih turun</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_07 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_07">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-07</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-07</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Struktur Pasar</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Struktur Pasar] Zona akumulasi tetapi dasar belum terkonfirmasi → akumulasi bertahap</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_08 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PAS_08">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-08</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PAS-08</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Struktur Pasar</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Struktur Pasar] Kapitulasi + divergensi intermarket → akumulasi bertahap</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_POS_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_POS_01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-01</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manajemen Posisi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-01</kodeAturan>
        <rdfs:comment xml:lang="id">[Manajemen Posisi] Ukuran posisi maks (% modal) = risiko per transaksi (regime) / (2 × ATR%) × 100</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_POS_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_POS_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-02</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Manajemen Posisi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-POS-02</kodeAturan>
        <rdfs:comment xml:lang="id">[Manajemen Posisi] Konsentrasi tema: dua top pick adaptif berbagi komoditas pendapatan</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-01</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Profil Investor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-01</kodeAturan>
        <rdfs:comment xml:lang="id">[Profil Investor] Cocok konservatif: fundamental kuat, tanpa penalti, yield ≥ 5%, likuid</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-02</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Profil Investor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-02</kodeAturan>
        <rdfs:comment xml:lang="id">[Profil Investor] Cocok moderat: skor total ≥ 20, fundamental ≥ 5, penalti ≥ -1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_03 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_03">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-03</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Profil Investor</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-PRF-03</kodeAturan>
        <rdfs:comment xml:lang="id">[Profil Investor] Cocok agresif: teknikal ≥ 5 &amp; bandar ≥ 3</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_04 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_PRF_04">
