    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-01</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kapitulasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-01</kodeAturan>
        <rdfs:comment xml:lang="id">[Kapitulasi] Kapitulasi emiten: volume ≥ 1,8×, RSI &lt; 35, turun ≥ 15% sebulan</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-02</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kapitulasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-02</kodeAturan>
        <rdfs:comment xml:lang="id">[Kapitulasi] Akumulasi bertahap: strategi pasar bertahap + kualitas + murah + tanpa penalti + kapitulasi emiten</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_03 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_03">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-03</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kapitulasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-03</kodeAturan>
        <rdfs:comment xml:lang="id">[Kapitulasi] Akumulasi bertahap: strategi pasar bertahap + kualitas + murah + tanpa penalti + akumulasi bandar di bawah MA200 (beaten-down quality)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_04 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAP_04">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-04</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Kapitulasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-KAP-04</kodeAturan>
        <rdfs:comment xml:lang="id">[Kapitulasi] Tangga harga tranche: T1 = harga, T2 = harga − 2×ATR, T3 = harga − 4×ATR</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAT_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_KAT_01">
