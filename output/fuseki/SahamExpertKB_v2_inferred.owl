        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-BDR-01b</kodeAturan>
        <rdfs:comment xml:lang="id">[Bandarmology] Poin Acc/Dist broker: skorAccDistBroker ∈ [10.0, 30.0) → poinAccDist 2</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_01c -->

