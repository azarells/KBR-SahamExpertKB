        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMoneter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Quantitative Tightening / Easing</rdfs:label>
        <rdfs:comment xml:lang="id">Pengurangan/penambahan neraca bank sentral.</rdfs:comment>
        <heuristikPakar xml:lang="id">QT menyedot likuiditas global.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_TransaksiBerjalan -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_TransaksiBerjalan">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorEkonomiRiil"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Neraca Transaksi Berjalan</rdfs:label>
        <rdfs:comment xml:lang="id">Current account: perdagangan barang-jasa, pendapatan primer &amp; sekunder.</rdfs:comment>
        <heuristikPakar xml:lang="id">Defisit membesar + defisit finansial = twin deficit → rupiah rentan.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_YieldSBN10Y -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_YieldSBN10Y">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMoneter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Yield SBN 10 Tahun</rdfs:label>
        <rdfs:comment xml:lang="id">Imbal hasil obligasi pemerintah acuan.</rdfs:comment>
        <heuristikPakar xml:lang="id">Yield naik → cost of equity naik → PER wajar turun.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_YieldUST10Y -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_YieldUST10Y">
