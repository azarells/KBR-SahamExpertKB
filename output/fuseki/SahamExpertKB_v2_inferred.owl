        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-GOV-06</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-GOV-06</kodeAturan>
