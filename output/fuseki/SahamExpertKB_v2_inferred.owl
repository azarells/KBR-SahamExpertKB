        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment xml:lang="id">Jenis output yang dihasilkan sistem pakar.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeputusanOPEC -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeputusanOPEC">
        <rdfs:label xml:lang="id">Keputusan OPEC+</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PeristiwaGeopolitik"/>
        <rdfs:comment xml:lang="id">Keputusan kuota produksi minyak.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeputusanPenyediaIndeks -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeputusanPenyediaIndeks">
        <rdfs:label xml:lang="id">Keputusan Penyedia Indeks</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PeristiwaGeopolitik"/>
        <rdfs:comment xml:lang="id">Keputusan MSCI/FTSE/S&amp;P DJI (rebalancing, freeze, reklasifikasi).</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeyakinanTinggi -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KeyakinanTinggi">
        <rdfs:label xml:lang="id">Keyakinan Tinggi (Confluence)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Top pick + akumulasi bandar + fundamental kuat (konfluensi multi-pilar).</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Komoditas -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Komoditas">
        <rdfs:label xml:lang="id">Komoditas</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EntitasPasarModal"/>
        <rdfs:comment xml:lang="id">Barang komoditas global yang memengaruhi laba emiten.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomoditasAgrikultur -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomoditasAgrikultur">
        <rdfs:label xml:lang="id">Komoditas Agrikultur</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Komoditas"/>
        <rdfs:comment xml:lang="id">CPO, karet, gandum, jagung, kedelai.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomoditasEnergi -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomoditasEnergi">
        <rdfs:label xml:lang="id">Komoditas Energi</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Komoditas"/>
        <rdfs:comment xml:lang="id">Minyak (WTI, Brent), gas/LNG, batu bara.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomoditasLogam -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomoditasLogam">
        <rdfs:label xml:lang="id">Komoditas Logam Industri</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Komoditas"/>
        <rdfs:comment xml:lang="id">Nikel, timah, tembaga, bauksit, aluminium.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomponenML -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KomponenML">
        <rdfs:label xml:lang="id">Komponen ML Pendukung</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisSentimen"/>
        <lapisanPengetahuan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Komponen ML pendukung (&lt;20%)</lapisanPengetahuan>
        <rdfs:comment xml:lang="id">Modul non-simbolik (&lt;20%): scoring sentimen teks, deteksi pola chart, kalibrasi bobot backtest.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KondisiPasar -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KondisiPasar">
        <rdfs:label xml:lang="id">Kondisi Pasar (State Vector)</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <owl:disjointWith rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#RegimeAktif"/>
        <rdfs:comment xml:lang="id">Vektor keadaan pasar terkini untuk deteksi regime.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KondisiPasarAktif -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KondisiPasarAktif">
        <rdfs:label xml:lang="id">Kondisi Pasar Aktif</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdfs:comment xml:lang="id">(Inferensi) state yang dipakai penalaran.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonfirmasiPolaBearish -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonfirmasiPolaBearish">
        <rdfs:label xml:lang="id">Konfirmasi Pola Bearish</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Pola chart/candle bearish terkonfirmasi distribusi.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonfirmasiPolaBullish -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonfirmasiPolaBullish">
        <rdfs:label xml:lang="id">Konfirmasi Pola Bullish</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Pola chart/candle bullish terkonfirmasi akumulasi bandar.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonflikFundamentalVsBandar -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonflikFundamentalVsBandar">
        <rdfs:label xml:lang="id">Konflik: Fundamental vs Bandar</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
        <rdfs:comment xml:lang="id">Fundamental kuat tetapi bandar distribusi.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonflikPerang -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonflikPerang">
        <rdfs:label xml:lang="id">Konflik / Perang</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PeristiwaGeopolitik"/>
        <rdfs:comment xml:lang="id">Konflik bersenjata antarnegara.</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonfluensiRendah -->

    <owl:Class rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonfluensiRendah">
        <rdfs:label xml:lang="id">Konfluensi Rendah</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#InferensiEmiten"/>
