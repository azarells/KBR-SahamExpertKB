        <rdfs:comment xml:lang="id">[Teknikal] Poin volume: rasioVolume ∈ [1.5, +inf) → poinVolume 1</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_TEK_04b -->

