        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-ERP-01</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Valuasi Relatif Obligasi</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Valuasi Relatif Obligasi] ERP = 100/PER − yield SBN 10Y</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ERP_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_ERP_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
