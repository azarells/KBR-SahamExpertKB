<?xml version="1.0"?>
<rdf:RDF xmlns="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#"
     xml:base="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:SahamExpertKB="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#">
    <owl:Ontology rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl">
        <rdfs:label xml:lang="id">SahamExpertKB - Ontologi Pakar Saham Indonesia</rdfs:label>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2.1 (2026-11-12)</owl:versionInfo>
        <rdfs:comment xml:lang="id">Knowledge Base Sistem Pakar Prediksi Sektor Saham Unggulan &amp; Kesehatan Fundamental Emiten BEI (horizon 1-3 tahun). Integrasi analisis Fundamental, Teknikal, Bandarmology, Sentimen (aspect-based), Geopolitik-Makro multi-hop, Case-Based Reasoning historis, dan rotasi siklus sektor. Penalaran dengan SWRL (jalankan Pellet / SWRLTab-Drools). Kelompok 9: Jonnathan Azarel Gunawan (L0224005), Gloria Dana Praysilia (L0224043). Tanggal acuan data: 2026-11-12. v2: lapisan sumber data &amp; katalog indikator, deteksi regime + bobot adaptif, reaction function kebijakan, refleksivitas (priced-in), kapitulasi &amp; akumulasi bertahap, revisi laba, ERP, tata kelola/gorengan, robustness skenario, konfluensi/konflik, sizing, katalis, tesis &amp; kill switch.</rdfs:comment>
    </owl:Ontology>
    


