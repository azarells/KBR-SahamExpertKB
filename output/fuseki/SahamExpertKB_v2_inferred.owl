    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_01 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_01">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-01</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-01</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] Emiten merugi (PER ≤ 0) → skor valuasi 0</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_02 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_02">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-02</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-02</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] Rasio PER terhadap rata-rata 5 tahun (PER band)</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03a</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03a</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] Skor valuasi PER band: rasioPERvsHistoris ∈ [-inf, 0.6) → skorValuasi 3 Undervalued</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03b -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03b">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03b</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03b</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] Skor valuasi PER band: rasioPERvsHistoris ∈ [0.6, 0.85) → skorValuasi 2 Undervalued</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03c -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03c">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03c</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03c</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] Skor valuasi PER band: rasioPERvsHistoris ∈ [0.85, 1.1) → skorValuasi 1 FairValued</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03d -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_03d">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03d</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-03d</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] Skor valuasi PER band: rasioPERvsHistoris ∈ [1.1, +inf) → skorValuasi 0 Overvalued</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_04 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_04">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-04</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-04</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] EPS estimasi = harga / PER</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_05 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_VAL_05">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-05</rdfs:label>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Fundamental-Valuasi</pilarAnalisis>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-VAL-05</kodeAturan>
        <rdfs:comment xml:lang="id">[Fundamental-Valuasi] Nilai wajar = EPS × PER rata-rata 5 tahun; upside = (NW/harga - 1) × 100</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AutoRejectionAtas -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AutoRejectionAtas">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MekanismePerdagangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Auto Rejection Atas (ARA)</rdfs:label>
        <heuristikPakar xml:lang="id">ARA beruntun dengan volume tipis &amp; broker tunggal = tanda saham digoreng.</heuristikPakar>
        <rdfs:comment xml:lang="id">Batas kenaikan harga harian maksimum; order di atas batas ditolak sistem JATS.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AutoRejectionBawah -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AutoRejectionBawah">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#MekanismePerdagangan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Auto Rejection Bawah (ARB)</rdfs:label>
        <rdfs:comment xml:lang="id">Batas penurunan harga harian maksimum.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AveragingDown -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AveragingDown">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ManajemenRisiko"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Averaging Down</rdfs:label>
        <heuristikPakar xml:lang="id">Averaging down pada value trap = bencana; pastikan bukan ZonaDistress.</heuristikPakar>
        <rdfs:comment xml:lang="id">Menambah posisi saat harga turun; hanya untuk emiten fundamental kuat.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AveragingUp -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AveragingUp">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ManajemenRisiko"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Averaging Up / Pyramiding</rdfs:label>
        <rdfs:comment xml:lang="id">Menambah posisi saat tren terkonfirmasi naik.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AvgPriceBandar -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AvgPriceBandar">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Bandarmology"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonsepBandarmology"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Average Price Bandar</rdfs:label>
        <heuristikPakar xml:lang="id">Harga di bawah avg bandar = bandar &apos;nyangkut&apos;, biasanya akan dijaga/diangkat.</heuristikPakar>
        <rdfs:comment xml:lang="id">Harga rata-rata beli broker akumulator; menjadi &apos;support psikologis&apos; bandar.</rdfs:comment>
    </owl:Thing>
    


