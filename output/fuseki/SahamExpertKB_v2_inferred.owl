    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_EMT_02a -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_EMT_02a">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
