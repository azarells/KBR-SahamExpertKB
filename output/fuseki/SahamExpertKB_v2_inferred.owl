        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMoneter"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Yield US Treasury 10Y</rdfs:label>
        <rdfs:comment xml:lang="id">Risk-free global.</rdfs:comment>
        <heuristikPakar xml:lang="id">Yield UST tertinggi sejak 2002 (Okt 2026) menekan aset EM.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#DelistingPaksa -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#DelistingPaksa">
