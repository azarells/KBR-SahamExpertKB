        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Harga Minyak (Brent/WTI)</rdfs:label>
        <rdfs:comment xml:lang="id">Acuan energi global.</rdfs:comment>
        <heuristikPakar xml:lang="id">Brent &gt; US$100 → inflasi impor &amp; beban subsidi APBN.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_HargaReferensiCPO -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_HargaReferensiCPO">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorHargaKomoditas"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Harga Referensi CPO (Kemendag)</rdfs:label>
        <rdfs:comment xml:lang="id">Dasar bea keluar &amp; pungutan ekspor CPO.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_IKK -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_IKK">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorEkonomiRiil"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Indeks Keyakinan Konsumen</rdfs:label>
        <heuristikPakar xml:lang="id">IKK turun → ritel &amp; otomotif melemah.</heuristikPakar>
        <rdfs:comment xml:lang="id">Survei BI; &gt; 100 optimis.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_NeracaPerdagangan -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_NeracaPerdagangan">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorEkonomiRiil"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Neraca Perdagangan</rdfs:label>
        <rdfs:comment xml:lang="id">Ekspor - impor barang.</rdfs:comment>
        <heuristikPakar xml:lang="id">Surplus mengecil → tekanan rupiah.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_NetForeignBEI -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_NetForeignBEI">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisGeopolitikMakro"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorAliranDana"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#IndikatorMakro"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Net Foreign Buy/Sell BEI</rdfs:label>
        <rdfs:comment xml:lang="id">Aliran dana asing harian di pasar reguler.</rdfs:comment>
        <heuristikPakar xml:lang="id">Net sell berturut &gt; 10 hari di big caps = tekanan IHSG.</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_PDB -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Def_PDB">
