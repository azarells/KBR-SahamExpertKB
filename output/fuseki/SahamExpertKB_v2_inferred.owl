    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AccDistBrokerScore -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AccDistBrokerScore">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Bandarmology"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KonsepBandarmology"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Skor Akumulasi/Distribusi Broker</rdfs:label>
        <rdfs:comment xml:lang="id">Skor -100..100 dari konsentrasi net buy top-5 broker vs bottom-5 (fitur &apos;Bandar Detector&apos;).</rdfs:comment>
        <heuristikPakar xml:lang="id">≥ 20 akumulasi; ≤ -20 distribusi</heuristikPakar>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AccDistLine -->

