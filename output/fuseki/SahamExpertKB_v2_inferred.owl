        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Penyesuaian Harga BBM / Subsidi</rdfs:label>
        <rdfs:comment xml:lang="id">Brent ≥ US$100 → tekanan subsidi → probabilitas kenaikan harga BBM.</rdfs:comment>
        <antisipasiMengaktifkan rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Mv_KenaikanHargaBBM"/>
    </owl:Thing>
    


