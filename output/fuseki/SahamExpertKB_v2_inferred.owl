        <rdfs:comment xml:lang="id">PER ≤ 0 (laba bersih negatif).</rdfs:comment>
    </owl:Class>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#EmitenNonKeuangan -->

