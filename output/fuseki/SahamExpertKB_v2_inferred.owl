        <rdfs:label xml:lang="id">Akuisisi</rdfs:label>
        <rdfs:comment xml:lang="id">Pengambilalihan pengendalian perusahaan.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AltmanZScore -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AltmanZScore">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnalisisFundamental"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#ModelSkorRisiko"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Altman Z-Score</rdfs:label>
        <rdfs:comment xml:lang="id">Model prediksi kebangkrutan (Altman, 1968).</rdfs:comment>
        <ambangBatas xml:lang="id">Z &lt; 1,81 distress; 1,81-2,99 abu-abu; ≥ 2,99 aman</ambangBatas>
        <rumus xml:lang="id">Z = 1,2X1 + 1,4X2 + 3,3X3 + 0,6X4 + 1,0X5 (X1=WC/TA, X2=RE/TA, X3=EBIT/TA, X4=MVE/TL, X5=Sales/TA)</rumus>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnchoringBias -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AnchoringBias">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#BiasPerilaku"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PengetahuanDasarSaham"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Anchoring</rdfs:label>
        <rdfs:comment xml:lang="id">Terpaku pada harga beli/harga tertinggi lama.</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Antisipasi_BIHikePreemptif -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Antisipasi_BIHikePreemptif">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AntisipasiKebijakan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AntisipasiTerpicu"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#KategoriInferensi"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">BI Naikkan Suku Bunga Pre-emptif</rdfs:label>
        <rdfs:comment xml:lang="id">Rupiah ≥ 17.500 &amp; inflasi ≥ 3% → BI cenderung menaikkan bunga sebelum konsensus.</rdfs:comment>
        <antisipasiMengaktifkan rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Mv_SukuBungaBINaik"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Antisipasi_OutflowSBN -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Antisipasi_OutflowSBN">
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#AntisipasiKebijakan"/>
        <rdf:type rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#PenalaranPakar"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label xml:lang="id">Outflow Asing dari SBN</rdfs:label>
        <rdfs:comment xml:lang="id">Fed ≥ 4% &amp; spread SBN-UST ≤ 225 bps → daya tarik SBN turun.</rdfs:comment>
        <antisipasiMengaktifkan rdf:resource="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Mv_OutflowSBN"/>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Antisipasi_PenyesuaianBBM -->

