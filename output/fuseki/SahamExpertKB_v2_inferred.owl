        <rdfs:comment xml:lang="id">[Bandarmology] Poin net foreign 20 hari: netAsing20HariM ∈ [50.0, +inf) → poinAsing 2 AsingAkumulasi</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_BDR_02b -->

