        <rdfs:comment xml:lang="id">[Tata Kelola] Indikasi saham gorengan: free float &lt; 20%, volume ≥ 3×, ARA ≥ 2 kali/5 hari, top-3 broker ≥ 60%</rdfs:comment>
    </owl:Thing>
    


    <!-- http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_GOV_05 -->

    <owl:Thing rdf:about="http://kbr.kelompok9.id/ontologi/SahamExpertKB.owl#Aturan_R_GOV_05">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-GOV-05</rdfs:label>
        <kodeAturan rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R-GOV-05</kodeAturan>
        <pilarAnalisis rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Tata Kelola</pilarAnalisis>
        <rdfs:comment xml:lang="id">[Tata Kelola] Risiko pump &amp; dump: gorengan + overvalued + RSI ≥ 80</rdfs:comment>
    </owl:Thing>
    


